.判断 (消息数据 == “快捷输入”)
    文本 = “,快捷输入” + 临时输入替换 (QQ, “1@查看快捷键#2@设置快捷键#3@删除快捷键#4@查看输入替换#5@设置输入替换#6@删除输入替换#7@查看临时输入替换”)
    文本 = 文本 + #换行符 + “举例：比如一个” + 加引号 (“g→攻击”) + “的替换”
    文本 = 文本 + #换行符 + “当它属于快捷键时，只有你单独输入了” + 加引号 (“g”) + “时才会触发，输入” + 加引号 (“g史莱姆”) + “之类的都不会触发”
    文本 = 文本 + #换行符 + “而当它为输入替换时，只要你输入的内容以” + 加引号 (“g”) + “开头，无论你后续带了什么内容，它都会触发”
    文本 = 文本 + #换行符 + “比如输入” + 加引号 (“g史莱姆”) + “，它将会被替换为” + 加引号 (“攻击史莱姆”)
    文本 = 文本 + #换行符 + “临时输入替换相当于一个一次性的输入替换，在触发一次之后会被彻底清空”
    文本 = 文本 + #换行符 + “临时输入替换的判断优先级最高，其次到快捷键，输入替换最后”
    返回 (文本)
.判断 (消息数据 == “刷新数据”)
    .计次循环首 (取数组成员数 (玩家列表), b)
        .如果真 (玩家列表[b].QQ == QQ)
            玩家 = 玩家列表[b]
            删除成员 (玩家列表, b, )
            插入成员 (玩家列表, 1, 玩家)
            返回 (“已刷新。”)
        .如果真结束
        
    .计次循环尾 ()
    返回 (“[@” + QQ + “]玩家列表中没有你的数据”)
.判断 (消息数据 == “重新读取数据”)
    ' _保存玩家 (应用目录 ＋ “\” ＋ QQ ＋ “.txt”, 取玩家 (QQ))
    文本 = 到文本 (取文件时间 (取运行目录 () + “\插件数据\使魔大战\” + QQ + “.txt”))
    返回 (“[@” + QQ + “]确定要重新读取数据吗？这可能能解决指令不回复的问题” + #换行符 + “本地文件修改时间:” + 文本 + 加括号 (取运行目录 () + “\插件数据\使魔大战\” + QQ + “.txt”) + #换行符 + “最后操作时间” + 数字到时间 ((时间_取现行时间 () - 到长整数 (读配置项 (应用目录 + “\” + QQ + “.txt”, QQ, “操作时间”, ))) / #转秒) + “前” + #换行符 + “自动保存线程上次保存时间:” + 数字到时间 ((时间_取现行时间 () - 自动保存线程存活时间) / #转秒) + #换行符 + “因为数据3分钟保存一次，你最多可能会丢失3分钟的数据” + #换行符 + “” + 临时输入替换 (QQ, “a@确认重新读取数据#b@备份数据”))
.判断 (消息数据 == “确认重新读取数据”)
    玩家 = 取玩家 (QQ)
    .如果真 (增益要求 (“活跃”, 玩家.标记2, , 时间_取现行时间 (), ))
        返回 (玩家.名称 + “未满足：距离上次触发游戏回复超过5分钟”)
    .如果真结束
    .计次循环首 (取数组成员数 (玩家列表), b)
        .如果真 (玩家列表[b].QQ == QQ)
            b = -1
            删除成员 (玩家列表, b, )
            跳出循环 ()
        .如果真结束
        
    .计次循环尾 ()
    插入成员 (玩家列表, 1, _读取玩家 (取运行目录 () + “\插件数据\使魔大战\” + QQ + “.txt”, QQ))
