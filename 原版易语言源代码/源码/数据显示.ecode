.程序集 数据显示

.子程序 显示被动效果, 文本型
.参数 玩家, 玩家
.局部变量 a, 整数型
.局部变量 z, 装备
.局部变量 返回文本, 文本型
.局部变量 b, 整数型
.局部变量 c, 整数型
.局部变量 文本数组, 文本型, , "0"

.计次循环首 (取数组成员数 (玩家.装备), a)
    .判断开始 (玩家.装备[a].效果 != “”)
        文本自动添加分隔 (返回文本, 玩家.装备[a].效果, “换行”)
    .判断 (玩家.装备[a].特殊序号 == #动力套装)
        .如果真 (寻找文本 (返回文本, #动力套装效果, , 假) == -1)
            b = 玩家.套装.动力
            .如果真 (b > 5)
                b = 5
            .如果真结束
            文本自动添加分隔 (返回文本, #动力套装效果 + 到文本 (b * 10) + “%”, “换行”)
        .如果真结束
        
    .判断 (玩家.装备[a].特殊序号 == #游骑兵套装)
        .如果真 (寻找文本 (返回文本, #游骑兵套装效果, , 假) == -1)
            b = 玩家.套装.游骑兵
            .如果真 (b > 5)
                b = 5
            .如果真结束
            文本自动添加分隔 (返回文本, #游骑兵套装效果 + 到文本 (b * 10) + “%”, “换行”)
        .如果真结束
        
    .判断 (玩家.装备[a].特殊序号 == #防爆套装)
        .如果真 (寻找文本 (返回文本, #防爆套装效果, , 假) == -1)
            b = 玩家.套装.防爆
            .如果真 (b > 5)
                b = 5
            .如果真结束
            文本自动添加分隔 (返回文本, #防爆套装效果 + 到文本 (b * 10) + “%”, “换行”)
        .如果真结束
        
    .判断 (玩家.装备[a].特殊序号 == #游侠套装)
        .如果真 (寻找文本 (返回文本, #游侠套装效果, , 假) == -1)
            b = 玩家.套装.游侠
            .如果真 (b > 5)
                b = 5
            .如果真结束
            文本自动添加分隔 (返回文本, #游侠套装效果 + 到文本 (b * 10) + “%”, “换行”)
        .如果真结束
        
    .判断 (玩家.装备[a].特殊序号 == #无畏套装)
        .如果真 (寻找文本 (返回文本, #无畏套装效果, , 假) == -1)
            b = 玩家.套装.无畏
            .如果真 (b > 5)
                b = 5
            .如果真结束
            文本自动添加分隔 (返回文本, #无畏套装效果 + 到文本 (b * 10) + “%”, “换行”)
        .如果真结束
        
    .默认
        
    .判断结束
    
    .如果真 (玩家.装备[a].攻击文本.名称 != “”)  ' 装备的 攻击文本.名称 存的是召唤物。 格式： 类型；召唤文本；召唤失败文本
        文本数组 = 分割文本 (玩家.装备[a].攻击文本.名称, “；”, )
        .如果真 (取数组成员数 (文本数组) > 0)
            文本自动添加分隔 (返回文本, “攻击时召唤” + 文本数组[1], “换行”)
        .如果真结束
        
    .如果真结束
    
.计次循环尾 ()
.如果真 (玩家.套装.圣诞 >= 2)
    文本自动添加分隔 (返回文本, #圣诞套装效果, “换行”)
.如果真结束
.如果真 (玩家.套装.一拳 >= 4)
    文本自动添加分隔 (返回文本, #一拳套装效果, “换行”)
.如果真结束
.如果真 (玩家.套装.白花嫁 >= 4)
    文本自动添加分隔 (返回文本, #纯白婚纱套装效果, “换行”)
.如果真结束
.如果真 (玩家.套装.黑花嫁 >= 4)
    文本自动添加分隔 (返回文本, #黑婚纱套装效果, “换行”)
.如果真结束
.如果真 (玩家.套装.晚礼服 >= 4)
    文本自动添加分隔 (返回文本, #蝴蝶晚礼服效果, “换行”)
.如果真结束
.如果真 (玩家.套装.科学家 >= 4)
    文本自动添加分隔 (返回文本, #科学家套装效果, “换行”)
.如果真结束
.如果真 (玩家.套装.生命祝福 >= 5)
    文本自动添加分隔 (返回文本, #生命套装效果, “换行”)
.如果真结束
.如果真 (玩家.套装.皇冠 >= 3)
    文本自动添加分隔 (返回文本, #皇冠套装效果, “换行”)
.如果真结束
.如果真 (玩家.套装.逆兔女郎 >= 3)
    文本自动添加分隔 (返回文本, #逆兔女郎效果, “换行”)
.如果真结束


.如果 (玩家.特殊序号 > 0 && 玩家.当前武器 != 0)  ' 是玩家 玩家持有武器
    .如果真 (玩家.武器[玩家.当前武器].特殊序号 != 0)
        文本自动添加分隔 (返回文本, 玩家.武器[玩家.当前武器].效果, “换行”)
    .如果真结束
    
.否则
    ' 是怪物或者召唤物
    .计次循环首 (取数组成员数 (玩家.武器), a)
        .如果真 (玩家.武器[a].特殊序号 != 0)
            文本自动添加分隔 (返回文本, 玩家.武器[a].名称 + “:” + #换行符 + 玩家.武器[a].效果, “换行”)
        .如果真结束
        
    .计次循环尾 ()
.如果结束
返回文本 = 子文本替换 (返回文本, “#换行”, #换行符, , , 真)
返回文本 = 子文本替换 (返回文本, “换行”, #换行符, , , 真)
返回 (返回文本)
.子程序 取对话, 文本型, , 显示宠物或者怪物的对话  0敌对聊天 1友好聊天 2跟随 3停下 4拾取 5挤奶 6击杀 7补魔开始 8补魔结束 9强化 10被捕捉 11躺下 12起床
.参数 玩家, 玩家
.参数 对象, 玩家
.参数 类型, 短整数型
.局部变量 a, 整数型
.局部变量 w, 文本型
.局部变量 d, 整数型
.局部变量 对象类型, 文本型

对象类型 = 对象.类型
.如果真 (对象.QQ == “npc1g”)
    对象类型 = “神之工匠”
.如果真结束
对象类型 = 子文本替换 (对象类型, #小樱2, “小樱”, , , 真)
对象类型 = 子文本替换 (对象类型, “精英”, , , , 真)
对象类型 = 子文本替换 (对象类型, “神兽”, , , , 真)
对象类型 = 子文本替换 (对象类型, “深蓝”, , , , 真)
对象类型 = 子文本替换 (对象类型, “巨型宇航兔”, “宇航兔”, , , 真)
.计次循环首 (取数组成员数 (对话列表), a)
    .如果真 (对话列表[a].名称 == 对象类型)
        d = a
        跳出循环 ()
    .如果真结束
    
.计次循环尾 ()
.判断开始 (d == 0)
    d = 2  ' 对应的对话内容不存在，调用通用对话
.判断 (类型 == 4)
    .如果真 (取数组成员数 (对话列表[d].拾取) < 1)
        d = 2  ' 对应的对话存在，但是所取项目的数组为空，调用通用对话里面的项目
    .如果真结束
    
.判断 (类型 == 3)
    .如果真 (取数组成员数 (对话列表[d].停下) < 1)
        d = 2
    .如果真结束
    
.判断 (类型 == 2)
    .如果真 (取数组成员数 (对话列表[d].跟随) < 1)
        d = 2
    .如果真结束
    
.判断 (类型 == 1)
    .如果真 (取数组成员数 (对话列表[d].友好聊天) < 1)
        d = 2
    .如果真结束
    
.判断 (类型 == 0)
    .如果真 (取数组成员数 (对话列表[d].敌对聊天) < 1)
        d = 2
    .如果真结束
    
.判断 (类型 == 5)
    .如果真 (取数组成员数 (对话列表[d].挤奶) < 1)
        d = 2
    .如果真结束
    
.判断 (类型 == 6)
    .如果真 (取数组成员数 (对话列表[d].击杀) < 1)
        d = 2
    .如果真结束
    
.判断 (类型 == 7)
    .如果真 (取数组成员数 (对话列表[d].补魔开始) < 1)
        d = 2
    .如果真结束
    
.判断 (类型 == 8)
    .如果真 (取数组成员数 (对话列表[d].补魔结束) < 1)
        d = 2
    .如果真结束
    
.判断 (类型 == 9)
    .如果真 (取数组成员数 (对话列表[d].强化) < 1)
        d = 2
    .如果真结束
    
.判断 (类型 == 10)
    .如果真 (取数组成员数 (对话列表[d].被捕捉) < 1)
        d = 2
    .如果真结束
    
.判断 (类型 == 11)
    .如果真 (取数组成员数 (对话列表[d].躺下) < 1)
        d = 2
    .如果真结束
    
.判断 (类型 == 12)
    .如果真 (取数组成员数 (对话列表[d].起床) < 1)
        d = 2
    .如果真结束
    
.默认
    
.判断结束
.判断开始 (类型 == 4)
    .如果真 (取数组成员数 (对话列表[d].拾取) > 0)
        w = 对话列表[d].拾取[取随机数 (1, 取数组成员数 (对话列表[d].拾取))]
    .如果真结束
    
.判断 (类型 == 3)
    .如果真 (取数组成员数 (对话列表[d].停下) > 0)
        w = #换行符 + 对话列表[d].停下[取随机数 (1, 取数组成员数 (对话列表[d].停下))]
    .如果真结束
    
.判断 (类型 == 2)
    .如果真 (取数组成员数 (对话列表[d].跟随) > 0)
        w = #换行符 + 对话列表[d].跟随[取随机数 (1, 取数组成员数 (对话列表[d].跟随))]
    .如果真结束
    
.判断 (类型 == 1)
    .如果真 (取数组成员数 (对话列表[d].友好聊天) > 0)
        w = #换行符 + 对话列表[d].友好聊天[取随机数 (1, 取数组成员数 (对话列表[d].友好聊天))]
    .如果真结束
    
.判断 (类型 == 0)
    .如果真 (取数组成员数 (对话列表[d].敌对聊天) > 0)
        w = #换行符 + 对话列表[d].敌对聊天[取随机数 (1, 取数组成员数 (对话列表[d].敌对聊天))]
    .如果真结束
    
.判断 (类型 == 5)
    .如果真 (取数组成员数 (对话列表[d].挤奶) > 0)
        w = #换行符 + 对话列表[d].挤奶[取随机数 (1, 取数组成员数 (对话列表[d].挤奶))]
    .如果真结束
    
.判断 (类型 == 6)
    .如果真 (取数组成员数 (对话列表[d].击杀) > 0)
        w = #换行符 + 对话列表[d].击杀[取随机数 (1, 取数组成员数 (对话列表[d].击杀))]
    .如果真结束
    
.判断 (类型 == 7)
    .如果真 (取数组成员数 (对话列表[d].补魔开始) > 0)
        w = #换行符 + 对话列表[d].补魔开始[取随机数 (1, 取数组成员数 (对话列表[d].补魔开始))]
    .如果真结束
    
.判断 (类型 == 8)
    .如果真 (取数组成员数 (对话列表[d].补魔结束) > 0)
        w = #换行符 + 对话列表[d].补魔结束[取随机数 (1, 取数组成员数 (对话列表[d].补魔结束))]
    .如果真结束
    
.判断 (类型 == 9)
    .如果真 (取数组成员数 (对话列表[d].强化) > 0)
        w = #换行符 + 对话列表[d].强化[取随机数 (1, 取数组成员数 (对话列表[d].强化))]
    .如果真结束
    
.判断 (类型 == 10)
    .如果真 (取数组成员数 (对话列表[d].被捕捉) > 0)
        w = #换行符 + 对话列表[d].被捕捉[取随机数 (1, 取数组成员数 (对话列表[d].被捕捉))]
    .如果真结束
    
.判断 (类型 == 11)
    .如果真 (取数组成员数 (对话列表[d].躺下) > 0)
        w = #换行符 + 对话列表[d].躺下[取随机数 (1, 取数组成员数 (对话列表[d].躺下))]
    .如果真结束
    
.判断 (类型 == 12)
    .如果真 (取数组成员数 (对话列表[d].起床) > 0)
        w = #换行符 + 对话列表[d].起床[取随机数 (1, 取数组成员数 (对话列表[d].起床))]
    .如果真结束
    
.默认
    
.判断结束
.如果真 (w == “”)
    w = “……”
.如果真结束
w = 子文本替换 (w, “【名称】”, 玩家.名称, , , 真)
w = 子文本替换 (w, “【目标】”, 对象.名称, , , 真)
返回 (w + #换行符)
.子程序 躺下起床显示, 文本型, , 1躺下 2起床
.参数 玩家, 玩家
.参数 类型, 整数型
.局部变量 w, 文本型
.局部变量 w2, 文本型
.局部变量 a, 整数型
.局部变量 b, 整数型
.局部变量 地图, 地图

地图 = 地图列表[玩家.地图]
.如果 (类型 == 2)
    w = 玩家.名称 + 召唤物跟随显示 (玩家, 2, , 真, “和”, , w2) + “从床上爬了起来”
    a = 到整数 (随机文本 (w2))
    .如果真 (a != 0)
        w = 取图片 (地图.召唤物[a].类型) + 取对话 (玩家, 地图.召唤物[a], 12) + w
    .如果真结束
    
.否则
    w = 玩家.名称 + 召唤物跟随显示 (玩家, 2, a, 真, “和”, , w2) + “躺到了床上”
    w = w + “#换行每秒获得经验:” + 文本四舍 (玩家.等级 / 100)
    w = w + “#换行你的经验加成:” + 文本四舍 (玩家.属性.经验) + “%”
    w = w + “#换行陪睡NPC/宠物:” + 加斜杠 (a, 2) + 加括号 (“+” + 到文本 (a * 50) + “%”)
    .判断开始 (是否有特殊宠物 (#洛, 地图.召唤物, b))
        w = w + #换行符 + 地图.召唤物[b].名称 + “:+10%”
        b = 1
        玩家.套装.陪睡 = -a  ' 负数为有鹭
    .默认
        玩家.套装.陪睡 = a
        b = 0
    .判断结束
    w = w + “#换行最终每秒获得:” + 显示伤害 ((1 + a * 0.5) * 玩家.等级 * (1 + 玩家.属性.经验 / 100) / 100 * (1 + b / 10), )
    a = 到整数 (随机文本 (w2))
    .如果真 (a != 0)
        w = 取图片 (地图列表[玩家.地图].召唤物[a].类型) + 取对话 (玩家, 地图列表[玩家.地图].召唤物[a], 11) + w
    .如果真结束
    
.如果结束
返回 (w)
.子程序 召唤物跟随显示, 文本型, , 最后一个参数返回取到的数组下标 使用到整数(随机文本( )) 来使用
.参数 玩家, 玩家
.参数 数量, 短整数型, 可空, 限制显示的数量
.参数 实际数量, 整数型, 参考 可空, 返回有几个
.参数 不需要跟随, 逻辑型, 可空
.参数 前缀文本, 文本型, 可空
.参数 陪睡加成对象编号, 整数型, 参考 可空, 鹭或者洛
.参数 返回随机对象, 文本型, 参考 可空, 返回取到的数组下标 使用到整数(随机文本( )) 来使用
.局部变量 地图, 地图
.局部变量 a, 整数型
.局部变量 b, 整数型
.局部变量 w, 文本型

地图 = 地图列表[玩家.地图]
实际数量 = 0
陪睡加成对象编号 = 0
返回随机对象 = “”
.计次循环首 (取数组成员数 (地图.召唤物), a)
    .如果真 (地图.召唤物[a].活力 == #洛)
        .如果真 (地图.召唤物[a].归属 == 玩家.QQ)
            陪睡加成对象编号 = a
            跳出循环 ()
        .如果真结束
        
    .如果真结束
    
.计次循环尾 ()
.计次循环首 (取数组成员数 (地图.召唤物), a)
    .如果真 (地图.召唤物[a].归属 == 玩家.QQ)
        .如果 (不需要跟随)
            b = b + 1
            .判断开始 (b == 1)
                w = 地图.召唤物[a].名称
            .默认
                w = w + “、” + 地图.召唤物[a].名称
            .判断结束
            .如果 (返回随机对象 == “”)
                返回随机对象 = 到文本 (a)
            .否则
                返回随机对象 = 返回随机对象 + “,” + 到文本 (a)
            .如果结束
            
        .否则
            .如果真 (取成就熟练度 (地图.召唤物[a].标记, “跟随”) < 1)
                b = b + 1
                .判断开始 (b == 1)
                    w = 地图.召唤物[a].名称
                .默认
                    w = w + “、” + 地图.召唤物[a].名称
                .判断结束
                .如果 (返回随机对象 == “”)
                    返回随机对象 = 到文本 (a)
                .否则
                    返回随机对象 = 返回随机对象 + “,” + 到文本 (a)
                .如果结束
                
            .如果真结束
            
        .如果结束
        
    .如果真结束
    实际数量 = b
    .如果真 (数量 != 0)
        .如果真 (b == 数量)
            跳出循环 ()
        .如果真结束
        
    .如果真结束
    
.计次循环尾 ()
.如果真 (b != 0)
    .判断开始 (前缀文本 == “”)
        w = “带着” + w + “一起”
    .默认
        w = 前缀文本 + w + “一起”
    .判断结束
    
.如果真结束
.如果真 (玩家.载具 != “”)
    .计次循环首 (取数组成员数 (地图.载具), a)
        .如果真 (地图.载具[a].编号 == 玩家.载具)
            w = “操纵” + 地图.载具[a].名称 + w
            跳出循环 ()
        .如果真结束
        
    .计次循环尾 ()
.如果真结束
返回 (w)
.子程序 显示任务, 文本型
.参数 a, 整数型
.参数 玩家, 玩家
.局部变量 w2, 文本型
.局部变量 w3, 文本型
.局部变量 w, 文本型
.局部变量 c, 整数型
.局部变量 a3, 双精度小数型
.局部变量 d, 整数型

w2 = 玩家.任务[a].说明
.如果真 (寻找文本 (w2, “【图片”, , 假) != -1)
    w3 = 文本_取出中间文本 (w2, “【图片”, “】”)
    w3 = 取图片 (w3)
    w2 = 子文本替换 (w2, “【图片” + w3 + “】”, , , , 真)
.如果真结束
w = w3 + 玩家.名称 + #换行符 + 玩家.任务[a].名称 + #换行符 + w2
.计次循环首 (取数组成员数 (玩家.任务[a].要求), c)
    .如果 (玩家.任务[a].要求[c].数值 == 1)
        w = w + #换行符 + “◆需要” + 玩家.任务[a].要求[c].名称
    .否则
        w = w + #换行符 + “◆需要” + 玩家.任务[a].要求[c].名称 + “x” + 显示伤害 (玩家.任务[a].要求[c].数值, )
    .如果结束
    
.计次循环尾 ()
w = w + 取发布人 (玩家.任务[a].发布人)
w = w + #换行符 + “·完成可获得:”
d = 显示熟练度等级 (玩家.标记, “任务熟练度”)
a3 = 1 + 取成就熟练度 (玩家.成就, “完成任务”) / 200
.计次循环首 (取数组成员数 (玩家.任务[a].奖励1), c)
    .如果 (c == 1)
        w = w + 玩家.任务[a].奖励1[c].名称 + “x” + 到文本 (玩家.任务[a].奖励1[c].数量 * (1 + d / 100) * a3)
    .否则
        w = w + “、” + 玩家.任务[a].奖励1[c].名称 + “x” + 到文本 (玩家.任务[a].奖励1[c].数量 * (1 + d / 100) * a3)
    .如果结束
    
.计次循环尾 ()
w = w + #换行符 + “·完成任务后奖励自动发放。”
.如果真 (寻找文本 (w, “采集”, , 假) != -1)
    w = w + “#换行·击杀怪物掉落资源、从地上拾取不是玩家丢弃的资源，也属于[采集]行为”
.如果真结束
返回 (w)
