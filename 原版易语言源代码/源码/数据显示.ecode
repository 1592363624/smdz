        w = w + “#换行修改移动方式:坐地(4级,低级不会覆盖高级)”
    .默认
        w = w + “#换行修改移动方式:跃迁(3级,低级不会覆盖高级)”
    .判断结束
    
.如果真结束
.如果真 (部件.武器 > 0)
    w = w + “#换行载具武器部件可安装位置+” + 到文本 (部件.武器 - a)
.如果真结束
.如果真 (部件.防御 > 0)
    w = w + “#换行载具防御部件可安装位置+” + 到文本 (部件.防御 - b)
.如果真结束
.如果真 (部件.行走 > 0)
    w = w + “#换行载具行走机构可安装位置+” + 到文本 (部件.行走 - c)
.如果真结束
.如果真 (部件.功能 > 0)
    w = w + “#换行载具功能部件可安装位置+” + 到文本 (部件.功能 - d)
.如果真结束
.如果真 (部件.武器 < 0 || a != 0)
    w = w + “#换行占用” + 到文本 (a - 部件.武器) + “武器部件位置”
.如果真结束
.如果真 (部件.防御 < 0 || b != 0)
    w = w + “#换行占用” + 到文本 (b - 部件.防御) + “防御部件位置”
.如果真结束
.如果真 (部件.行走 < 0 || c != 0)
    w = w + “#换行占用” + 到文本 (c - 部件.行走) + “行走机构位置”
.如果真结束
.如果真 (部件.功能 < 0 || d != 0)
    w = w + “#换行占用” + 到文本 (d - 部件.功能) + “功能部件位置”
.如果真结束
.如果真 (部件.生产 != 0)
    w = w + “#换行提供每分钟” + 到文本 (部件.生产) + “的生产力”
.如果真结束
w = 子文本替换 (w, “占用-”, “占用”, , , 真)
w = w + 显示加成 (部件.加成, , )
.计次循环首 (取数组成员数 (部件.内置零件), a)
    .如果 (a == 1)
        w = w + “#换行————————#换行此部件有内置部件：” + 部件.内置零件[a].名称 + “x” + 到文本 (部件.内置零件[a].数量)
    .否则
        w = w + “、” + 部件.内置零件[a].名称 + “x” + 到文本 (部件.内置零件[a].数量)
    .如果结束
    
.计次循环尾 ()
.如果真 (取数组成员数 (部件.内置零件) > 0)
    w = w + “#换行(内置部件不占用/不增加安装位置)”
    .计次循环首 (取数组成员数 (部件.内置零件), a)
        .计次循环首 (取数组成员数 (部件列表), b)
            .如果真 (部件列表[b].名称 == 部件.内置零件[a].名称)
                w = w + “#换行◆” + 部件列表[b].名称 + “:” + 部件列表[b].说明 + 显示加成 (部件列表[b].加成, , )
                跳出循环 ()
            .如果真结束
            
        .计次循环尾 ()
        .计次循环首 (取数组成员数 (建筑列表), b)
            .如果真 (建筑列表[b].名称 == 部件.内置零件[a].名称)
                w = w + “#换行◆” + 建筑列表[b].名称 + “:” + 建筑列表[b].说明文本
                跳出循环 ()
            .如果真结束
            
        .计次循环尾 ()
    .计次循环尾 ()
.如果真结束
返回 (w)
