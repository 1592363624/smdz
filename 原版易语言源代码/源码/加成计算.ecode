    a2 = a2 - 1000
    .判断开始 (数值 < 2000)
        a1 = a1 + a2 * 0.9
    .默认
        a1 = a1 + 900
        a2 = a2 - 1000
        .判断开始 (数值 < 3500)
            a1 = a1 + a2 * 0.8
        .默认
            a1 = a1 + 1200
