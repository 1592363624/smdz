            .判断开始 (数值 < 5500)
                a1 = a1 + a2 * 0.7
            .默认
                a1 = a1 + 1400
                a2 = a2 - 2000
                .判断开始 (数值 < 8500)
                    a1 = a1 + a2 * 0.55
                .默认
                    a1 = a1 + 1650
                    a2 = a2 - 3000
                    .判断开始 (数值 < 12000)
