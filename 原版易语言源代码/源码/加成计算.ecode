        玩家.属性.物伤 = 1
        玩家.属性.电伤 = 1
        玩家.属性.火伤 = 1
        玩家.属性.冰伤 = 1
    .如果真结束
    
.默认
    
.判断结束
.判断开始 (玩家.套装.植入体 == 1)
    玩家.属性.物伤 = 玩家.属性.物伤 * 1.25
.判断 (玩家.套装.植入体 == 2)
    玩家.属性.火伤 = 玩家.属性.火伤 * 1.25
.判断 (玩家.套装.植入体 == 3)
    玩家.属性.冰伤 = 玩家.属性.冰伤 * 1.25
.判断 (玩家.套装.植入体 == 4)
    玩家.属性.电伤 = 玩家.属性.电伤 * 1.25
.默认
    
.判断结束
.如果真 (玩家.套装.攻击模式 == 1)
