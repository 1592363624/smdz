                .如果真 (a != -1)
                    玩家.编号 = 取数组成员数 (玩家列表) + 1
                    玩家.QQ = QQ
                    加入成员 (玩家列表, 玩家)
                .如果真结束
                w = “选择为” + 玩家.类型 + “开始游戏#换行” + 临时输入替换 (QQ, “1@查看任务”)
            .判断 (取成就熟练度 (玩家.标记, 使魔列表[b].名称 + “好感”, , ) <= 0)
                w = 玩家.名称 + “你尚未获得该使魔”
            .判断 (玩家.套装.攻击模式 == 1)
                w = 玩家.名称 + “炮击模式下不可以更换使魔”
