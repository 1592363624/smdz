                加入成员 (装备预设.装备, 物品)
                删除成员 (玩家.装备, d, )
            .判断结束
            
        .计次循环尾 ()
        .计次循环首 (取数组成员数 (玩家.装备预设[b].装备), c)
            z1 = 解析装备 (玩家.装备预设[b].装备[c])
            加入成员 (玩家.装备, z1)
        .计次循环尾 ()
        w3 = 显示物品 (玩家.装备预设[b].装备)
        装备预设.名称 = 玩家.装备预设[b].名称
        玩家.装备预设[b] = 装备预设
        置成就熟练度 (“铠甲”, 玩家.标记, 0)
        w = 玩家.名称 + “的装备切换成了” + w4 + “#换行————————#换行” + 显示物品 (玩家.装备预设[b].装备, , , , , , , ) + “#换行↓↓↓↓↓#换行” + w3
    .判断结束
    
.判断 (两字命令 == “装备”)  ' #装备
    .判断开始 (四字命令 == “装备预设”)  ' #装备预设
        w2 = 取关键词 (消息数据, 四字命令)
        a = 到整数 (取数字 (w2))
        .判断开始 (取文本左边 (w2, 4) == “删除”)
            a = 到整数 (取关键词 (消息数据, 六个字命令))
            .判断开始 (a < 1 || a > 取数组成员数 (玩家.装备预设))
                w = 玩家.名称 + 加引号 (“装备预设删除1”) + “来删除第1个装备预设,里面的装备会回到背包”
            .默认
                w = 玩家.名称 + “删除了装备预设” + 玩家.装备预设[a].名称 + “,装备回到了背包：” + 显示物品 (玩家.装备预设[a].装备)
                加入成员 (玩家.背包, 玩家.装备预设[a].装备)
                删除成员 (玩家.装备预设, a, )
            .判断结束
            
        .判断 (取文本左边 (w2, 4) == “新建”)
            w2 = 取关键词 (消息数据, 六个字命令)
            .判断开始 (w2 == “”)
                w = 玩家.名称 + 加引号 (“装备预设新建生命套”) + “来新建一个名为生命套的装备预设”
            .判断 (名称符合规范 (w2, w))
                
