    .计次循环尾 ()
    .如果真 (取数组成员数 (地图列表[a].召唤物) > 0)
        g2 = 0
        .计次循环首 (取数组成员数 (地图列表[a].召唤物), b)
            .判断开始 (取成就熟练度 (地图列表[a].召唤物[b].标记, “主动”, , ) == 1)  ' 1为被动
                
            .默认
                .如果真 (取文本右边 (地图列表[a].召唤物[b].QQ, 1) == “g”)
                    _初始化怪物 (地图列表[a].召唤物[b], 真, , )  ' 计算复活
                .如果真结束
                .判断开始 (地图列表[a].召唤物[b].当前生命 <= 0)
                    
                .默认
                    .计次循环首 (取数组成员数 (地图列表[a].玩家), c)  ' #扶玩家
                        玩家2 = 取玩家 (地图列表[a].玩家[c])
                        .如果真 (玩家2.编号 == 0)
                            到循环尾 ()
                        .如果真结束
                        .如果真 (取成就熟练度 (玩家2.标记, “不扶”, , ) == 0)
                            .如果真 (增益要求 (“卷土重来”, 玩家2.增益, , s, ))
                                .计次循环首 (取数组成员数 (地图列表[a].召唤物[b].武器), d)
                                    获得增益 (地图列表[a].召唤物[b].标记2, 地图列表[a].召唤物[b].武器[d].名称 + “冷却”, 5, , 原始时间戳, , )
                                .计次循环尾 ()
                                w = w + #换行符 + 地图列表[a].召唤物[b].名称 + “扶起了” + 玩家2.名称
                                获得增益 (玩家2.增益, “卷土重来”, -30, 真, 原始时间戳, , )
                                玩家2.当前生命 = 玩家2.属性.生命 / 2
                                玩家列表[玩家2.编号] = 玩家2
                            .如果真结束
                            
                        .如果真结束
                        
                    .计次循环尾 ()
                    .如果真 (地图列表[a].召唤物[b].闪避冷却 > 0)  ' 释放闪避
                        .如果真 (几率判断 (50))
                            a1 = 地图列表[a].召唤物[b].闪避冷却
                            w2 = “”
                            .如果真 (增益要求 (“飞羽”, 地图列表[a].召唤物[b].增益, a2, s, ))
                                .如果真 (a2 > 10)
                                    a2 = 10
                                .如果真结束
                                a1 = a1 * (1 + a2 * 0.05)
                                w2 = 加括号 (“冷却+” + 到文本 (地图列表[a].召唤物[b].闪避冷却 * a2 * 0.05) + “秒”)
                            .如果真结束
                            .如果真 (标记要求 (“空间震”, 地图列表[a].召唤物[b].标记2, , s))
                                a1 = a1 * 2
                                w2 = w2 + 加括号 (“双倍冷却”)
                            .如果真结束
                            .如果真 (时间间隔要求 (“闪避冷却”, a1, 地图列表[a].召唤物[b].标记2, s, , 原始时间戳) == 假)
                                .如果真 (删除空行 (子文本替换 (w3, “【分段】”, , , , 真)) == “”)
                                    w3 = “#换行————————”
                                    w = w + w3
                                .如果真结束
                                w = w + #换行符 + 地图列表[a].召唤物[b].名称 + “尝试闪避攻击。” + w2
