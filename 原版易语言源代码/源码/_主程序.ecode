                    到循环尾 ()
                .如果真结束
                .如果真 (增益要求 (“启示录”, 地图列表[a].标记2, , s, 玩家2.经验))
                    获得增益 (地图列表[a].怪物2[b].标记2, “启示录”, 玩家2.经验, , 原始时间戳, , )
                .如果真结束
                w = w + #换行符 + 战斗 (地图列表[a].怪物2[b], a, 群号, , s, 原始时间戳)
                .如果真 (寻找文本 (w, “#幻时”, , 假) != -1)
                    w = 子文本替换 (w, “#幻时”, , , , 真)
                    .如果 (时间间隔要求 (“幻时冷却”, 120, 地图列表[a].标记3, s, w2, 原始时间戳) == 假)
                        获得增益 (地图列表[a].标记3, “幻时”, 30, 假, 原始时间戳, , )
                    .否则
                        w = w + “#换行幻时冷却中,” + w2
                    .如果结束
                    
                .如果真结束
                .如果真 (w != “”)  ' 有怪物攻击过了
                    w3 = “”
                    跳出循环 ()
                .如果真结束
                
            .如果真结束
            
