                .判断开始 (取成就熟练度 (玩家.称号, “多面手IV”) == 1)
                    a = 300
                .判断 (取成就熟练度 (玩家.称号, “多面手III”) == 1)
                    a = 450
                .判断 (取成就熟练度 (玩家.称号, “多面手II”) == 1)
                    a = 600
                .判断 (取成就熟练度 (玩家.称号, “多面手I”) == 1)
                    a = 750
                .默认
                    a = 900
                .判断结束
                .判断开始 (玩家.类型 == 使魔列表[b].名称)
                    w = 玩家.名称 + “#换行你上次换成” + 玩家.类型 + “还是上次”
                .判断 (时间间隔要求 (“更换使魔”, a, 玩家.标记2, s, w, 原始时间戳))
                    
