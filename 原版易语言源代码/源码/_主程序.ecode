                            .如果真结束
                            
                        .如果真结束
                        
                    .如果真结束
                    
                .如果真结束
                
            .如果真结束
            .判断开始 (a == 1 || 标记要求 (“隐匿模式”, 玩家.增益, , s))
                w = w + 加括号 (“隐匿攻击”)
            .判断 (装备要求 (玩家, #提卡, , 真))
                w = w + 加括号 (“隐匿攻击”)
            .默认
                新建延时 (“覅攻击pd” + 到文本 (玩家.地图), “0”, 群号, 3, 原始时间戳)
            .判断结束
            .如果真 (取数组成员数 (地图列表[玩家.地图].怪物2) > 0)
                .如果真 (玩家.当前武器 != 0)
                    z1 = 玩家.武器[玩家.当前武器]
                    .如果真 (z1.冷却 < 5.01)
                        z1.冷却 = 5.01
                    .如果真结束
                    .判断开始 (z1.特效 == 11)  ' 三千世界
                        .如果真 (时间间隔要求 (“火连”, z1.冷却, 玩家.标记2, 原始时间戳, , ) == 假)
                            新建延时 (“攻击”, 玩家.QQ, 群号, z1.冷却, 原始时间戳)
                        .如果真结束
                        
                    .默认
                        .如果真 (z1.名称 == “火神机枪”)
                            .如果真 (时间间隔要求 (“火连”, z1.冷却, 玩家.标记2, 原始时间戳, , ) == 假)
                                新建延时 (“攻击”, 玩家.QQ, 群号, z1.冷却, 原始时间戳)
                            .如果真结束
                            
                        .如果真结束
                        
                    .判断结束
                    
                .如果真结束
                
                
            .如果真结束
            
        .默认
            w = “1”
        .判断结束
        
    .判断结束
    
.判断 (四字命令 == “覅攻击pd”)  ' #覅攻击pd#gw
    a = 到整数 (取关键词 (消息数据, 四字命令))
    .如果真 (a < 1 || a > 取数组成员数 (地图列表))
        返回 (“”)
    .如果真结束
    .如果真 (时间间隔要求 (“gw” + 到文本 (a), 2, 玩家.标记2, 原始时间戳, ))
        返回 (“”)
    .如果真结束
    移动临时怪物 (地图列表[a])
    .如果真 (取数组成员数 (地图列表[a].怪物2) < 1)
        返回 (“”)
    .如果真结束
    .如果真 (标记要求 (“活动”, 地图列表[a].标记2, , 原始时间戳) == 假)  ' 超出活动时间，停止战斗
        .计次循环首 (取数组成员数 (地图列表[a].怪物2), b)
            .如果真 (地图列表[a].怪物2[b].载具 != “”)
                zj = 取载具 (地图列表[a].怪物2[b].载具, 地图列表[a], )
                .如果真 (zj.当前生命 != zj.加成.生命 && zj.列表编号 != 0 && zj.上限 < 2)
                    w = w + #换行符 + 地图列表[a].怪物2[b].名称 + “修好了” + zj.名称
                    地图列表[a].载具[zj.列表编号].当前生命 = zj.加成.生命
                .如果真结束
                
            .如果真结束
            
        .计次循环尾 ()
        .计次循环首 (取数组成员数 (地图列表[a].召唤物), b)
            .如果真 (地图列表[a].召唤物[b].载具 != “”)
                zj = 取载具 (地图列表[a].召唤物[b].载具, 地图列表[a], )
                .如果真 (zj.当前生命 != zj.加成.生命 && zj.列表编号 != 0 && zj.上限 < 2)
                    w = w + #换行符 + 地图列表[a].召唤物[b].名称 + “修好了” + zj.名称
                    地图列表[a].载具[zj.列表编号].当前生命 = zj.加成.生命
                .如果真结束
                
