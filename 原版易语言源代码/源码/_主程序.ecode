                重定义数组 (玩家.标记, 假, 0)
                重定义数组 (玩家.标记2, 假, 0)
                重定义数组 (玩家.装备预设, 假, 0)
                重定义数组 (玩家.背包, 假, 0)
                重定义数组 (玩家.任务, 假, 0)
                重定义数组 (玩家.装备, 假, 0)
                重定义数组 (玩家.武器, 假, 0)
                重定义数组 (玩家.增益, 假, 0)
                玩家.读取时间 = s
                玩家.地图 = 1
                玩家.老玩家 = 真
                玩家.类型 = 使魔列表[b].名称
                玩家.特殊序号 = 使魔列表[b].特殊序号
                玩家.图片 = 玩家.类型
                玩家.特有技能 = 使魔列表[b].特有技能
                玩家.当前生命 = 100
                .如果 (使魔列表[b].特殊序号 == #兰音)
                    添加成就 (玩家.类型 + “好感”, 20, 玩家.标记, )
                .否则
                    添加成就 (玩家.类型 + “好感”, 1, 玩家.标记, )
                .如果结束
