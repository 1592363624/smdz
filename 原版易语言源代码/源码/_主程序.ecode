                w3 = w3 + “#” + 到文本 (a) + “@装备预设” + 到文本 (a)
            .计次循环尾 ()
            w = w + #换行符 + 加引号 (“切换预设生命套”) + “来切换”
            w = w + “#换行a、新建#z9#z9b、删除”
            w3 = w3 + “#a@装备预设新建#b@装备预设删除”
            临时输入替换 (玩家.QQ, w3)
        .默认
            w = 玩家.名称 + “,” + 玩家.装备预设[a].名称
            重定义数组 (玩家2.装备, 假, 0)
            重定义数组 (玩家2.武器, 假, 0)
