.子程序 读配置项3, 文本型, , 用 解析配置项( ) 提前解析快加读取和写入速度。如果有写入，在最后需要“保存配置项( )”才生效
.参数 p, 配置项1, 数组
.参数 节名, 文本型
.参数 配置项名, 文本型
.参数 默认文本, 文本型, 可空
.局部变量 a, 整数型
.局部变量 p2, 配置项1, , , 节
.局部变量 b, 整数型
.局部变量 p3, 配置项2, , , 内容
.局部变量 w1, 文本型, , "0"

.计次循环首 (取数组成员数 (p), a)
    .如果真 (节名 == p[a].节名)
        .计次循环首 (取数组成员数 (p[a].配置项), b)
            .如果真 (配置项名 == p[a].配置项[b].项)
                .如果 (p[a].配置项[b].内容 == “”)
                    返回 (默认文本)
                .否则
                    返回 (p[a].配置项[b].内容)
                .如果结束
                
            .如果真结束
            
        .计次循环尾 ()
    .如果真结束
    
.计次循环尾 ()
返回 (默认文本)
.子程序 写配置项3, 逻辑型, , 最后记得 保存配置项（）
.参数 p, 配置项1, 参考 数组
.参数 节名, 文本型
.参数 配置项名, 文本型, 可空, 为空则删除节
.参数 文本, 文本型, 可空, 为空则删除配置项
.局部变量 a, 整数型
.局部变量 b, 整数型
.局部变量 p2, 配置项1
.局部变量 p3, 配置项2

.计次循环首 (取数组成员数 (p), a)
    .如果真 (p[a].节名 == 节名)
        .判断开始 (配置项名 == “”)
            删除成员 (p, a, )
            返回 (真)
        .默认
            .计次循环首 (取数组成员数 (p[a].配置项), b)
                .如果真 (p[a].配置项[b].项 == 配置项名)
                    .判断开始 (文本 == “”)
                        删除成员 (p[a].配置项, b, )
                        返回 (真)
                    .默认
                        p[a].配置项[b].内容 = 文本
                        返回 (真)
                    .判断结束
                    
                .如果真结束
                
            .计次循环尾 ()
            ' 节存在，配置项不存在，加入
            p3.项 = 配置项名
            p3.内容 = 文本
            加入成员 (p[a].配置项, p3)
            返回 (真)
        .判断结束
        
    .如果真结束
    
.计次循环尾 ()
.如果真 (文本 != “” && 配置项名 != “”)  ' 节不存在，加入
    p2.节名 = 节名
    重定义数组 (p2.配置项, 假, 1)
    p2.配置项[1].项 = 配置项名
    p2.配置项[1].内容 = 文本
    加入成员 (p, p2)
.如果真结束
返回 (真)
.子程序 保存配置项, 逻辑型
.参数 路径, 文本型
.参数 p, 配置项1, 数组
.局部变量 w, 文本型
.局部变量 a, 整数型
.局部变量 b, 整数型

.计次循环首 (取数组成员数 (p), a)
    w = w + #换行符 + 加中括号 (p[a].节名)
    .计次循环首 (取数组成员数 (p[a].配置项), b)
        .如果真 (p[a].配置项[b].内容 != “”)
            w = w + #换行符 + 删首尾空 (p[a].配置项[b].项) + “=” + 子文本替换 (p[a].配置项[b].内容, #换行符 + “#换行”, , , , 真)
        .如果真结束
        
    .计次循环尾 ()
.计次循环尾 ()
w = 删除空行 (w)
返回 (写到文件 (路径, 到字节集 (w)))
.子程序 解析配置项
.参数 目录, 文本型
.参数 返回, 配置项1, 参考 数组, 返回的配置项
.局部变量 p, 配置项1, , "0", 主配置项
.局部变量 p2, 配置项1, , , 节
.局部变量 a, 整数型
.局部变量 p3, 配置项2, , , 项
.局部变量 w1, 文本型, , "0"
.局部变量 文本, 文本型, , "0"
.局部变量 文件, 文本型
.局部变量 b, 整数型

文件 = 到文本 (读入文件 (目录))
文本 = 分割文本 (文件, #换行符, )
.计次循环首 (取数组成员数 (文本), a)
    .如果 (取文本左边 (文本[a], 1) == “[”)  ' 新的一节
        .如果真 (p2.节名 != “”)
            加入成员 (p, p2)  ' 把上一节加进主配置项
        .如果真结束
        重定义数组 (p2.配置项, 假, 0)
        p2.节名 = 文本_取出中间文本 (文本[a], “[”, “]”)
    .否则
        w1 = 分割文本 (文本[a], “=”, )
        .如果真 (取数组成员数 (w1) >= 2)
            .如果真 (w1[2] != “0”)
                p3.项 = w1[1]
                .判断开始 (取数组成员数 (w1) == 2)
                    p3.内容 = w1[2]
                .默认
                    .计次循环首 (取数组成员数 (w1), b)
                        .如果 (b == 2)
                            p3.内容 = w1[2]
                        .否则
                            p3.内容 = p3.内容 + “=” + w1[b]
                        .如果结束
                        
                    .计次循环尾 ()
                .判断结束
                加入成员 (p2.配置项, p3)
            .如果真结束
            
        .如果真结束
        
    .如果结束
    
.计次循环尾 ()
加入成员 (p, p2)  ' 保存最后一个配置项
返回 = p
