// ============================================================
// 使魔大战3 网页版 - 数据库模型定义 (Prisma Schema) - MySQL 8.0
// ============================================================
// 说明：
// - 本数据库使用 MySQL 8.0（provider = "mysql"），连接串见 server/.env 的 DATABASE_URL。
// - 复杂结构(背包/装备/标记/地图动态字段等)使用原生 JSON 列（Prisma Json 类型）：
//   读取直接返回对象/数组，写入直接传对象，数据库层校验 JSON 合法性。
// - 存长文本(描述/内容/结果)的字段标注 @db.Text，避免数据被截断。

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ========== 用户与认证 ==========

/// 用户表：网页注册/登录账号，可绑定 QQ 号
model User {
  id               Int       @id @default(autoincrement())
  username         String    @unique
  password         String
  nickname         String    @default("")
  qqNumber         String?   @unique
  /// QQ 互联 OAuth2 openid（32位十六进制），用于识别 QQ 互联登录身份；
  /// 与 qqNumber（玩家真实QQ号，供群机器人识别）分离。
  externalId       String?   @unique
  role             String    @default("USER")
  status           String    @default("ACTIVE")
  avatar           String    @default("")
  /// 用户自定义的常用指令列表（JSON 数组，如 ["攻击","背包"]），前端指令面板置顶展示
  favoriteCommands Json?
  /// 最后登录时间（QQ 登录成功时更新）
  lastLoginAt      DateTime?
  /// 累计登录次数
  loginCount       Int       @default(0)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  player           Player?
  messages         ChatMessage[]
  bindings         UserBinding[]
  redPackets       RedPacket[]        @relation("RedPacketSent")
  redPacketTargets RedPacket[]        @relation("RedPacketTarget")
  redPacketClaims  RedPacketClaim[]   @relation("RedPacketClaimed")
  feedbacks        Feedback[]
  feedbackMessages FeedbackMessage[]

  @@index([qqNumber])
}

/// 绑定关系表：一个账号可绑定多个机器人身份
model UserBinding {
  id        Int      @id @default(autoincrement())
  userId    Int
  botKey    String
  botType   String   @default("qq")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, botKey])
}

// ========== 游戏核心 - 玩家相关 ==========

/// 玩家档案：核心游戏数据用 JSON 字符串存储
/// 货币审计日志（P4）：每次钻石/召唤券/数据核心变动记录一条，
/// 用于回答「玩家货币什么时候少了多少」——不再靠玩家截图破案。
model CurrencyLog {
  id           Int      @id @default(autoincrement())
  userId       Int
  currency     String // diamonds | tickets | dataCores
  delta        Float // 本次变动量（正增负减）
  balanceAfter Float // 变动后余额
  createdAt    DateTime @default(now())

  @@index([userId, createdAt])
}

model Player {
  id     Int  @id @default(autoincrement())
  userId Int  @unique
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)

  // 乐观锁版本号：savePlayer 以读快照时的 version 做条件更新（CAS），
  // 防止并发路径用旧快照整包覆盖他人写入（兑换/召唤/后台结算竞态）。
  // 复合唯一键 (id, version) 让 Prisma update 支持「按版本条件写」，
  // 冲突时抛 P2025，由 savePlayer 转换为显式的并发冲突错误。
  version Int @default(0)

  // 货币列化（P1）：硬通货脱离背包 JSON blob，成为独立标量列——单一真相源、
  // 可审计。存取经 PlayerService 透明转换（savePlayer 提取、getPlayerData 物化），
  // 业务代码仍按背包物品读写，零改动。
  diamonds  Float @default(0) // 钻石
  tickets   Float @default(0) // 召唤券
  dataCores Float @default(0) // 数据核心

  // 基础属性
  level      Int    @default(1)
  exp        Float  @default(0)
  upgradeExp Float  @default(100) // 升级所需经验
  name       String @default("") // 派生显示名（原版 玩家.名称）：baseName+[佩戴称号]，全空回退type
  baseName   String @default("") // 改名基础名（原版 玩家.图片）：选择使魔赋初值，命名使魔可改
  type       String @default("") // 使魔类型
  specialSeq Int    @default(0) // 特殊序号（对应常量表）

  // 战斗属性
  hp          Float @default(100)
  maxHp       Float @default(100)
  shield      Float @default(0) // 当前护盾
  maxShield   Float @default(0)
  armor       Float @default(0) // 当前装甲
  maxArmor    Float @default(0)
  attack      Float @default(10)
  defense     Float @default(0)
  speed       Float @default(100)
  dodge       Float @default(0)
  hit         Float @default(100)
  crit        Float @default(5)
  critDmg     Float @default(150)
  regenHp     Float @default(0) // 生命回复
  regenShield Float @default(0) // 护盾回复
  regenArmor  Float @default(0) // 装甲回复

  // 位置信息
  mapId     Int    @default(1) // 当前地图ID
  location  String @default("") // 当前地点
  houseName String @default("") // 家园名称

  // 复杂数据结构（原生 JSON 列：读取直接返回对象/数组，写入直接传对象，无字符串编解码）
  backpack         Json? // 背包物品 [物品3]
  equipment        Json? // 装备 [装备]
  weapons          Json? // 武器 [装备]
  currentWeapon    Int    @default(0) // 当前武器索引
  markers          Json? // 标记/成就 [技能]
  markers2         Json? // 有时限标记 [增益]
  buffs            Json? // 增益状态 [增益]
  tasks            Json? // 任务 [任务]
  titles           Json? // 称号 [技能]
  skills           Json? // 技能熟练度
  sets             Json? // 套装信息 [套装]
  bonus            Json? // 加成属性 [加成]
  baseBonus        Json? // 基础加成
  vehicle          String @default("") // 驾驶的载具ID
  safeBox          Json? // 保险柜 [物品3]
  equipmentPresets Json? // 装备预设
  reverse          Json? // 逆向标记
  recipes          Json? // 已解锁配方
  stats            Json? // 额外统计

  // 好感度/宠物相关
  affinity Float  @default(0) // 好感度
  masterQQ String @default("") // 主人QQ
  vitality Float  @default(0) // 活力/特殊序号

  // 时间相关
  lastOpTime BigInt @default(0) // 最后操作时间戳
  readTime   BigInt @default(0) // 读取时间戳
  /// 累计在线时长（秒），由后台任务按活跃玩家每分钟累加
  playTime   BigInt @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([id, version])
}

// ========== 游戏地图 ==========

/// 地图/区域表
model GameMap {
  id             Int     @id @default(autoincrement())
  name           String  @unique
  description    String  @default(dbgenerated("('')")) @db.Text
  mapIndex       Int     @default(0) // 地图列表编号
  level          Int     @default(1) // 额外升级等级
  isFrontier     Boolean @default(false) // 是否开拓地
  noTeleport     Boolean @default(false) // 不能传送
  noMove         Boolean @default(false) // 不能搬迁
  isInstance     Boolean @default(false) // 是否关卡地图
  requiredTravel Int     @default(0) // 前往需求：0无 1飞行 2传送 3跃迁

  // 复杂数据结构（原生 JSON 列：读取直接返回对象/数组，写入直接传对象）
  monsters       Json? // 固定怪物列表
  spawnMonsters  Json? // 刷出来的怪物
  tempMonsters   Json? // 临时怪物
  summons        Json? // 召唤物
  resources      Json? // 资源
  resources2     Json? // 可采集资源
  connections    Json? // 可前往地图 [可前往]
  npcs           Json? // NPC列表
  items          Json? // 可拾取物品
  buildings      Json? // 建筑
  vehicles       Json? // 载具
  markers        Json? // 永久标记
  markers2       Json? // 有时间限制标记
  mapBuffs       Json? // 地图增益
  requireMarkers Json? // 进入要求标记
  failHint       String  @default(dbgenerated("('')")) @db.Text // 未满足要求的提示
  clearMarkers   String  @default(dbgenerated("('')")) @db.Text // 进入时清除的标记
  music          String  @default("") // 背景音乐
  monsterCount   Int     @default(3) // 刷怪数量
  noSpecial      Boolean @default(false) // 不刷特殊事件

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ========== 怪物运行时实例 ==========
// 对应原版易语言「玩家」结构体（@Struct.ecode L287-341）中怪物/宠物部分的运行时实例。
// 设计原则（经架构评审）：
//  - 固定定义（怪物种类模板：基础属性/武器列表/装备列表/套装/初始标记）存于静态
//    JSON（monsters.json），由 StaticDataService 读取，不建表、改数值即热重载。
//  - 本表只存「运行时动态状态」：当前三层池血量、增益(markers2)、好感、活力、
//    成就（击杀数）、套装对象、运算后的属性(bonus)/基础(baseBonus)。
//  - 字段尽量 1:1 对齐原版「玩家」结构体，便于 _初始化怪物（加成计算 L2644）
//    与 攻击目标（战斗相关 L4021）逐行复刻时直接读写，预留后续扩展。
//  - 特殊序号：<1 区分怪物/宠物（0未初始化，-1敌对怪物，-2宠物）；宠物真实
//    特殊序号存于 vitality 字段（原版 L288 注释）。

model GameMonster {
  id         Int    @id @default(autoincrement())
  /// 所属地图（对应原版 地图.编号；本表每条记录是一个地图上的怪物实例）
  mapId      Int    @default(1)
  /// 怪物类型名（对应原版 玩家.类型，查 monsters.json 模板的 key）
  type       String @default("")
  /// 显示名称（对应原版 玩家.名称）
  name       String @default("")
  /// 唯一标识（对应原版 玩家.QQ，原版为"怪物"+生成编号()）
  qq         String @default("")
  /// 特殊序号（对应原版 玩家.特殊序号：-1敌对怪物 -2宠物 0未初始化；宠物真序号在 vitality）
  specialSeq Int    @default(-1)
  /// 归属（对应原版 玩家.归属，宠物主人 QQ）
  ownerQQ    String @default("")
  /// 等级（对应原版 玩家.等级；运行时可能由 强制等级/世界等级 覆盖）
  level      Int    @default(1)
  /// 图片（对应原版 玩家.图片，觉醒/图片名作为显示名前缀）
  image      String @default("")

  // ===== 基础战斗属性（对应 monsters.json 顶层的 攻击/防御/速度，原版 _初始化怪物 写入 g.属性）=====
  /// 攻击力（怪物定义 attack，原版 玩家.攻击）
  attack  Float   @default(0)
  /// 防御力（怪物定义 defense，原版 玩家.防御）
  defense Float   @default(0)
  /// 速度（怪物定义 speed，原版 玩家.速度）
  speed   Float   @default(0)
  /// 闪避率（怪物定义 dodge，原版 玩家.闪避，百分比）
  dodge   Float   @default(0)
  /// 命中率（怪物定义 hit，原版 玩家.命中，百分比）
  hit     Float   @default(0)
  /// 是否精英（怪物定义 type=精英，原版标记）
  isElite Boolean @default(false)

  // ===== 三层池：当前值（战斗中实时变化）=====
  hp        Float @default(0) // 当前生命（玩家.当前生命）
  maxHp     Float @default(0) // 生命上限（=属性.生命，用于回血封顶）
  shield    Float @default(0) // 当前护盾（玩家.当前护盾）
  maxShield Float @default(0) // 护盾上限（=属性.护盾）
  armor     Float @default(0) // 当前装甲（玩家.当前装甲）
  maxArmor  Float @default(0) // 装甲上限（=属性.装甲）

  // ===== 运算后属性（对应原版 玩家.属性 / 玩家.加成 / 玩家.基础，原生 JSON 列）=====
  /// 受加成后的最终属性（BonusData）
  bonus      Json?
  /// 基础加成（怪物基础属性，等级成长前的）
  baseBonus  Json?
  /// 额外加成（对应原版 玩家.加成）
  extraBonus Json?

  // ===== 装备/武器（对应原版 玩家.装备 / 玩家.武器，含词条；原生 JSON 列）=====
  equipments       Json? // 装备数组 [装备]
  weapons          Json? // 武器数组 [装备]
  currentWeapon    Int   @default(0) // 当前武器索引（玩家.当前武器）
  equipmentPresets Json? // 装备预设 [装备预设]

  // ===== 状态机（对应原版 玩家.标记 / 标记2 / 增益 / 成就）=====
  /// 永久标记/熟练度（玩家.标记：觉醒/强制等级/好感/宝宝/击杀 等）
  markers      Json?
  /// 限时标记/增益数组（玩家.标记2：激变星/强袭冷却/玄武光环 等）
  markers2     Json?
  /// 增益（玩家.增益）
  buffs        Json?
  /// 成就熟练度（玩家.成就：击杀数/猩红 等）
  achievements Json?
  /// 套装对象（玩家.套装：陪睡/接管载具/攻击模式/六道轮回/线圈/强袭/小樱命中次数/一拳/当前麻醉 等）
  set          Json?

  // ===== 关系/宠物相关 =====
  /// 好感（玩家.好感；宠物为奶量；影响伤害系数）
  affinity Float @default(0)
  /// 活力（玩家.活力；宠物存特殊序号；决定免死逻辑如 #吸血姬）
  vitality Int   @default(0)
  /// 经验（玩家.经验，击杀奖励；怪物被击杀时给攻击者）
  exp      Float @default(0)
  /// 背包（玩家.背包，掉落物）
  backpack Json?

  // ===== 时间/标识 =====
  /// 时间差（玩家.时间差，分钟；用于回血计算）
  timeDiff      Float   @default(0)
  /// 读取时间（玩家.读取时间，长整数时间戳）
  readTime      BigInt  @default(0)
  /// 是否宠物（QQ 以"g"结尾，对应原版 L2644 注释）
  isPet         Boolean @default(false)
  /// 是否临时怪物（原版 地图.临时怪物；如事件/召唤产物，清掉重刷时保留策略由业务逻辑定）
  isTemp        Boolean @default(false) // 是否临时怪物
  /// 奖励是否已被一次性认领，避免并发击杀重复发奖
  rewardClaimed Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([mapId])
  @@index([type])
}

// 说明：怪物/物品/装备/使魔/配方/任务/称号/建筑/NPC/载具部件/蓝图/增益/商店/
// 资源/特效/攻击文本/套装效果/风味文本/更新日志 等固定配置已迁移为 JSON 存储，
// 运行时由 StaticDataService 读取，不再建数据库表。

// ========== 载具系统 ==========

/// 载具定义表
model GameVehicle {
  id        Int    @id @default(autoincrement())
  name      String @unique
  vehicleId String @default("") // 8位文本ID
  type      String @default("") // 类型
  owner     String @default("") // 归属者QQ
  driver    String @default("") // 驾驶员QQ
  moveType  Int    @default(0) // 行走方式：0坐地 1陆地 2飞行 3跃迁
  maxHp     Float  @default(100)
  currentHp Float  @default(100)
  mapIndex  Int    @default(0) // 所在地图编号

  // 部件系统
  weaponSlots   Int @default(0)
  defenseSlots  Int @default(0)
  moveSlots     Int @default(0)
  functionSlots Int @default(0)
  maxWeapon     Int @default(5)
  maxDefense    Int @default(5)
  maxMove       Int @default(5)
  maxFunction   Int @default(5)
  slotStatus    Int @default(0) // 0正常 1超建议 2超上限 3两者

  // JSON 复杂数据（原生 JSON 列）
  bonus        Json? // 加成 [加成]
  parts        Json? // 零件 [物品3]
  markers      Json? // 标记 [技能]
  markers2     Json? // 有时限标记 [增益]
  recipes      Json? // 配方 [技能]
  builtinParts Json? // 内置零件 [物品3]
  coating      Int     @default(0) // 涂层
  reverseField Boolean @default(false) // 逆转力场

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ========== 商店/交易 ==========

/// 商品表
model GameShopItem {
  id        Int      @id @default(autoincrement())
  itemName  String   @default("")
  itemType  String   @default("")
  itemCount Float    @default(1)
  sellerQQ  String   @default("") // 出售人QQ
  price     Float    @default(0)
  expireAt  DateTime // 到期时间
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ========== 公屏聊天 / 频道 ==========

model Channel {
  id          Int           @id @default(autoincrement())
  name        String        @unique
  description String        @default(dbgenerated("('')")) @db.Text
  isPublic    Boolean       @default(true)
  createdBy   Int?
  createdAt   DateTime      @default(now())
  messages    ChatMessage[]
}

model ChatMessage {
  id        Int      @id @default(autoincrement())
  channelId Int
  channel   Channel  @relation(fields: [channelId], references: [id], onDelete: Cascade)
  senderId  Int?
  sender    User?    @relation(fields: [senderId], references: [id], onDelete: SetNull)
  type      String   @default("chat")
  // LongText：批量召唤/结算等极端长回包曾因 MySQL TEXT(64KB) 落库失败，导致公屏无系统回包
  content   String   @db.LongText
  // 可见范围：public=公屏可见(默认)；private=仅 senderId 本人可见，其他玩家只看到占位提示。
  // 用于探测雷达等高价值情报指令，防止他人白嫖他人探测结果（2026-09-13）。
  visibility String  @default("public")
  // 私密消息对其他玩家展示的占位文本：落库时按「私密消息规则」中该指令的配置写入，
  // 供历史消息脱敏使用（为空则回退系统内置默认占位文本）。
  placeholder String?
  commandId Int?
  // 业务对象引用ID：目前用于红包消息（type='redpacket' 时指向 RedPacket.id），
  // 前端据此把消息渲染成可领取的红包卡片并订阅其实时状态。
  refId     Int?
  createdAt DateTime @default(now())

  @@index([channelId, createdAt])
}

model CommandLog {
  id         Int      @id @default(autoincrement())
  channelId  Int
  senderId   Int
  command    String
  // LongText：与 ChatMessage.content 对齐，超长指令回包（批量召唤等）写审计日志不被 TEXT(64KB) 截断失败
  result     String   @db.LongText
  durationMs Int      @default(0)
  source     String   @default("web")
  createdAt  DateTime @default(now())

  @@index([channelId, createdAt])
}

// ========== 指令注册表 ==========

model Command {
  id          Int      @id @default(autoincrement())
  name        String   @unique
  alias       String   @default(dbgenerated("('')")) @db.Text
  description String   @default(dbgenerated("('')")) @db.Text
  handlerKey  String
  argsSchema  String   @default(dbgenerated("('[]')")) @db.Text
  minRole     String   @default("USER")
  enabled     Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// ========== 系统配置中心 ==========

model SystemConfig {
  id          Int      @id @default(autoincrement())
  key         String   @unique
  value       String   @default(dbgenerated("('')")) @db.LongText
  label       String   @default(dbgenerated("('')")) @db.Text
  description String   @default(dbgenerated("('')")) @db.Text
  type        String   @default("string")
  group       String   @default("system")
  options     String   @default(dbgenerated("('[]')")) @db.Text
  updatedAt   DateTime @updatedAt
  createdAt   DateTime @default(now())
}

// ========== 游戏数据审计 ==========

/// 游戏静态数据（prisma/data/*.json）变更审计日志：
/// 记录管理员对数据条目的新增/修改/删除/回滚（含变更前后 JSON 快照），便于追溯与回滚。
/// 注意：该表此前只存在于数据库中未写入 schema，导致每次 `prisma db push` 都误判为「应删除的表」，
/// 现按库中真实结构补回（表名/索引名与既有数据完全一致，push 不会再产生差异）。
model GamedataChangeLog {
  id             Int      @id @default(autoincrement())
  operatorUserId Int
  operatorName   String
  category       String
  file           String
  action         String
  /// 变更条目在数据文件数组中的下标（列名为 MySQL 保留字 index，故用 @map）
  entryIndex     Int      @map("index")
  entryName      String
  beforeJson     String   @db.LongText
  afterJson      String   @db.LongText
  createdAt      DateTime @default(now())

  @@index([category, createdAt])
  @@index([action, createdAt])
  @@index([createdAt])
  @@map("gamedatachangelog")
}

// ========== 世界红包（私聊功能已下线，原 PrivateMessage 表随之移除） ==========

/// 世界红包：发送者把背包道具作为红包投入公屏，其他玩家先到先得；
/// 超过有效期（默认 24 小时，见 red-packet.config.ts）未被领完的份额自动退回发送者背包。
model RedPacket {
  id      Int    @id @default(autoincrement())
  senderId Int
  sender  User   @relation("RedPacketSent", fields: [senderId], references: [id], onDelete: Cascade)
  channelId Int  @default(1)
  /// 祝福语/备注（可空串）。
  /// 注意：TEXT 列在 MySQL 中不允许 DB 默认值，故此处不加 @default，
  /// 由业务层写入时统一传值（RedPacketService.createPacket 会传 greeting）。
  greeting  String @db.Text
  /// 红包玩法：NORMAL=谁都能领；TARGET=仅限指定领取人；PASSCODE=输入正确口令才能领
  packetType   String @default("NORMAL")
  /// 专属红包的指定领取人（packetType=TARGET 时有效）
  targetUserId Int?
  targetUser   User?  @relation("RedPacketTarget", fields: [targetUserId], references: [id], onDelete: SetNull)
  /// 口令红包的口令（packetType=PASSCODE 时有效）。
  /// 明文存储：仅用于游戏内小范围玩法校验，且永远只下发给发送者本人（见 RedPacketService.buildView）
  passcode     String? @db.Text
  /// ACTIVE=可领取；FINISHED=已领完；EXPIRED=已过期（剩余份额已退回发送者）
  status    String @default("ACTIVE")
  /// 总份数（= 各条目 quantity 之和），展示「已领 x/y 份」用
  totalCount   Int @default(0)
  /// 已领取份数（每被领走 1 个道具 +1）
  claimedCount Int @default(0)
  /// 过期时间（创建时间 + 有效期）
  expireAt  DateTime
  createdAt DateTime @default(now())

  items  RedPacketItem[]
  claims RedPacketClaim[]

  @@index([status, expireAt])
  @@index([senderId, createdAt])
}

/// 红包道具条目：发送时的背包道具快照，按份被领取
model RedPacketItem {
  id       Int      @id @default(autoincrement())
  packetId Int
  packet   RedPacket @relation(fields: [packetId], references: [id], onDelete: Cascade)
  name     String
  type     String   @default("")
  /// 该道具放入红包的总数量
  quantity Int      @default(0)
  /// 已被领走的数量
  claimedQuantity Int @default(0)
  /// 展示用属性快照（装备类实例数据；可堆叠道具为空）
  data       String? @db.Text
  durability String? @db.Text
  maker      String? @db.Text

  @@index([packetId])
}

/// 红包领取记录：同一玩家对同一红包只能领一次
model RedPacketClaim {
  id        Int      @id @default(autoincrement())
  packetId  Int
  packet    RedPacket @relation(fields: [packetId], references: [id], onDelete: Cascade)
  userId    Int
  user      User     @relation("RedPacketClaimed", fields: [userId], references: [id], onDelete: Cascade)
  /// 领到的道具名与数量（当前每份 1 个）
  itemName  String
  quantity  Int      @default(1)
  createdAt DateTime @default(now())

  @@unique([packetId, userId])
  @@index([userId, createdAt])
}

// ========== 全服世界事件 ==========

/// 世界事件周期：一个周期 = 一次全服共同目标。
/// 进度不单独计数，取自「世界熟练度」点数差值（见 global-proficiency.service.ts），零新增埋点。
model WorldEventCycle {
  id Int @id @default(autoincrement())
  /// 周期标识（唯一）：day→2026-09-17 / week→2026-W38 / month→2026-09；人工开启可带后缀
  cycleId String @unique
  /// 周期粒度快照：day / week / month（开周期时冻结，改配置只影响下一周期）
  period   String @default("week")
  /// 本周期抽到的任务池 key（如 kill_wave）；fixed 模式记 "fixed"
  taskKey   String  @default("kill_wave")
  /// 开周期时抽到的任务标题快照（运营改池后历史仍可读）
  taskTitle String  @default("")
  /// 进度指标：kill=击杀（Phase 1 唯一）；预留 gather / craft / challenge
  metric   String  @default("kill")
  /// 周期开始时「世界熟练度」点数快照（差值计数基准）
  startPoints Float @default(0)
  /// 本周期目标增量（管理员可校准；pool 模式取任务 goalHint）
  goalPoints  Float @default(0)
  startAt  DateTime
  endAt    DateTime
  /// ACTIVE=进行中；SETTLED=已结算（领取窗口仍开放至 graceEndAt）
  status     String @default("ACTIVE")
  /// 已解锁里程碑：{ "25": 达成ISO时刻, "50": ... }（键=百分比，值=达成时刻）
  reached    Json?
  /// 上次已播报到的进度台阶（跨 progressBroadcastStep 才推，防刷屏）
  lastStep   Int    @default(0)
  /// 结算时点数快照（复盘与下周期目标校准）
  finalPoints Float?
  /// 领取窗口截止（结算后仍可领 N 小时，见 graceHours 配置）
  graceEndAt DateTime?
  settledAt  DateTime?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  claims WorldEventClaim[]

  @@index([status, endAt])
}

/// 世界事件奖励领取记录：同一玩家同一周期同一档位只能领一次（唯一约束做幂等）
model WorldEventClaim {
  id        Int      @id @default(autoincrement())
  cycleId   Int
  cycle     WorldEventCycle @relation(fields: [cycleId], references: [id], onDelete: Cascade)
  /// 领取玩家（普通 Int，不加 User 关系以免改动 User 模型；查询走 userId 索引）
  userId    Int
  /// 领取的里程碑档位：25 / 50 / 75 / 100
  percent   Int
  createdAt DateTime @default(now())

  @@unique([cycleId, userId, percent])
  @@index([userId, createdAt])
}

// ========== 反馈系统 ==========

/// 反馈工单表：一个用户可提交多条反馈，管理员可查看与回复
model Feedback {
  id             Int               @id @default(autoincrement())
  userId         Int
  user           User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  title          String            @db.Text // 反馈标题
  category       String            @default("general") // 分类：bug/suggestion/general/other
  status         String            @default("OPEN") // 状态：OPEN/PROCESSING/RESOLVED/CLOSED
  userLastReadAt DateTime          @default(dbgenerated("('1970-01-01 00:00:00')")) // 用户最后一次查看工单详情时间，用于计算未读管理员消息数
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  messages       FeedbackMessage[]

  @@index([userId, createdAt])
  @@index([status, createdAt])
}

/// 反馈工单消息表：工单内的聊天式消息，支持多条附件
model FeedbackMessage {
  id          Int      @id @default(autoincrement())
  feedbackId  Int
  feedback    Feedback @relation(fields: [feedbackId], references: [id], onDelete: Cascade)
  senderId    Int? // 发送者用户ID（系统消息可为空）
  sender      User?    @relation(fields: [senderId], references: [id], onDelete: SetNull)
  senderType  String   @default("user") // user/admin/system
  content     String   @db.Text
  attachments Json? // 附件数组
  createdAt   DateTime @default(now())

  @@index([feedbackId, createdAt])
}

/// 持久化延时任务表：统一承载「N 秒/分钟后结算一次」的跨重启延时
/// （采集结算 / 移动到达 / 救援完成 / 装填完成 / 副本关闭等），
/// 替代「内存 setTimeout + 周期扫描兜底」的双轨制——进程重启任务不丢，
/// 也不再有"扫描发现残留标记后反复补结算"的复活问题。
/// 同 (type, userId, dedupeKey) 只保留一条：schedule 先删后插（取消/重排即覆盖）。
model DelayedTask {
  id        Int      @id @default(autoincrement())
  type      String // 任务类型：gather | move | rescue | reload | dungeonClose
  userId    Int? // 关联玩家（地图级任务为空）
  dedupeKey String? // 同类型去重键：无则用 userId，救援用标记 token，副本用地图组名
  payload   Json? // JSON 载荷（结算所需参数）
  runAt     DateTime // 到期时间
  createdAt DateTime @default(now())

  @@index([runAt])
  @@index([type, userId, dedupeKey])
}

// ========== 使魔竞技场（异步 PVP · 镜像天梯） ==========
// 设计见 docs/arena-ladder-design.md。要点：打的是冻结镜像，输了只掉天梯分，
// 不动任何真实资产 —— 因此天梯状态全部落在下面这几张新表，Player 宽表零改动。

/// 竞技场赛季：一赛季一份榜单；到期按名次发放可配置奖励（称号/头像框/资源/特权）。
model ArenaSeason {
  id       Int      @id @default(autoincrement())
  /// 赛季序号（1,2,3…），对外文案作 S{no}
  no       Int      @unique
  name     String   @default("")
  startAt  DateTime
  endAt    DateTime
  /// ACTIVE=进行中；SETTLED=已结算（结算幂等就靠这个状态位）
  status   String   @default("ACTIVE")
  /// 结算瞬间冻结的奖励配置快照（事后改配置不影响已发赛季，可复盘）
  rewardSnapshot Json?
  /// 结算摘要：{ total:Int, granted:Int, rows:[{rank,userId,name,seat,texts[]}] }
  settleInfo   Json?
  settledAt    DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([status, endAt])
}

/// 玩家竞技场档案：席位 / 名次 / 段位 / 战绩 / 每日挑战次数。
model ArenaProfile {
  id         Int      @id @default(autoincrement())
  userId     Int      @unique
  /// 当前所属赛季（换季时按 arena.seasonCarry 处理名次继承）
  seasonId   Int      @default(0)
  /// 席位号（越大越靠前）：排名互换制下它只是排序键，名次 = 按它降序后的序号，不对外展示。
  /// 默认 1 = 空榜第一人的席位；新入榜者一律排在当前最低席位之后（可以是 0 或负数）。
  rating     Int      @default(1)
  /// 本赛季达到过的最好名次（1=登顶过，0=尚未上榜）。
  /// 列名沿用 peakRating 是积分制遗留，用 @map 保持库表不变，语义已换成「最好名次」。
  bestRank   Int      @default(0) @map("peakRating")
  /// 段位名（由 arena.tierConfig 的**名次区间**推导，冗余存一行方便榜单与后台筛选）
  tier       String   @default("")
  wins       Int      @default(0)
  losses     Int      @default(0)
  draws      Int      @default(0)
  /// 连胜(正数)/连败(负数)，仅展示用
  streak     Int      @default(0)
  /// 每日挑战次数：{ lastDate:"2026-09-20", used:3 }（懒重置，与签到/抽奖同口径）
  daily      Json?
  /// 防连打：{ mirrorId: 上次挑战时刻(ms) }，超过 arena.avoidRepeatHours 才可再打
  avoid      Json?
  /// 当前挂出的镜像（一玩家一镜像）
  mirrorId   Int?
  /// 镜像提交瞬间的战斗力/等级，用于「镜像已过期」提示
  mirrorPower Int     @default(0)
  mirrorLevel Int     @default(0)
  submittedAt DateTime?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([seasonId, rating])
}

/// 角斗镜像：玩家当前配置的冻结快照。挑战时只读这份 JSON，绝不回写真实玩家。
model ArenaMirror {
  id        Int    @id @default(autoincrement())
  ownerId   Int
  ownerName String @default("")
  seasonId  Int    @default(0)
  /// 快照本体（MirrorSnapshot，见 arena/mirror-snapshot.util.ts）
  snapshot  Json
  /// 快照瞬间战斗力 / 等级（榜单展示）
  power     Int    @default(0)
  level     Int    @default(0)
  /// 席位号冗余列：随主人换位同步刷新，榜单排序与名次都由它算（列名沿用积分制）
  rating    Int    @default(1)
  tier      String @default("")
  /// 第几次提交（覆盖刷新 +1），战报里可看出打的是第几版镜像
  version   Int    @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([ownerId, seasonId])
  @@index([seasonId, rating])
}

/// 战报：一次挑战的完整结算记录（双方参战数据均为快照，赛后可复盘）。
model ArenaMatch {
  id         Int  @id @default(autoincrement())
  seasonId   Int  @default(0)
  attackerId Int
  attackerName String @default("")
  /// 防守方 = 镜像主人（可能离线）
  defenderId   Int
  defenderName String @default("")
  mirrorId     Int
  mirrorVersion  Int  @default(1)
  /// 胜者：attacker / defender / draw
  winner       String @default("")
  rounds       Int    @default(0)
  durationSec  Float  @default(0)
  /// 四列存的是**席位号**（结算前后的快照）：互换即 attackerAfter=defenderBefore 且 defenderAfter=attackerBefore；
  /// 名次会随后续换位而变，所以只写进 report.ranks，不在这里冗余。
  attackerRatingBefore Int @default(0)
  attackerRatingAfter  Int @default(0)
  defenderRatingBefore Int @default(0)
  defenderRatingAfter  Int @default(0)
  /// 入场消耗快照：{ mode:"vitality", amount:20 } / { mode:"ticket", item:"竞技场门票", amount:1 }
  entryCost  Json?
  /// 战报正文与双方快照摘要：{ lines:string[], actionLog:[], sides:{...}, seats:{attacker,defender,swapped}, ranks:{...} }
  report     Json
  createdAt  DateTime @default(now())

  @@index([attackerId, createdAt])
  @@index([defenderId, createdAt])
  @@index([seasonId, createdAt])
}

// ========== 玩家特权与装扮（赛季奖励落点，功能可授予可到期） ==========

/// 按玩家发放的可撤销「功能特权」：把散落在各指令里的「只有管理员能做」改成
/// 可授予的能力。与 role 分离——role 是后台身份，特权是玩法奖励（会到期）。
model PlayerPrivilege {
  id        Int       @id @default(autoincrement())
  userId    Int
  /// 特权键：batchGather=野外批量采集（见 arena/arena-config.defaults.ts PRIVILEGE_DEFS）
  key       String
  /// 来源：arenaSeason / admin（同 (userId,key,source) 覆盖，便于按来源续期/撤销）
  source    String    @default("admin")
  /// 授予理由文案（如「S1 赛季冠军」），面板与后台展示
  reason    String    @default("")
  /// 操作人（管理员手工授予时记录；赛季结算为空）
  grantedBy Int?
  /// 到期时刻；null=永久（管理员手工授予可用）
  expiresAt DateTime?
  /// 非空=已撤销（提前收回：赛季重置、后台调整、误发回滚）
  revokedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@unique([userId, key, source])
  @@index([userId, key])
  @@index([key])
}

/// 头像框：与称号同构（拥有 + 单一佩戴）。竞技场赛季奖励的稀有装扮落点。
model PlayerAvatarFrame {
  id       Int      @id @default(autoincrement())
  userId   Int
  /// 头像框键，定义见 arena.avatarFrames 配置
  frameKey String
  name     String   @default("")
  /// 获得来源：arenaSeason / admin
  source   String   @default("admin")
  /// 同一玩家同时只能佩戴一个，服务层负责互斥
  equipped Boolean  @default(false)
  /// 展示样式（渐变/描边标识），冗余存一份，配置改名后历史仍可读
  tone     String   @default("")
  ownedAt  DateTime @default(now())

  @@unique([userId, frameKey])
  @@index([userId, equipped])
}
