// ============================================================
// 使魔大战3 网页版 - 数据库模型定义 (Prisma Schema) - MySQL 8.0 版
// ============================================================
// 说明：
// - 本文件供 MySQL 8.0 数据库使用（provider = "mysql"），
//   与 schema.sqlite.prisma（本地 SQLite）对应，二者模型结构保持一致。
// - MySQL 原生支持 JSON/Boolean/BigInt，但为保持与 SQLite 版字段语义一致，
//   复杂结构(背包/装备/标记)依旧用 String 存 JSON 字符串。
// - 由于 MySQL 默认 VARCHAR(191) 长度有限，所有存 JSON 的字段标注 @db.LongText，
//   存长文本(描述/内容/结果)的字段标注 @db.Text，避免数据被截断。
// - 切换数据库方式：npm run db:use-mysql / npm run db:use-sqlite
//   （脚本会覆盖 schema.prisma 为对应 provider 的版本，再 prisma generate）

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ========== 用户与认证 ==========

/// 用户表：网页注册/登录账号，可绑定 QQ 号
model User {
  id          Int      @id @default(autoincrement())
  username    String   @unique
  password    String
  nickname    String   @default("")
  qqNumber    String?  @unique
  /// QQ 互联 OAuth2 openid（32位十六进制），用于识别 QQ 互联登录身份；
  /// 与 qqNumber（玩家真实QQ号，供群机器人识别）分离。
  externalId  String?  @unique
  role        String   @default("USER")
  status      String   @default("ACTIVE")
  avatar      String   @default("")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  player      Player?
  messages    ChatMessage[]
  bindings    UserBinding[]
  privateSent     PrivateMessage[]   @relation("PrivateSent")
  privateReceived PrivateMessage[]   @relation("PrivateReceived")
  feedbacks       Feedback[]
  feedbackMessages FeedbackMessage[]
  @@index([qqNumber])
}

/// 绑定关系表：一个账号可绑定多个机器人身份
model UserBinding {
  id        Int      @id @default(autoincrement())
  userId    Int
  botKey    String
  botType   String   @default("qq")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  @@unique([userId, botKey])
}

// ========== 游戏核心 - 玩家相关 ==========

/// 玩家档案：核心游戏数据用 JSON 字符串存储
model Player {
  id         Int      @id @default(autoincrement())
  userId     Int      @unique
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  // 基础属性
  level      Int      @default(1)
  exp        Float    @default(0)
  upgradeExp Float    @default(100)   // 升级所需经验
  name       String   @default("")    // 玩家/使魔名称
  type       String   @default("")    // 使魔类型
  specialSeq Int      @default(0)     // 特殊序号（对应常量表）

  // 战斗属性
  hp         Float    @default(100)
  maxHp      Float    @default(100)
  shield     Float    @default(0)     // 当前护盾
  maxShield  Float    @default(0)
  armor      Float    @default(0)     // 当前装甲
  maxArmor   Float    @default(0)
  attack     Float    @default(10)
  defense    Float    @default(0)
  speed      Float    @default(100)
  dodge      Float    @default(0)
  hit        Float    @default(100)
  crit       Float    @default(5)
  critDmg    Float    @default(150)
  regenHp    Float    @default(0)     // 生命回复
  regenShield Float   @default(0)     // 护盾回复
  regenArmor Float    @default(0)     // 装甲回复

  // 位置信息
  mapId      Int      @default(1)     // 当前地图ID
  location   String   @default("")    // 当前地点
  houseName  String   @default("")    // 家园名称

  // 复杂数据结构（JSON 字符串存储）
  backpack   String   @default("[]") @db.LongText  // 背包物品 [物品3]
  equipment  String   @default("[]") @db.LongText  // 装备 [装备]
  weapons    String   @default("[]") @db.LongText  // 武器 [装备]
  currentWeapon Int   @default(0)     // 当前武器索引
  markers    String   @default("{}") @db.LongText  // 标记/成就 [技能]
  markers2   String   @default("[]") @db.LongText  // 有时限标记 [增益]
  buffs      String   @default("[]") @db.LongText  // 增益状态 [增益]
  tasks      String   @default("[]") @db.LongText  // 任务 [任务]
  titles     String   @default("[]") @db.LongText  // 称号 [技能]
  skills     String   @default("{}") @db.LongText  // 技能熟练度
  sets       String   @default("{}") @db.LongText  // 套装信息 [套装]
  bonus      String   @default("{}") @db.LongText  // 加成属性 [加成]
  baseBonus  String   @default("{}") @db.LongText  // 基础加成
  vehicle    String   @default("")                 // 驾驶的载具ID
  safeBox    String   @default("[]") @db.LongText  // 保险柜 [物品3]
  equipmentPresets String @default("[]") @db.LongText // 装备预设
  reverse    String   @default("[]") @db.LongText  // 逆向标记
  recipes    String   @default("[]") @db.LongText  // 已解锁配方
  stats      String   @default("{}") @db.LongText  // 额外统计

  // 好感度/宠物相关
  affinity   Float    @default(0)     // 好感度
  masterQQ   String   @default("")    // 主人QQ
  vitality   Float    @default(0)     // 活力/特殊序号

  // 时间相关
  lastOpTime BigInt   @default(0)     // 最后操作时间戳
  readTime   BigInt   @default(0)     // 读取时间戳

  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

// ========== 游戏地图 ==========

/// 地图/区域表
model GameMap {
  id          Int      @id @default(autoincrement())
  name        String   @unique
  description String   @default("") @db.Text
  mapIndex    Int      @default(0)     // 地图列表编号
  level       Int      @default(1)     // 额外升级等级
  isFrontier  Boolean  @default(false) // 是否开拓地
  noTeleport  Boolean  @default(false) // 不能传送
  noMove      Boolean  @default(false) // 不能搬迁
  isInstance  Boolean  @default(false) // 是否关卡地图
  requiredTravel Int   @default(0)     // 前往需求：0无 1飞行 2传送 3跃迁

  // 复杂数据结构（JSON 字符串）
  monsters    String   @default("[]") @db.LongText  // 固定怪物列表
  spawnMonsters String @default("[]") @db.LongText  // 刷出来的怪物
  tempMonsters String  @default("[]") @db.LongText  // 临时怪物
  summons     String   @default("[]") @db.LongText  // 召唤物
  resources   String   @default("[]") @db.LongText  // 资源
  resources2  String   @default("[]") @db.LongText  // 可采集资源
  connections String   @default("[]") @db.LongText  // 可前往地图 [可前往]
  npcs        String   @default("[]") @db.LongText  // NPC列表
  items       String   @default("[]") @db.LongText  // 可拾取物品
  buildings   String   @default("[]") @db.LongText  // 建筑
  vehicles    String   @default("[]") @db.LongText  // 载具
  markers     String   @default("{}") @db.LongText  // 永久标记
  markers2    String   @default("[]") @db.LongText  // 有时间限制标记
  mapBuffs    String   @default("[]") @db.LongText  // 地图增益
  requireMarkers String @default("[]") @db.LongText // 进入要求标记
  failHint    String   @default("")    @db.Text     // 未满足要求的提示
  clearMarkers String  @default("")    @db.Text     // 进入时清除的标记
  music       String   @default("")                 // 背景音乐
  monsterCount Int     @default(3)     // 刷怪数量
  noSpecial   Boolean  @default(false) // 不刷特殊事件

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// 说明：怪物/物品/装备/使魔/配方/任务/称号/建筑/NPC/载具部件/蓝图/增益/商店/
// 资源/特效/攻击文本/套装效果/风味文本/更新日志 等固定配置已迁移为 JSON 存储，
// 运行时由 StaticDataService 读取，不再建数据库表。

// ========== 载具系统 ==========

/// 载具定义表
model GameVehicle {
  id            Int      @id @default(autoincrement())
  name          String   @unique
  vehicleId     String   @default("")    // 8位文本ID
  type          String   @default("")    // 类型
  owner         String   @default("")    // 归属者QQ
  driver        String   @default("")    // 驾驶员QQ
  moveType      Int      @default(0)     // 行走方式：0坐地 1陆地 2飞行 3跃迁
  maxHp         Float    @default(100)
  currentHp     Float    @default(100)
  mapIndex      Int      @default(0)     // 所在地图编号

  // 部件系统
  weaponSlots   Int      @default(0)
  defenseSlots  Int      @default(0)
  moveSlots     Int      @default(0)
  functionSlots Int      @default(0)
  maxWeapon     Int      @default(5)
  maxDefense    Int      @default(5)
  maxMove       Int      @default(5)
  maxFunction   Int      @default(5)
  slotStatus    Int      @default(0)     // 0正常 1超建议 2超上限 3两者

  // JSON 复杂数据
  bonus         String   @default("{}") @db.LongText  // 加成 [加成]
  parts         String   @default("[]") @db.LongText  // 零件 [物品3]
  markers       String   @default("{}") @db.LongText  // 标记 [技能]
  markers2      String   @default("[]") @db.LongText  // 有时限标记 [增益]
  recipes       String   @default("[]") @db.LongText  // 配方 [技能]
  builtinParts  String   @default("[]") @db.LongText  // 内置零件 [物品3]
  coating       Int      @default(0)     // 涂层
  reverseField  Boolean  @default(false) // 逆转力场

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

// ========== 商店/交易 ==========

/// 商品表
model GameShopItem {
  id            Int      @id @default(autoincrement())
  itemName      String   @default("")
  itemType      String   @default("")
  itemCount     Float    @default(1)
  sellerQQ      String   @default("")    // 出售人QQ
  price         Float    @default(0)
  expireAt      DateTime                   // 到期时间
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

// ========== 公屏聊天 / 频道 ==========

model Channel {
  id          Int           @id @default(autoincrement())
  name        String        @unique
  description String        @default("") @db.Text
  isPublic    Boolean       @default(true)
  createdBy   Int?
  createdAt   DateTime      @default(now())
  messages    ChatMessage[]
}

model ChatMessage {
  id        Int      @id @default(autoincrement())
  channelId Int
  channel   Channel  @relation(fields: [channelId], references: [id], onDelete: Cascade)
  senderId  Int?
  sender    User?    @relation(fields: [senderId], references: [id], onDelete: SetNull)
  type      String   @default("chat")
  content   String   @db.Text
  commandId Int?
  createdAt DateTime @default(now())
  @@index([channelId, createdAt])
}

model CommandLog {
  id          Int      @id @default(autoincrement())
  channelId   Int
  senderId    Int
  command     String
  result      String   @db.Text
  durationMs  Int      @default(0)
  source      String   @default("web")
  createdAt   DateTime @default(now())
  @@index([channelId, createdAt])
}

// ========== 指令注册表 ==========

model Command {
  id          Int     @id @default(autoincrement())
  name        String  @unique
  alias       String  @default("") @db.Text
  description String  @default("") @db.Text
  handlerKey  String
  argsSchema  String  @default("[]") @db.Text
  minRole     String  @default("USER")
  enabled     Boolean @default(true)
  sortOrder   Int     @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// ========== 系统配置中心 ==========

model SystemConfig {
  id          Int      @id @default(autoincrement())
  key         String   @unique
  value       String   @default("") @db.LongText
  label       String   @default("") @db.Text
  description String   @default("") @db.Text
  type        String   @default("string")
  group       String   @default("system")
  options     String   @default("[]") @db.Text
  updatedAt   DateTime @updatedAt
  createdAt   DateTime @default(now())
}

// ========== 玩家私聊 ==========

/// 私聊消息表：玩家之间一对一的私聊消息
model PrivateMessage {
  id         Int      @id @default(autoincrement())
  senderId   Int
  sender     User     @relation("PrivateSent", fields: [senderId], references: [id], onDelete: Cascade)
  receiverId Int
  receiver   User     @relation("PrivateReceived", fields: [receiverId], references: [id], onDelete: Cascade)
  content    String   @db.LongText
  read       Boolean  @default(false) // 接收方是否已读
  createdAt  DateTime @default(now())
  @@index([senderId, createdAt])
  @@index([receiverId, createdAt])
}

// ========== 反馈系统 ==========

/// 反馈工单表：一个用户可提交多条反馈，管理员可查看与回复
model Feedback {
  id        Int      @id @default(autoincrement())
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String   @db.Text                          // 反馈标题
  category  String   @default("general")    // 分类：bug/suggestion/general/other
  status    String   @default("OPEN")       // 状态：OPEN/PROCESSING/RESOLVED/CLOSED
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  messages  FeedbackMessage[]

  @@index([userId, createdAt])
  @@index([status, createdAt])
}

/// 反馈工单消息表：工单内的聊天式消息，支持多条附件
model FeedbackMessage {
  id          Int      @id @default(autoincrement())
  feedbackId  Int
  feedback    Feedback @relation(fields: [feedbackId], references: [id], onDelete: Cascade)
  senderId    Int?                          // 发送者用户ID（系统消息可为空）
  sender      User?    @relation(fields: [senderId], references: [id], onDelete: SetNull)
  senderType  String   @default("user")     // user/admin/system
  content     String   @db.Text
  attachments String   @default("[]") @db.LongText       // 附件数组 JSON
  createdAt   DateTime @default(now())

  @@index([feedbackId, createdAt])
}