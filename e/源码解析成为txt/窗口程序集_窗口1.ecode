a = 时间_取现行时间 ()
w = 分割文本 (编辑框1.内容, “#”, )
.计次循环首 (取数组成员数 (w), b)
    w1 = w1 + #换行符 + 处理消息 (w[b], 组合框1.取项目文本 (组合框1.现行选中项), “1048765592”)
.计次循环尾 ()
删指定行 (w1, “Image”, 图片)
.如果真 (图片 != “”)
    w1 = “(一张图片)” + #换行符 + w1
.如果真结束
w1 = 删除空行 (w1)
编辑框2.内容 = w1 + #换行符 + 到文本 ((时间_取现行时间 () - a) / #转秒) + “秒” + 测试文本
.如果真 (记录命令)
    .如果真 (去数字 (编辑框1.内容) != “”)  ' 不保存数据
        写配置项3 (p, “1”, 编辑框1.内容, “1”)
    .如果真结束
    保存配置项 (取运行目录 () + “\插件数据\使魔测试记录.txt”, p)
    刷新记录1 ()
.如果真结束
编辑框1.内容 = “”
.子程序 自动折行, , , 一行达到多少个汉字长度就换行
.参数 文本, 文本型, 参考
.参数 限制, 整数型
.局部变量 a, 整数型
.局部变量 w, 文本型, , "0"
.局部变量 w1, 文本型
.局部变量 w2, 文本型
.局部变量 b, 双精度小数型
.局部变量 c, 整数型

限制 = 限制 * 2
文本 = 子文本替换 (文本, “【分段】”, #换行符, , , 真)
文本 = 删除空行 (文本)
文本_逐字分割 (文本, w)
.计次循环首 (取数组成员数 (w), a)
    .如果 (文本_是否为汉字 (w[a]))
        .判断开始 (w[a] != #换行符)
            b = b + 2
            .判断开始 (b >= 限制)
                w1 = w1 + #换行符 + w[a]
                b = 2
                c = c + 1
            .默认
                w1 = w1 + w[a]
            .判断结束
            
        .默认
            w1 = w1 + w[a]
            b = 2
            c = c + 1
        .判断结束
        .如果真 (c > 28)
            w1 = w1 + “【分段】”
            c = 0
        .如果真结束
        
    .否则
        .判断开始 (w[a] != #换行符)
            b = b + 1
            .判断开始 (b >= 限制)
                w1 = w1 + #换行符 + w[a]
                b = 1
                c = c + 1
            .默认
                w1 = w1 + w[a]
            .判断结束
            
        .默认
            w1 = w1 + w[a]
            b = 1
            c = c + 1
        .判断结束
        .如果真 (c > 28)
            w1 = w1 + “【分段】”
            c = 0
        .如果真结束
        
    .如果结束
    
.计次循环尾 ()
文本 = w1  ' 删除空行 (w1)
