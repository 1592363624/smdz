.局部变量 a, 长整数型
.局部变量 w, 文本型, , "0"
.局部变量 b, 整数型
.局部变量 w1, 文本型

.如果真 (列表框1.现行选中项 != -1)
    a = 时间_取现行时间 ()
    w = 分割文本 (列表框1.取项目文本 (列表框1.现行选中项), “#”, )
    .计次循环首 (取数组成员数 (w), b)
        w1 = w1 + #换行符 + 处理消息 (w[b], 组合框1.取项目文本 (组合框1.现行选中项), “1048765592”)
    .计次循环尾 ()
    编辑框2.内容 = 删除空行 (w1 + #换行符 + 到文本 ((时间_取现行时间 () - a) / #转秒) + “秒”)
.如果真结束
