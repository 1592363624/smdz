.如果真 (是否有特殊宠物 (#小恶魔, 地图.召唤物, a))
    .如果真 (a > 0)
        .如果真 (寻找文本 (地图.召唤物[a].QQ, “x”, , 假) != -1)
            恶魔玩家 = 取玩家 (地图.召唤物[a].归属)
            .如果真 (恶魔玩家.编号 > 0)
                .如果真 (取成就熟练度 (怪物.标记, “攻击者” + 恶魔玩家.QQ, , ) != 0)  ' 玩家对怪物造成了伤害
                    a1 = 怪物.战斗力 / 地图.召唤物[a].战斗力 * 5
                    添加成就 (“好感” + 恶魔玩家.QQ, a1, 地图.召唤物[a].标记, )
                    a2 = 取成就熟练度 (地图.召唤物[a].标记, “好感” + 恶魔玩家.QQ, , )
                    .如果 (a2 >= 100)
                        地图.召唤物[a].QQ = “怪物” + 生成编号 () + “g”
                        w3 = 取图片 (地图.召唤物[a].类型) + “你还挺厉害的，我就勉为其难地认你做老大吧！#换行小恶魔对你的好感增加了” + 文本四舍 (a1) + 加括号 (“当前” + 文本四舍 (a2))
                    .否则
                        .判断开始 (a1 < 0.5)
                            w3 = 随机文本 (“欺负一群杂鱼有什么意思？,就这？来点厉害的让我开开眼吧！,” + 怪物.名称 + “在我们那里连提鞋都不配……”)
                        .判断 (a1 < 1)
                            w3 = 随机文本 (怪物.名称 + “吗……我一爪子能拍死一群。,稍微有点儿意思吧。,像你这样拿” + 怪物.名称 + “练手的可不多见”)
                        .判断 (a1 < 2.5)
                            w3 = “不错不错嘛！像你这样强大的家伙可不多见！”
                        .判断 (a1 < 5)
                            w3 = “好强！甚至就连” + 怪物.名称 + “也……”
                        .判断 (a1 < 10)
                            w3 = “居然连” + 怪物.名称 + “都能轻易战胜吗？！”
                        .默认
                            w3 = “哇！我什么时候也能跟你一样强大！”
                        .判断结束
                        w3 = 取图片 (地图.召唤物[a].类型) + w3 + “！#换行小恶魔对你的好感增加了” + 文本四舍 (a1) + 加括号 (“当前” + 文本四舍 (a2))
                    .如果结束
                    多线程发送群消息 (群号, w3, 3)
                .如果真结束
                
            .如果真结束
            
        .如果真结束
        
    .如果真结束
    
.如果真结束
