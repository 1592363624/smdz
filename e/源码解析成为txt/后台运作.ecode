        物品数组2[1].数量 = 1
        物品数组2[1].名称 = 贡献者1
        .如果真 (贡献者2 == 贡献者1)
            物品数组2[2].数量 = 1
            物品数组2[2].名称 = 贡献者1
        .如果真结束
