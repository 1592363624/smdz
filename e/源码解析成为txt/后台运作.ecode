.程序集 后台运作, , , 一些静默执行的操作，如刷新怪物

.子程序 生成副本
.局部变量 k, 可前往
.局部变量 名称, 文本型
.局部变量 a, 整数型
.局部变量 p2, 配置项1, , "0", 使魔大战.txt

解析配置项 (应用目录 + “\使魔大战.txt”, p2)  ' 使魔大战.txt     装备、物品等
名称 = 随机文本 (读配置项3 (p2, “商店”, “副本”, “”))
a = 取随机数 (3, 取数组成员数 (地图列表))
.计次循环首 (1000, )
    .如果 (地图列表[a].开拓地 || 地图列表[a].关卡 || 地图列表[a].不刷特殊)
        a = 取随机数 (3, 取数组成员数 (地图列表))
    .否则
        跳出循环 ()
    .如果结束
    
.计次循环尾 ()
k.距离 = 100
k.名称 = 名称 + 加括号 (“副本”)
加入成员 (地图列表[a].可前往, k)
名称 = 随机文本 (读配置项3 (p2, “商店”, “副本2”, “”))
a = 取随机数 (3, 取数组成员数 (地图列表))
.计次循环首 (1000, )
    .如果 (地图列表[a].开拓地 || 地图列表[a].关卡 || 地图列表[a].不刷特殊)
        a = 取随机数 (3, 取数组成员数 (地图列表))
    .否则
        跳出循环 ()
    .如果结束
    
.计次循环尾 ()
k.距离 = 100
k.名称 = 名称 + 加括号 (“副本”)
加入成员 (地图列表[a].可前往, k)
.子程序 弃用_刷新地图资源, , , 暂时不删，怕新写的那个有bug
.参数 d, 地图, 参考
.参数 s, 长整数型
.参数 产出, 物品3, 参考 可空 数组, 返回每日产出
.局部变量 时间差, 双精度小数型
.局部变量 c, 整数型
.局部变量 e, 整数型
.局部变量 物品, 物品3
.局部变量 a2, 小数型
.局部变量 a, 整数型
.局部变量 j, 资源1
.局部变量 物品数组, 物品3, , "0"
.局部变量 b, 整数型
.局部变量 a1, 小数型
.局部变量 人力, 小数型
.局部变量 f, 整数型, , , 超载模式
.局部变量 g1, 小数型
.局部变量 g2, 整数型
.局部变量 倍率, 小数型
.局部变量 物品数组2, 物品3, , "0"
.局部变量 d2, 地图
.局部变量 g3, 整数型
.局部变量 物品2, 物品3
.局部变量 g4, 整数型
.局部变量 总电力, 双精度小数型
.局部变量 倍率2, 小数型, , , 龙女仆加成
.局部变量 a3, 双精度小数型

时间差 = (s - d.观测时间) / #转秒
d.观测时间 = s
物品.类型 = “资源”
a = 取数组成员数 (d.召唤物)
.如果真 (a > 0)
    物品.名称 = “蛋”
    物品.数量 = 时间差 / 86400 * a
    获得物品 (d.物品, 物品)
.如果真结束
.如果真 (取物品数量 (“具现装置”, d.建筑, ) > 0)
    物品.名称 = “未知物品”
    物品.数量 = 时间差 / 86400
    获得物品 (d.物品, 物品, )
.如果真结束
.如果真 (d.开拓地)
    ' 执行建筑相关
    a2 = 取物品数量 (“燃料”, d.建筑)
    .计次循环首 (取数组成员数 (玩家列表), a)
        .如果真 (玩家列表[a].房子名称 == d.名称)
            f = 取成就熟练度 (玩家列表[a].标记, “生产模式”)
            b = 取地图列表编号 (玩家列表[a].房子)
            .如果真 (b != 0)
                d2 = 地图列表[b]
            .如果真结束
            跳出循环 ()
        .如果真结束
        
    .计次循环尾 ()
    倍率 = 1
    .如果真 (a2 > 0)
        g1 = 取物品数量 (“工业灌溉”, d.建筑)
    .如果真结束
    .计次循环首 (取数组成员数 (d.召唤物), a)
        .如果真 (d.召唤物[a].活力 == #执行者)
            倍率 = 0.95
            跳出循环 ()
        .如果真结束
        
    .计次循环尾 ()
    倍率2 = 1
    .计次循环首 (取数组成员数 (d.召唤物), a)
        .如果真 (d.召唤物[a].活力 == #龙女仆)
            倍率2 = 1.05
            跳出循环 ()
        .如果真结束
        
    .计次循环尾 ()
    .计次循环首 (取数组成员数 (d.建筑), a)  ' 取加成
        j = 取建筑 (d.建筑[a].名称)
        .如果真 (j.名称 != “”)
            人力 = 人力 + 1
        .如果真结束
        
    .计次循环尾 ()
    g2 = 取物品数量 (“工业控制电路”, d.建筑)
    g3 = 取物品数量 (“工业牵引光束”, d.建筑)
    .计次循环首 (取数组成员数 (d2.资源), a)  ' 取牵引光束产出
        .计次循环首 (取数组成员数 (d2.资源[a].产出), b)
            物品.名称 = d2.资源[a].产出[b].名称
            判断物品2 (物品)
            .如果真 (物品.类型 == “资源”)
                .判断开始 (f == 1)
                    物品.数量 = d2.资源[a].产出[b].数量 * g3 * 1.25 * d2.资源[a].产出[b].几率 / 20 * 倍率2
                .默认
                    物品.数量 = d2.资源[a].产出[b].数量 * g3 * d2.资源[a].产出[b].几率 / 20 * 倍率2
                .判断结束
                获得物品 (物品数组, 物品, 真)
            .如果真结束
            
        .计次循环尾 ()
    .计次循环尾 ()
    .计次循环首 (取数组成员数 (d.建筑), a)  ' 取总产出
        j = 取建筑 (d.建筑[a].名称)
        .计次循环首 (取数组成员数 (j.产出), b)
            物品.名称 = j.产出[b].名称
            .判断开始 (j.产出[b].数量 > 0)
                .如果真 (j.产出[b].名称 == “电力” || j.产出[b].名称 == “燃料”)
                    j.产出[b].数量 = j.产出[b].数量 * (1 + g2 / 100) * 倍率2
                .如果真结束
                .判断开始 (f == 1)
                    物品.数量 = j.产出[b].数量 * d.建筑[a].数量 * 1.25 * 倍率2
                .默认
                    物品.数量 = j.产出[b].数量 * d.建筑[a].数量 * 倍率2
                .判断结束
                .如果真 (j.产出[b].名称 == “电力”)
                    总电力 = 总电力 + 物品.数量
                .如果真结束
                
            .默认
                .判断开始 (物品.名称 == “燃料”)
                    .判断开始 (f == 1)
                        物品.数量 = j.产出[b].数量 * d.建筑[a].数量 * 1.5 * 求次方 (1 + 0.0025 * (1 + g1 / 100), g1)
                    .默认
                        物品.数量 = j.产出[b].数量 * d.建筑[a].数量 * 1.5 * 求次方 (1 + 0.0025 * (1 + g1 / 100), g1)
                    .判断结束
                    
                .默认
                    .如果真 (物品.名称 == “电力”)
                        物品.数量 = j.产出[b].数量 * d.建筑[a].数量 * 倍率
                        a3 = a3 - 物品.数量
                    .如果真结束
                    
                .判断结束
                
            .判断结束
            获得物品 (物品数组, 物品, 真)
        .计次循环尾 ()
    .计次循环尾 ()
    .如果真 (g1 > a3 / 10000 * 3)
        g1 = a3 / 10000 * 3
    .如果真结束
    .计次循环首 (取数组成员数 (d.召唤物), a)
        .如果真 (d.召唤物[a].活力 == #英招)
            g1 = g1 + 1
            跳出循环 ()
        .如果真结束
        
    .计次循环尾 ()
    .计次循环首 (取数组成员数 (d.资源2), c)  ' 加入作物产出
        .计次循环首 (取数组成员数 (d.资源2[c].产出2), e)
            物品.名称 = d.资源2[c].产出2[e].名称
            物品.数量 = d.资源2[c].产出2[e].数量 / 10 * d.资源2[c].次数 * (1 + g1 / 10)
            获得物品 (物品数组, 物品, 真)
        .计次循环尾 ()
    .计次循环尾 ()
    g4 = 取物品数量 (“按摩椅”, d.建筑)
    人力 = (g4 + 取数组成员数 (d.召唤物)) * (1 + g4 / 50) / 向上取整 (人力 / 6)  ' 召唤物工作
    .如果真 (人力 > 1)
        人力 = 1
    .如果真结束
    .如果真 (取物品数量 (“电力”, 物品数组) >= 0)  ' 需要电力
        a1 = 取物品数量 (“燃料”, 物品数组)
        .计次循环首 (取数组成员数 (d.资源2), c)  ' 扣除作物产出，后面另外生成
            .计次循环首 (取数组成员数 (d.资源2[c].产出2), e)  ' ↓
                物品.名称 = d.资源2[c].产出2[e].名称  ' 因为作物不受燃料影响
                物品.数量 = -d.资源2[c].产出2[e].数量 / 10 * d.资源2[c].次数 * (1 + g1 / 10)
                获得物品 (物品数组, 物品, 真)
            .计次循环尾 ()
        .计次循环尾 ()
        .判断开始 (a1 > 0)  ' 燃料产出大于0
            产出 = 物品数组
            .计次循环首 (取数组成员数 (物品数组), a)
                物品数组[a].数量 = 物品数组[a].数量 * 时间差 / 60 * 人力
                .判断开始 (物品数组[a].名称 == “电力”)
                    
                .默认
                    获得物品 (物品数组2, 物品数组[a], 真)  ' 其他产出
                .判断结束
                
            .计次循环尾 ()
            d.等级2 = 1  ' 有电
        .默认
            ' 燃料产出小于0
            产出 = 物品数组
            a1 = a1 * 时间差 / 60  ' 到现在为止的消耗
            物品.名称 = “燃料”
            物品.数量 = a1
            获得物品 (d.建筑, 物品)
            .判断开始 (a2 > -a1)  ' 剩余燃料大于消耗
                .计次循环首 (取数组成员数 (物品数组), a)
                    物品数组[a].数量 = 物品数组[a].数量 * 时间差 / 60 * 人力
                    .判断开始 (物品数组[a].名称 == “电力”)
                        
                    .默认
                        获得物品 (物品数组2, 物品数组[a], 真)
                    .判断结束
                    
                .计次循环尾 ()
                d.等级2 = 1  ' 有电
            .默认
                a2 = a2 / (-a1 / 60)  ' 剩余燃料时间 秒
                .计次循环首 (取数组成员数 (物品数组), a)
                    物品数组[a].数量 = 物品数组[a].数量 * a2 * 人力
                    .判断开始 (物品数组[a].名称 == “电力”)
                        
                    .默认
                        获得物品 (物品数组2, 物品数组[a], 真)
                    .判断结束
                    
                .计次循环尾 ()
                d.等级2 = 0
            .判断结束
            
        .判断结束
        
    .如果真结束
    
.如果真结束
.计次循环首 (取数组成员数 (产出), c)
    .如果真 (产出[c].数量 > 0)
        产出[c].数量 = 产出[c].数量 * 1440 * 人力
    .如果真结束
    
.计次循环尾 ()
.计次循环首 (取数组成员数 (d.资源2), c)  ' 作物产出
    .计次循环首 (取数组成员数 (d.资源2[c].产出2), e)
        物品.名称 = d.资源2[c].产出2[e].名称
        物品.数量 = d.资源2[c].产出2[e].数量 * 时间差 / 600 * d.资源2[c].次数 * (1 + g1 / 10)
        获得物品 (物品数组2, 物品, 真)
        物品2 = 物品
        物品2.数量 = d.资源2[c].产出2[e].数量 * 144 * d.资源2[c].次数 * (1 + g1 / 10)
        获得物品 (产出, 物品2, 真)
    .计次循环尾 ()
.计次循环尾 ()
.计次循环首 (取数组成员数 (物品数组2), a)
    .如果真 (物品数组2[a].名称 != “电力”)
        .如果真 (物品数组2[a].数量 > 0)
            获得物品 (d.物品, 物品数组2[a])
        .如果真结束
        
    .如果真结束
    
.计次循环尾 ()
.子程序 地图NPC判断
.参数 地图, 地图
.局部变量 a, 整数型
.局部变量 b, 整数型

.如果真 (地图.人物数量 > 0)
    .计次循环首 (取数组成员数 (地图.召唤物), a)
        .如果真 (地图.召唤物[a].归属 != “”)
            b = b + 1  ' 有主的有几个
        .如果真结束
        
    .计次循环尾 ()
    b = 地图.人物数量 - (取数组成员数 (地图.召唤物) - b)  ' 应该生成几个
    .计次循环首 (b, )
        加入成员 (地图.召唤物, 生成npc ())
    .计次循环尾 ()
.如果真结束

.子程序 移动临时怪物
.参数 d, 地图, 参考
.局部变量 a, 整数型

.计次循环首 (取数组成员数 (d.临时怪物), a)
    .如果真 (d.临时怪物[a].名称 != “”)
        加入成员 (d.怪物2, d.临时怪物[a])
    .如果真结束
    
.计次循环尾 ()
重定义数组 (d.临时怪物, 假, 0)
.计次循环首 (取数组成员数 (d.临时召唤物), a)
    .如果真 (d.临时召唤物[a].名称 != “”)
        加入成员 (d.召唤物, d.临时召唤物[a])
    .如果真结束
    
.计次循环尾 ()
重定义数组 (d.临时召唤物, 假, 0)
.子程序 掉落货舱
.参数 几率, 整数型
.局部变量 a, 整数型
.局部变量 z, 资源1
.局部变量 b, 整数型
.局部变量 c, 整数型
.局部变量 z2, 资源1, , "0"

.如果真 (几率 == 0)
    几率 = 5
.如果真结束
.计次循环首 (3, )
    a = 取随机数 (3, 取数组成员数 (地图列表))
    .计次循环首 (1000, )
        .如果 (地图列表[a].开拓地 || 地图列表[a].关卡 || 地图列表[a].不刷特殊)
            a = 取随机数 (3, 取数组成员数 (地图列表))
        .否则
            跳出循环 ()
        .如果结束
        
    .计次循环尾 ()
    c = 0
    .计次循环首 (取数组成员数 (地图列表[a].资源2), b)
        .如果真 (地图列表[a].资源2[b].名称 == “货舱”)
            c = b
            跳出循环 ()
        .如果真结束
        
    .计次循环尾 ()
    .判断开始 (c == 0)
        加入成员 (地图列表[a].资源2, 资源列表1[1])
    .默认
        地图列表[a].资源2[c].次数 = 地图列表[a].资源2[c].次数 + 1
    .判断结束
    
.计次循环尾 ()
.计次循环首 (5, )
    c = 0
    a = 取随机数 (3, 取数组成员数 (地图列表))
    .计次循环首 (1000, )
        .如果 (地图列表[a].开拓地 || 地图列表[a].关卡 || 地图列表[a].不刷特殊)
            a = 取随机数 (3, 取数组成员数 (地图列表))
        .否则
            跳出循环 ()
        .如果结束
        
    .计次循环尾 ()
    .计次循环首 (取数组成员数 (地图列表[a].资源2), b)
        .如果真 (地图列表[a].资源2[b].名称 == “能量元素”)
            c = b
            跳出循环 ()
        .如果真结束
        
    .计次循环尾 ()
    .判断开始 (c == 0)
        加入成员 (地图列表[a].资源2, 资源列表1[2])
    .默认
        地图列表[a].资源2[c].次数 = 地图列表[a].资源2[c].次数 + 1
    .判断结束
    
.计次循环尾 ()
.如果真 (几率判断 (几率))  ' 随机地图刷新作物
    c = 0
    a = 取随机数 (3, 取数组成员数 (地图列表))
    .判断循环首 (地图列表[a].开拓地 || 地图列表[a].关卡 || 地图列表[a].不刷特殊)
        a = 取随机数 (3, 取数组成员数 (地图列表))
    .判断循环尾 ()
    .计次循环首 (取数组成员数 (资源列表1), b)
        .如果真 (取数组成员数 (资源列表1[b].产出2) > 0)  ' 只有配置项里面产出2大于0的才属于作物
            .如果真 (资源列表1[b].产出2[1].名称 != “”)
                加入成员 (z2, 资源列表1[b])
            .如果真结束
            
        .如果真结束
        
    .计次循环尾 ()
    .如果真 (取数组成员数 (z2) > 0)
        加入成员 (地图列表[a].资源2, z2[取随机数 (1, 取数组成员数 (z2))])
    .如果真结束
    
.如果真结束

.子程序 玩家活跃
.参数 玩家, 玩家, 参考
.参数 s, 长整数型
.局部变量 a, 整数型

.计次循环首 (取数组成员数 (地图列表[玩家.地图].玩家), a)
    .如果真 (地图列表[玩家.地图].玩家[a] == 玩家.QQ)
        a = -1
        跳出循环 ()
    .如果真结束
    
.计次循环尾 ()
.如果真 (a != -1)
    加入成员 (地图列表[玩家.地图].玩家, 玩家.QQ)
.如果真结束
获得增益 (地图列表[玩家.地图].标记2, “活动”, 120, , s)
获得增益 (玩家.标记2, “战斗”, 15, , s)
.子程序 生成npc, 玩家
.局部变量 w, 玩家
.局部变量 a, 整数型
.局部变量 b, 整数型
.局部变量 w1, 文本型, , "0"

w.名称 = 随机文本 (“百灵，黑月，玫瑰，勿忘我，朝暮，夕暮，秋风，夏冰，莱茵，帕卡，卡塔拉，露西亚，梓，朱莉安娜，佩珀，星河，女仆，银河，血月，雪，冰，猫，汪酱，企鹅，羽毛，银翼，音速，光年，提亚马特，丝丝，西瓜，玉米，永恒，忠诚，世界，比翼，白色，黑暗，界限，深结，绝对零度，春，夏，秋，冬，东方，西门，北冥，南宫，仙女座，铁，硝，莺，月，恒星，天星，天王星，海王星，海”)
w1 = 分割文本 (读配置项 (应用目录 + “\使魔大战.txt”, “商店”, “生成的npc”, ), “ ”, )
a = 取随机数 (1, 取数组成员数 (w1))
w.类型 = w1[a]
w.QQ = “召唤物” + 生成编号 ()
w.房子 = 对话列表[2].任务
