.局部变量 s, 日期时间型

置随机数种子 ()
物品.数量 = 5
物品.类型 = “资源”
.判断循环首 (j == 假)
    程序_延时 (1, 1)  ' 1秒执行一次
    s2 = 时间_取现行时间 ()
    自动战斗线程存活时间 = 时间_取现行时间 ()
    s = 取现行时间 ()
    a = 取时间部分 (s, #小时)
    .如果真 (取时间部分 (s, 7) == 0)  ' 分
        .如果真 (取时间部分 (s, 8) == 0)  ' 秒
            ' 这里存在整点与玩家指令一起修改全局变量 有几率出现访问无效内存的问题
            ' 但是几率很低 也还没想好怎么改
            启动线程 (&掉落货舱, 0, )
            启动线程 (&行商判断, , )
            .判断开始 (a == 0)
                启动线程 (&生成副本, 0, )
            .判断 (a == 12)
                启动线程 (&生成副本, 0, )
            .判断 (a == 18)
                启动线程 (&生成副本, 0, )
            .默认
                
            .判断结束
            
        .如果真结束
        
    .如果真结束
    等待1 = 真
    b = 取数组成员数 (待执行延时)
    .计次循环首 (b, a)
        .计次循环首 (取数组成员数 (执行中延时), c)
            .如果真 (待执行延时[b + 1 - a].命令 == 执行中延时[c].命令)
                .如果真 (执行中延时[c].qq == 待执行延时[b + 1 - a].qq)
                    删除成员 (待执行延时, b + 1 - a, )
                    跳出循环 ()
                .如果真结束
                
            .如果真结束
            
        .计次循环尾 ()
    .计次循环尾 ()
    .如果真 (取数组成员数 (待执行延时) != 0)
        加入成员 (执行中延时, 待执行延时)
        重定义数组 (待执行延时, 假, 0)
    .如果真结束
    b = 取数组成员数 (执行中延时)
    等待1 = 假
    .如果真 (测试)
        窗口1.编辑框3.内容 = 到文本 (s)
    .如果真结束
    .计次循环首 (b, a)
        .如果真 (测试)
            窗口1.编辑框3.加入文本 (#换行符 + 到文本 (a) + 执行中延时[b + 1 - a].命令 + “ ” + 执行中延时[b + 1 - a].qq + “ ” + 到文本 ((s2 - 执行中延时[b + 1 - a].执行时间) / #转秒) + “秒”)
        .如果真结束
        .如果真 (s2 - 执行中延时[b + 1 - a].执行时间 > 0)
            y = 执行中延时[b + 1 - a]
            删除成员 (执行中延时, b + 1 - a, )
            .判断开始 (测试)
                发送群消息 (“”, 处理消息 (y.命令, y.qq, y.群号), )
            .默认
                .如果 (y.群号 == “”)
                    线程_启动多参_文本型 (&处理私聊, , y.命令, y.群号, y.qq, , )
                .否则
                    .如果 (取文本左边 (y.群号, 1) == “a”)  ' 群号带a表示群临时会话
                        线程_启动多参_文本型 (&处理私聊, , y.命令, 取文本中间 (y.群号, 2, 200), y.qq, , )
                    .否则
                        线程_启动多参_文本型 (&处理群, , y.命令, y.群号, y.qq, , )
                    .如果结束
                    
                .如果结束
                
            .判断结束
            
        .如果真结束
        
    .计次循环尾 ()
    .计次循环首 (取数组成员数 (地图列表), a)
        地图NPC判断 (地图列表[a])  ' 生成NPC
        .如果真 (地图列表[a].关卡 == 假)
            b = 取数组成员数 (地图列表[a].标记2)
            .如果 (b == 0)
                .如果真 (取数组成员数 (地图列表[a].怪物2) < 地图列表[a].怪物数量)
                    .如果真 (取数组成员数 (地图列表[a].怪物) > 0)
                        w = 地图列表[a].怪物[取随机数 (1, 取数组成员数 (地图列表[a].怪物))]
                        .计次循环首 (取数组成员数 (怪物列表), d)
                            .如果真 (怪物列表[d].名称 == w)
                                g = 怪物列表[d]
                                g.类型 = g.名称
                                g.等级 = 0
                                g.QQ = “”
                                _初始化怪物 (g, , a)
                                加入成员 (地图列表[a].怪物2, g)
                                跳出循环 ()
                            .如果真结束
                            
                        .计次循环尾 ()
                    .如果真结束
                    
                .如果真结束
                
            .否则
                .计次循环首 (b, c)
                    .如果真 (s2 - 地图列表[a].标记2[b + 1 - c].有效期至 > 0)
                        w = 取文本左边 (地图列表[a].标记2[b + 1 - c].名称, 8)
                        .判断开始 (w == “刷新资源”)
                            w = 取文本中间 (地图列表[a].标记2[b + 1 - c].名称, 9, 50)
                            .计次循环首 (取数组成员数 (资源列表1), d)
                                .如果真 (资源列表1[d].名称 == w)
                                    加入成员 (地图列表[a].资源2, 资源列表1[d])
                                    跳出循环 ()
                                .如果真结束
                                
                            .计次循环尾 ()
                        .判断 (w == “刷新怪物”)  ' #刷新标记#刷新怪物
                            .如果真 (取数组成员数 (地图列表[a].怪物) > 0)
                                .如果真 (取数组成员数 (地图列表[a].怪物2) < 地图列表[a].怪物数量)
                                    w = 地图列表[a].怪物[取随机数 (1, 取数组成员数 (地图列表[a].怪物))]
                                    g.名称 = w
                                    g.类型 = g.名称
                                    g.QQ = “”
                                    g.载具 = “”
                                    g.等级 = 0
                                    _初始化怪物 (g, , a)
                                    加入成员 (地图列表[a].怪物2, g)
                                    跳出循环 ()
                                .如果真结束
                                
                            .如果真结束
                            
                        .默认
                            
                        .判断结束
                        删除成员 (地图列表[a].标记2, b + 1 - c, )
                    .如果真结束
                    
                .计次循环尾 ()
            .如果结束
            
        .如果真结束
        
    .计次循环尾 ()
    d = d + 1
    .如果真 (d >= 900 || e == 0)
        启动线程 (&处理传奇, , )
    .如果真结束
    e = e + 1
.判断循环尾 ()