.计次循环首 (取数组成员数 (地图列表), a)  ' 删除之前存在的npc们，重新在其他位置生成
    b = 取数组成员数 (地图列表[a].召唤物)
    .计次循环首 (b, c)
        .判断开始 (地图列表[a].召唤物[b - c + 1].名称 == “行商”)
            删除成员 (地图列表[a].召唤物, b - c + 1, )
        .判断 (地图列表[a].召唤物[b - c + 1].QQ == “怪物露娜1g”)
            删除成员 (地图列表[a].召唤物, b - c + 1, )
        .判断 (取文本左边 (地图列表[a].召唤物[b - c + 1].QQ, 4) == “npc1”)  ' 神之工匠
            删除成员 (地图列表[a].召唤物, b - c + 1, )
        .判断 (取文本左边 (地图列表[a].召唤物[b - c + 1].QQ, 4) == “npc2”)  ' 小雫
            删除成员 (地图列表[a].召唤物, b - c + 1, )
        .默认
            
        .判断结束
        
    .计次循环尾 ()
.计次循环尾 ()
.计次循环首 (取数组成员数 (地图列表), b)
    .计次循环首 (取数组成员数 (地图列表[b].怪物2), a)
