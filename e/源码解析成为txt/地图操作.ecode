                物品.名称 = “水晶”
                物品.数量 = a1 * 500
                加入成员 (物品数组, 物品)
                物品.名称 = “生肉”
                物品.数量 = a1 * 50
                加入成员 (物品数组, 物品)
                物品.名称 = “生物质”
                物品.数量 = -a1
                加入成员 (物品数组, 物品)
                叠加物品数组 (总产出2, 物品数组, 真)
                叠加物品数组 (建筑产出2, 物品数组, 真)
                获得物品 (总消耗2, 物品, 真)
                加入成员 (生产建筑, 生成临时建筑_多产出 (物品数组, , 7))
                文本自动添加分隔 (宠物加成文本, 地图.召唤物[a].名称 + “:” + 子文本替换 (显示物品 (物品数组, , , , , , 1440, ), “、”, “,”, , , 真), “、”)
            .如果真结束
            
        .如果真结束
        .如果真 (是否有特殊宠物 (#白兔子, 地图.召唤物, a))  ' 家园蛋和奶的产量大于0时，每日生产3奶油蛋糕
            .如果真 (取物品数量 (“奶”, 总产出2, ) > 0)
                物品.名称 = “奶油蛋糕”
                物品.数量 = 0.002084
                获得物品 (总产出2, 物品, 真)
                获得物品 (建筑产出2, 物品, 真)
                加入成员 (生产建筑, 生成临时建筑 (“奶油蛋糕”, 0.002084))  ' 0.002084 x 1440 = 3
                文本自动添加分隔 (宠物加成文本, 地图.召唤物[a].名称 + “:奶油蛋糕产出+3”, “、”)
            .如果真结束
            
        .如果真结束
        .如果真 (是否有特殊宠物 (#小雨下, 地图.召唤物, a))  ' 小雫：在家园院子时，额外添加每天产出：灵石x6、生肉-1000(需要生肉和电力供应)
            重定义数组 (物品数组, 假, 0)
            物品.名称 = “灵石”
            物品.数量 = 0.004167
            加入成员 (物品数组, 物品)
            物品.名称 = “生肉”
            物品.数量 = -0.694445
            加入成员 (物品数组, 物品)
            叠加物品数组 (总产出2, 物品数组, 真)
            叠加物品数组 (建筑产出2, 物品数组, 真)
            获得物品 (总消耗2, 物品, 真)
            加入成员 (生产建筑, 生成临时建筑_多产出 (物品数组, , 7))
            文本自动添加分隔 (宠物加成文本, 地图.召唤物[a].名称 + “:灵石产出+6”, “、”)
        .如果真结束
        .如果真 (是否有特殊宠物 (#小恶魔, 地图.召唤物, a))  ' 小恶魔：在家园院子时，额外添加每天产出：糖心巧克力x3、巧克力-600
            重定义数组 (物品数组, 假, 0)
            物品.名称 = “糖心巧克力”
            物品.数量 = 0.0020833
            加入成员 (物品数组, 物品)
            物品.名称 = “巧克力”
            物品.数量 = -0.416667
            加入成员 (物品数组, 物品)
            获得物品 (总消耗2, 物品, 真, )
            叠加物品数组 (总产出2, 物品数组, 真)
            叠加物品数组 (建筑产出2, 物品数组, 真)
            加入成员 (生产建筑, 生成临时建筑_多产出 (物品数组, , 7))
            文本自动添加分隔 (宠物加成文本, 地图.召唤物[a].名称 + “:糖心巧克力产出+3”, “、”)
        .如果真结束
        .如果真 (是否有特殊宠物 (#肉食植物, 地图.召唤物, a, ))  ' 吃掉多出来的90%肉，将这些肉转换为数量500%的绳子、10%的果实和1‰的肥料
            a1 = 取物品数量 (“生肉”, 总产出2, )
            .如果真 (a1 > 0)
                a2 = 取成就熟练度 (地图.标记, “肉食比例”, , )
                .如果真 (a2 == 0)
                    a2 = 90
                .如果真结束
                a2 = a2 / 100
                重定义数组 (物品数组, 假, 0)
                物品.名称 = “绳子”
                物品.数量 = a1 * a2 * 3
                加入成员 (物品数组, 物品)
                物品.名称 = “果实”
                物品.数量 = a1 * a2 / 10
                加入成员 (物品数组, 物品)
                物品.名称 = “肥料”
                物品.数量 = a1 * a2 / 1000
                加入成员 (物品数组, 物品)
                肉食植物文本 = #换行符 + 地图.召唤物[a].名称 + “:” + 子文本替换 (显示物品 (物品数组, , , , , , 1440, ), “、”, “,”, , , 真)
                物品.名称 = “生肉”
                物品.数量 = -a1 * a2
                加入成员 (物品数组, 物品)
                叠加物品数组 (总产出2, 物品数组, 真)
                叠加物品数组 (建筑产出2, 物品数组, 真)
                获得物品 (总消耗2, 物品, 真, )
                加入成员 (生产建筑, 生成临时建筑_多产出 (物品数组, , 5))
            .如果真结束
            
        .如果真结束
        .如果真 (是否有特殊宠物 (#螳螂, 地图.召唤物, a, ))  ' 有采集属性时，家园每日产出增加铁矿：家园作物上限x300x采集属性%(需要电力供应)
            .如果真 (地图.编号 == 0)
                地图.编号 = 取地图列表编号 (地图.名称)
            .如果真结束
            _初始化怪物 (地图.召唤物[a], 真, 地图.编号, 原始时间戳)
            .判断开始 (地图.召唤物[a].属性.采集 <= 0)
                文本自动添加分隔 (宠物加成文本, 地图.召唤物[a].名称 + “:没有采集工具或装备”, “、”)
            .默认
                物品.名称 = “铁矿”
                b = 向上取整 (玩家.等级 / 5) + 凭证使用次数 * 5  ' 作物上限
                物品.数量 = b * 地图.召唤物[a].属性.采集 / 1440
                获得物品 (总产出2, 物品, 真)
                获得物品 (建筑产出2, 物品, 真)
                加入成员 (生产建筑, 生成临时建筑 (物品.名称, 物品.数量, , , ))
                文本自动添加分隔 (宠物加成文本, 地图.召唤物[a].名称 + “:铁矿产出+” + 文本四舍 (物品.数量 * 1440), “、”)
            .判断结束
            
        .如果真结束
        a = 取物品数量 (“兔子窝”, 地图.建筑, )
        .如果真 (a > 0)  ' 如果家园产出的物品中有负数，则兔子们会到外面寻找这些物品以补充消耗，找到的数量与物品价值有关（如果有多个负数，则每个物品平分）
            重定义数组 (物品数组, 假, 0)  ' '                      每个兔子窝能找500价值的物品
            .计次循环首 (取数组成员数 (总产出2), b)
                .如果真 (总产出2[b].数量 < 0)
                    .如果真 (总产出2[b].名称 != “电力”)
                        物品 = 总产出2[b]
                        物品.数量 = 取绝对值 (物品.数量)
                        获得物品 (物品数组, 物品, , )
                    .如果真结束
                    
                .如果真结束
                
            .计次循环尾 ()
            b = 取数组成员数 (物品数组)
            .判断开始 (b > 0)
                a1 = 2000 * a / b  ' 均分每项可搜寻的物品价值
                .计次循环首 (b, c)
                    物品.名称 = 物品数组[c].名称
                    a2 = 取物品价值 (物品.名称)
                    .如果 (a2 > 0)
                        物品.数量 = a1 / a2 / 1440
                    .否则
                        物品.数量 = a1 / (1 / 取绝对值 (a2)) / 1440
                    .如果结束
                    获得物品 (总产出2, 物品, 真)
                    获得物品 (建筑产出2, 物品, 真)
                    加入成员 (生产建筑, 生成临时建筑 (物品.名称, 物品.数量, , , ))
                    文本自动添加分隔 (兔子窝文本, 物品.名称 + 文本四舍 (物品.数量 * 1440), “、”)
                .计次循环尾 ()
                兔子窝文本 = “兔子窝x” + 到文本 (a) + “:” + 兔子窝文本
            .默认
                兔子窝文本 = “兔子窝x” + 到文本 (a) + “: 没有负数的产出”
            .判断结束
            
        .如果真结束
        c = 0
        .如果真 (是否有特殊宠物 (#心之守望, 地图.召唤物, a, ))  ' 在家园院子中时，所有计算产出和消耗后，每分钟产量不小于1的产物，每分钟产量额外+1
            _初始化怪物 (地图.召唤物[a], 真, , 原始时间戳)
            a1 = 1 + 地图.召唤物[a].等级 / 100  ' 等级加成
            .计次循环首 (取数组成员数 (总产出2), b)
                .如果真 (总产出2[b].数量 >= 1)
                    .如果真 (总产出2[b].名称 != “电力”)
                        总产出2[b].数量 = 总产出2[b].数量 + 1
                        物品.名称 = 总产出2[b].名称
                        物品.数量 = a1
                        获得物品 (建筑产出2, 物品, 真)
                        加入成员 (生产建筑, 生成临时建筑 (物品.名称, 1))
                        c = c + 1
                        .如果 (c == 1)
                            心之守望文本 = #换行符 + 地图.召唤物[a].名称 + “:” + 物品.名称 + “+” + 文本四舍 (a1 * 1440)
                        .否则
                            心之守望文本 = 心之守望文本 + “,” + 物品.名称 + “+” + 文本四舍 (a1 * 1440)
                        .如果结束
                        
                    .如果真结束
                    
                .如果真结束
                
            .计次循环尾 ()
        .如果真结束
        ' =============↑特殊产出宠物============
        .计次循环首 (7, a)
            产出资源 (生产建筑, 产出存放, 建筑时间差, a, 2, 建筑产出倍率, 作物产出倍率, 电力消耗倍率, 燃料消耗倍率, 燃电产出倍率, 人力供应倍率, )
        .计次循环尾 ()
    .如果真结束
    物品.数量 = -0.15 * 时间差  ' 计算完毕后移除之前添加的肥料
    物品.名称 = “肥料”
    获得物品 (产出存放, 物品, )
    ' =============生产计算===========
    ' =============显示===============
    总产出 = 总产出2
    作物产出 = 作物产出2
    建筑产出 = 建筑产出2
    牵引产出 = 牵引产出2
    .如果真 (是否为空 (总览文本) == 假)
        .如果 (玩家.编号 == 0)
            总览文本 = “#换行#错误：求总览文本时取得的玩家不正确”
        .否则
            a = 取建筑数量 (地图.建筑)
            b = 取物品数量 (“按摩椅”, 地图.建筑, )
            总览文本 = 总览文本 + “作物:” + 加斜杠 (取作物数量 (地图), 向上取整 (玩家.等级 / 5) + 凭证使用次数 * 5, )
            总览文本 = 总览文本 + “#z9建筑:” + 加斜杠 (a, 向上取整 (玩家.等级 / 20) + 凭证使用次数 + 2, )
            .如果 (人力供应倍率 < 1)
                总览文本 = 总览文本 + “#换行(人力不足以胜任岗位,多抓几只宠物吧)#换行岗位:” + 加斜杠 ((宠物数量 + b) * (1 + b / 50), 向上取整 (a / 6), )
            .否则
                总览文本 = 总览文本 + “#换行岗位:” + 加斜杠 ((宠物数量 + b) * (1 + b / 50), 向上取整 (a / 6), )
            .如果结束
            .如果 (超载模式)
                总览文本 = 总览文本 + “#z9模式:超载”
            .否则
                总览文本 = 总览文本 + “#z9模式:正常”
            .如果结束
            a1 = 取物品数量 (“电力”, 总产出2, )
            .如果 (a1 > 0)
                总览文本 = 总览文本 + “#换行电力:” + 加斜杠 (取整 (取物品数量 (“电力”, 总产出2, )), 取整 (发电量), )
            .否则
                总览文本 = 总览文本 + “#换行电力:” + 加斜杠 (取整 (取物品数量 (“电力”, 总产出2, )), 取整 (发电量), ) + 加括号 (“电力不足,建筑生产停止”)
            .如果结束
            a1 = 取物品数量 (“燃料”, 产出存放, )
            a2 = 取物品数量 (“燃料”, 总产出2, )
            .如果 (a2 > 0)
                总览文本 = 总览文本 + “#换行燃料:” + 文本四舍 (a1) + 加括号 (“∞”)
            .否则
                a2 = a1 / 取绝对值 (a2 * 1440) * 86400
                .如果真 (a2 < 21600)
                    总览文本 = 总览文本 + “#换行(燃料供应量不足！)”
                .如果真结束
                总览文本 = 总览文本 + “#换行燃料:” + 文本四舍 (a1) + 加括号 (数字到时间 (a2))
            .如果结束
            a1 = 取物品数量 (“肥料”, 产出存放, )
            物品.名称 = “肥料”  ' 为显示添加土壤基础肥沃度
            物品.数量 = 0.15
            获得物品 (总产出2, 物品, 真, )
            a2 = 取物品数量 (“肥料”, 总产出2, )
            .如果 (a2 > 0)
                总览文本 = 总览文本 + “#换行肥料:” + 文本四舍 (a1) + 加括号 (“∞”)
            .否则
                a2 = a1 / 取绝对值 (a2 * 1440) * 86400
                .如果真 (a2 < 21600)
                    总览文本 = 总览文本 + “#换行(肥料供应量不足！)”
                .如果真结束
                总览文本 = 总览文本 + “#换行肥料:” + 文本四舍 (a1) + 加括号 (数字到时间 (a2))
            .如果结束
            总览文本 = 总览文本 + “#换行每日产出:” + 显示物品 (总产出2, , , , , , 1440, “电力”)
        .如果结束
        
    .如果真结束
    .如果真 (是否为空 (生产文本) == 假)
        .计次循环首 (取数组成员数 (作物产出2), a)
            .如果真 (作物产出2[a].名称 != “电力”)
                作物产出2[a].数量 = 作物产出2[a].数量 * 1440
            .如果真结束
            
        .计次循环尾 ()
        .计次循环首 (取数组成员数 (牵引产出2), a)
            .如果真 (牵引产出2[a].名称 != “电力”)
                牵引产出2[a].数量 = 牵引产出2[a].数量 * 1440
            .如果真结束
            
        .计次循环尾 ()
        .计次循环首 (取数组成员数 (建筑产出2), a)
            .如果真 (建筑产出2[a].名称 != “电力”)
                建筑产出2[a].数量 = 建筑产出2[a].数量 * 1440
            .如果真结束
            
        .计次循环尾 ()
        生产文本 = “#换行作物产出：” + 显示物品 (作物产出2, , , , , , , ) + 加括号 (“+” + 到文本 ((作物产出倍率 - 1) * 100) + “%”)
        生产文本 = 生产文本 + “#换行————————#换行牵引光束产出：” + 显示物品 (牵引产出2, , , , , , , ) + 加括号 (“+” + 到文本 ((建筑产出倍率 - 1) * 100) + “%”)
        生产文本 = 生产文本 + “#换行————————#换行建筑产出：” + 显示物品 (建筑产出2, , , , , , , ) + 加括号 (“+” + 到文本 ((建筑产出倍率 - 1) * 100) + “%”)
        生产文本 = 生产文本 + “#换行————————#换行总消耗：” + 显示物品 (总消耗2, , , , , , 1440, “电力”)
        .如果真 (宠物加成文本 != “”)
            生产文本 = 生产文本 + “#换行————————#换行” + 宠物加成文本
        .如果真结束
        .如果真 (肉食植物文本 != “”)
            生产文本 = 生产文本 + “#换行————————#换行” + 肉食植物文本
        .如果真结束
        .如果真 (兔子窝文本 != “”)
            生产文本 = 生产文本 + “#换行————————#换行” + 兔子窝文本
        .如果真结束
        .如果真 (心之守望文本 != “”)
            生产文本 = 生产文本 + “#换行————————#换行” + 心之守望文本
        .如果真结束
        .如果真 (世界模拟文本 != “”)
            生产文本 = 生产文本 + “#换行————————#换行” + 世界模拟文本
        .如果真结束
        生产文本 = 生产文本 + “#换行————————#换行仓储：” + 显示物品 (地图.物品, , , , , , , “电力”)
        b = 0
        .计次循环首 (取数组成员数 (总产出2), a)
            .如果真 (总产出2[a].数量 < 0)
                b = b + 1
                .如果真 (b == 1)
                    生产文本 = 生产文本 + “#换行————————#换行这些物品供应不足(仓储可消耗时间):”
                .如果真结束
                a1 = 取物品数量 (总产出2[a].名称, 产出存放, )
                生产文本 = 生产文本 + #换行符 + 总产出2[a].名称 + 加括号 (数字到时间 (a1 / 取绝对值 (总产出2[a].数量) * 86400))
            .如果真结束
            
        .计次循环尾 ()
    .如果真结束
    ' =============显示===============
.否则
    ' 不是玩家家园，主要是普通地图刷出来的作物
    .计次循环首 (7, a)
        产出资源 (地图.资源2, 产出存放, 时间差, a, 1, 1, 1, 1, 1, 1, 1, 真)
    .计次循环尾 ()
.如果结束

.子程序 观察附近, 文本型, , #观察附近 需要另起一行使用，否则有可能出现内存溢出
.参数 玩家, 玩家, 参考
.参数 输入替换, 文本型, 参考 可空, 可前往地点的输入替换
.参数 s, 长整数型
.参数 原始时间戳, 长整数型
.局部变量 a, 整数型
.局部变量 b, 整数型
.局部变量 c, 整数型
.局部变量 w2, 文本型
.局部变量 d, 地图
.局部变量 次数, 文本型
.局部变量 e, 整数型
.局部变量 a1, 双精度小数型
.局部变量 a2, 双精度小数型
.局部变量 文本, 文本型
.局部变量 玩家2, 玩家
.局部变量 物品, 物品3
.局部变量 物品数组, 物品3, , "0"
.局部变量 已显示, 文本型

.如果真 (玩家.地图 > 0)
    次数 = “0”
    物品.类型 = “资源”
    获得地图增益 (玩家, 地图列表[玩家.地图], s, 原始时间戳)
    观测地图 (地图列表[玩家.地图], 原始时间戳, 地图列表[玩家.地图].物品, , , , , , )
    普拉娜幼崽剪毛 (玩家, s)
    地图列表[玩家.地图].编号 = 玩家.地图
