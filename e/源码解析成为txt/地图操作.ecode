w3 = 指令
.计次循环首 (取数组成员数 (地图列表[地图].资源2), a)
    .如果真 (地图列表[地图].资源2[a].采集指令 == w3)
        .判断开始 (地图列表[地图].资源2[a].标记 == “”)
            e = 1
        .默认
            e = 0
        .判断结束
        .如果真 (e == 1 || 取成就熟练度 (玩家.标记, 地图列表[地图].资源2[a].标记) < 1)
            b = a
            .如果真 (地图列表[地图].资源2[a].名称 == “载具残骸”)
                特殊 = 真
            .如果真结束
            跳出循环 ()
        .如果真结束
        
    .如果真结束
    
.计次循环尾 ()
.判断开始 (b == 0)
    w = 玩家.名称 + “附近没有这种资源了”
.默认
    .判断开始 (地图列表[地图].开拓地)
        .判断开始 (取数组成员数 (地图列表[地图].资源2[b].产出2) != 0)
            .判断开始 (地图列表[地图].名称 == 玩家.房子名称)
                c = 1
            .默认
                .判断开始 (地图列表[地图].名称 == 玩家.房子名称 + “屋内”)
                    c = 1
                .默认
                    .如果真 (地图列表[地图].名称 == 玩家.房子名称 + “前线”)
                        c = 1
                    .如果真结束
                    
                .判断结束
                
            .判断结束
            
        .默认
            c = 1
        .判断结束
        
    .默认
        c = 1
    .判断结束
    .判断开始 (c == 1)
        d = 0
        .判断开始 (e == 1)
            w2 = 召唤物跟随显示 (玩家, 3, f, 真)
            e = f + 1
        .默认
            e = 1
        .判断结束
        e = e * (1 + 额外次数)  ' 采集掉的资源
        .判断开始 (特殊)
            e = 地图列表[地图].资源2[b].次数
        .默认
            .判断开始 (地图列表[地图].资源2[b].次数 > 0)
                .如果真 (e > 地图列表[地图].资源2[b].次数)
                    e = 地图列表[地图].资源2[b].次数
                .如果真结束
                
            .默认
                .如果真 (e > 取绝对值 (地图列表[地图].资源2[b].次数))
                    e = 取绝对值 (地图列表[地图].资源2[b].次数)
                .如果真结束
                
            .判断结束
            
        .判断结束
        实际采集次数 = e
        .计次循环首 (取数组成员数 (地图列表[地图].资源2[b].产出), a)
            .计次循环首 (e, )
                .如果真 (几率判断 (地图列表[地图].资源2[b].产出[a].几率 * (1 + 玩家.属性.掉落率 / 100)))
                    d = d + 1
                    .判断开始 (地图列表[地图].资源2[b].产出[a].数量 != 0)
                        物品.名称 = 地图列表[地图].资源2[b].产出[a].名称
                    .默认
                        w4 = 取文本右边 (地图列表[地图].资源2[b].产出[a].名称, 1)  ' 取装备稀有度  e d c b a s x
                        .判断开始 (文本_是否为字母 (w4))
                            物品.名称 = 取文本左边 (地图列表[地图].资源2[b].产出[a].名称, 取文本长度 (地图列表[地图].资源2[b].产出[a].名称) - 1)
                        .默认
                            物品.名称 = 地图列表[地图].资源2[b].产出[a].名称
                            w4 = “”
                        .判断结束
                        
                    .判断结束
                    判断物品2 (物品)
                    .判断开始 (物品.类型 == “装备”)
                        物品 = 生成装备 (物品.名称, w4, 玩家.套装.传说率, , , , )
                    .判断 (物品.类型 == “资源”)
                        .判断开始 (地图列表[地图].资源2[b].产出[a].数量 > 0)
                            物品.数量 = 地图列表[地图].资源2[b].产出[a].数量 * 玩家.属性.采集 / 100
                        .默认
                            物品.数量 = 取绝对值 (地图列表[地图].资源2[b].产出[a].数量)
                        .判断结束
                        
                    .默认
                        
                    .判断结束
                    获得物品 (物品数组, 物品)
                    添加成就 (“采集” + 物品.名称, 物品.数量, 玩家2.成就, 玩家.任务)
                .如果真结束
                
            .计次循环尾 ()
        .计次循环尾 ()
        .如果 (e == 1)
            .如果 (取数组成员数 (物品数组) != 0)
                w = 玩家.名称 + “收集到了” + 战利品 (玩家, , 物品数组)
            .否则
                w = 玩家.名称 + “什么都没有收集到”
            .如果结束
            
        .否则
            .如果 (取数组成员数 (物品数组) != 0)
                w = 玩家.名称 + w2 + “收集到了” + 战利品 (玩家, , 物品数组)
            .否则
                w = 玩家.名称 + w2 + “什么都没有收集到”
            .如果结束
            
        .如果结束
        w = w + “,得到了” + 文本四舍 ((玩家.等级 / 2 + 1) * e * (1 + 玩家.属性.经验 / 100)) + “经验”
        添加成就 (“采集”, e, 玩家.成就, 玩家.任务)
        添加成就 (w3, e, 玩家2.成就, 玩家.任务)
        添加成就 (“奴役”, e - 1, 玩家.成就, 玩家.任务)
        添加成就 (地图列表[地图].资源2[b].标记, 1, 玩家.标记, )
        玩家.经验 = 玩家.经验 + (1 + 玩家.等级 / 2) * e * (1 + 玩家.属性.经验 / 100)
        添加成就 (“采集熟练度”, e, 玩家.标记, )
        .如果真 (地图列表[地图].资源2[b].代发言 != “”)
            新建延时 (地图列表[地图].资源2[b].代发言 + 地图列表[地图].复活点, 玩家.QQ, 群号, 2, 原始时间戳)
        .如果真结束
        .如果真 (地图列表[地图].资源2[b].次数 != -1)
            地图列表[地图].资源2[b].次数 = 地图列表[地图].资源2[b].次数 - e
            w = w + #换行符 + 地图列表[地图].名称 + “的” + 地图列表[地图].资源2[b].名称 + “还可以采集” + 到文本 (地图列表[地图].资源2[b].次数) + “次”
        .如果真结束
        .如果真 (地图列表[地图].资源2[b].次数 == 0)
            .如果真 (地图列表[地图].资源2[b].不可再生 == 假)
                刷新标记 (地图列表[地图], 地图列表[地图].资源2[b].名称, 原始时间戳, 2)
            .如果真结束
            删除成员 (地图列表[地图].资源2, b, )
        .如果真结束
        
    .默认
        w = 玩家.名称 + “,别人家里的” + 地图列表[玩家.地图].资源2[b].名称 + “只有主人可以采集”
    .判断结束
    
.判断结束
返回 (w)
.子程序 取作物数量, 整数型
.参数 地图, 地图
.局部变量 c, 整数型
.局部变量 e, 整数型

.计次循环首 (取数组成员数 (地图.资源2), c)
    .如果真 (取数组成员数 (地图.资源2[c].产出2) != 0)
        e = e + 地图.资源2[c].次数
    .如果真结束
    
.计次循环尾 ()
返回 (e)
.子程序 生成怪物载具
.参数 g, 玩家, 参考
.参数 地图, 地图, 参考
.参数 s, 长整数型
.局部变量 zj, 载具

.如果真 (取数组成员数 (g.装备预设) >= 1)  ' 数组成员1是载具。2是宠物觉醒的装备
    .如果真 (g.装备预设[1].名称 != “”)
        zj.名称 = g.装备预设[1].名称
        zj.零件 = g.装备预设[1].装备
        zj.当前生命 = 100
        zj.归属 = g.QQ
        zj.驾驶员 = g.QQ
        zj.编号 = g.QQ
        计算载具 (zj, s)
        g.载具 = zj.编号
        zj.当前生命 = zj.加成.生命
        加入成员 (地图.载具, zj)
    .如果真结束
    
.如果真结束

.子程序 神之工匠存在, 逻辑型, , 玩家当前地图有神之工匠
.参数 地图编号, 整数型, , 玩家当前的地图
.参数 神之工匠召唤物编号, 整数型, 参考
.局部变量 地图, 地图
.局部变量 b, 整数型

.如果真 (地图编号 == 0)
    返回 (假)
.如果真结束
地图 = 地图列表[地图编号]
.计次循环首 (取数组成员数 (地图.召唤物), b)
    .如果真 (地图.召唤物[b].QQ == “npc1g”)  ' 神之工匠
        神之工匠召唤物编号 = b
        返回 (真)
    .如果真结束
    
.计次循环尾 ()
返回 (假)