.局部变量 l, 路径, , "1"
.局部变量 c, 整数型
.局部变量 w, 文本型
.局部变量 w2, 文本型
.局部变量 l3, 路径

l[1].路径[1] = 起始点
.计次循环首 (取数组成员数 (地图列表), a)
    遍历地图 (l, c, 目的地)
.计次循环尾 ()
.计次循环首 (取数组成员数 (l), a)
    .如果真 (l[a].路径[取数组成员数 (l[a].路径)] == 目的地)
        返回 (l[a])
    .如果真结束
    
.计次循环尾 ()
返回 (l3)
.子程序 遍历地图, , , 取地图路径
.参数 l, 路径, 参考 数组
.参数 次数, 整数型, 参考
.参数 目的地, 文本型
.局部变量 a, 整数型
.局部变量 b, 整数型
.局部变量 c, 整数型
.局部变量 d, 整数型
.局部变量 l2, 路径
.局部变量 e, 整数型

次数 = 次数 + 1
.计次循环首 (取数组成员数 (l), a)
    .如果真 (l[a].遍历次数 == 次数 - 1)
        .计次循环首 (取数组成员数 (地图列表), b)
            .如果真 (地图列表[b].名称 == l[a].路径[取数组成员数 (l[a].路径)])  ' 从最后一个地点取新的路径
                .计次循环首 (取数组成员数 (地图列表[b].可前往), d)
                    .计次循环首 (取数组成员数 (l), c)
                        e = 0
                        .如果真 (l[c].遍历次数 == 次数 - 1)
                            .计次循环首 (取数组成员数 (l[c].路径), e)
                                .如果真 (l[c].路径[e] == 地图列表[b].可前往[d].名称)
                                    e = -1
                                    跳出循环 ()
                                .如果真结束
                                
                            .计次循环尾 ()
                            .如果真 (e == -1)
                                跳出循环 ()
                            .如果真结束
                            
                        .如果真结束
                        
                    .计次循环尾 ()
                    .如果真 (e != -1)
                        l2 = l[a]
                        l2.距离 = l2.距离 + 地图列表[b].可前往[d].距离
                        l2.遍历次数 = 次数
                        加入成员 (l2.路径, 地图列表[b].可前往[d].名称)
                        加入成员 (l, l2)
                        .如果真 (地图列表[b].可前往[d].名称 == 目的地)
                            返回 ()
                        .如果真结束
                        
                    .如果真结束
                    
                .计次循环尾 ()
            .如果真结束
            
        .计次循环尾 ()
    .如果真结束
    
.计次循环尾 ()
.子程序 采集资源, 文本型
