    .如果 (取数组成员数 (w1) >= 5)
        g = g2  ' 重置
        g.图片 = w1[1]
        .如果真 (g.图片 == “前线” || g.图片 == “”)
            到循环尾 ()
        .如果真结束
        g.名称 = g.图片
        g.类型 = w1[2]
        g.QQ = w1[3]
        g.归属 = w1[4]
        读取成就 (w1[5], g.标记)
        g.载具 = 到文本 (取成就熟练度 (g.标记, “z”))
        置成就熟练度 (“z”, g.标记, 0)
        .计次循环首 (取数组成员数 (玩家列表), c)  ' 呃，想不起来这个是干嘛的了，为什么要给宠物赋予其主人的属性？
            .如果真 (玩家列表[c].QQ == g.归属)
                g.属性 = 玩家列表[c].属性
                g.当前生命 = g.属性.生命
                g.当前装甲 = g.属性.装甲
                g.当前护盾 = g.属性.护盾
                g.等级 = 玩家列表[c].等级
                跳出循环 ()
            .如果真结束
            
        .计次循环尾 ()
        重定义数组 (g.装备预设, 假, 2)
        重定义数组 (g.装备预设[1].装备, 假, 0)
        重定义数组 (g.装备预设[2].装备, 假, 0)
        .如果真 (取数组成员数 (w1) >= 6)
            g.装备预设[2].名称 = “1”
            w1[6] = 子文本替换 (w1[6], “?”, “&”, , , 真)
            w1[6] = 子文本替换 (w1[6], “>”, “!”, , , 真)
            读取物品 (w1[6], g.装备预设[2].装备, )  ' 读取宠物觉醒装备
        .如果真结束
        .如果真 (取文本左边 (g.QQ, 4) == “怪物”)
            .如果真 (取文本右边 (g.QQ, 1) != “g”)
                g.QQ = g.QQ + “g”
            .如果真结束
            _初始化怪物 (g, , 地图.编号, s)
        .如果真结束
        g.地图 = 地图.编号
        加入成员 (地图.召唤物, g)
    .否则
        记录错误 (“取npc成员小于5” + w[a])
    .如果结束
    
.计次循环尾 ()
w = 分割文本 (读配置项3 (读取好的地图存档配置项, 地图.名称, “载具”, ), “`”, )  ' #读取载具
