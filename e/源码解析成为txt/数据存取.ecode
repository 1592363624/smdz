            .如果真 (寻找文本 (地图列表[a].召唤物[b].QQ, “s”, , 假) == -1)  ' 不保存临时召唤物
                置成就熟练度 (“z”, 地图列表[a].召唤物[b].标记, 到整数 (地图列表[a].召唤物[b].载具))  ' 记录正在驾驶的载具
                .如果真 (地图列表[a].召唤物[b].图片 == “”)
                    地图列表[a].召唤物[b].图片 = 地图列表[a].召唤物[b].名称
                .如果真结束
                w1 = “无”
                w1 = 保存成就 (地图列表[a].召唤物[b].标记, 真)
                wb2 = “无”
                .如果真 (取数组成员数 (地图列表[a].召唤物[b].装备预设) > 1)
                    wb2 = 保存物品 (地图列表[a].召唤物[b].装备预设[2].装备)  ' 保存觉醒装备
                    wb2 = 子文本替换 (wb2, “&”, “?”, , , 真)
                    wb2 = 子文本替换 (wb2, “!”, “>”, , , 真)
                .如果真结束
                .如果 (wb == “”)
                    wb = 地图列表[a].召唤物[b].图片 + “&” + 地图列表[a].召唤物[b].类型 + “&” + 地图列表[a].召唤物[b].QQ + “&” + 地图列表[a].召唤物[b].归属 + “&” + w1 + “&” + wb2
                .否则
                    wb = wb + “!” + 地图列表[a].召唤物[b].图片 + “&” + 地图列表[a].召唤物[b].类型 + “&” + 地图列表[a].召唤物[b].QQ + “&” + 地图列表[a].召唤物[b].归属 + “&” + w1 + “&” + wb2
                .如果结束
                
            .如果真结束
            
        .如果真结束
        
    .计次循环尾 ()
    写配置项3 (p, 地图列表[a].名称, “召唤物”, wb)
    写配置项3 (p, 地图列表[a].名称, “标记”, 保存成就 (地图列表[a].标记))
    写配置项3 (p, 地图列表[a].名称, “标记2”, 保存增益 (地图列表[a].标记2))
    写配置项3 (p, 地图列表[a].名称, “标记3”, 保存增益 (地图列表[a].标记3))
    写配置项3 (p, 地图列表[a].名称, “读取时间”, 到文本 (地图列表[a].观测时间))
    写配置项3 (p, 地图列表[a].名称, “观测时间2”, 到文本 (地图列表[a].观测时间2))
    wb = “”
    物品.类型 = “资源”
    重定义数组 (物品数组, 假, 0)
    .计次循环首 (取数组成员数 (地图列表[a].资源2), b)
        .如果真 (地图列表[a].资源2[b].不可再生)
            物品.名称 = 地图列表[a].资源2[b].名称
            物品.数量 = 地图列表[a].资源2[b].次数
            获得物品 (物品数组, 物品)
        .如果真结束
        
    .计次循环尾 ()
    .计次循环首 (取数组成员数 (物品数组), b)
        .如果 (wb == “”)
            wb = 物品数组[b].名称 + “&” + 到文本 (物品数组[b].数量)
        .否则
            wb = wb + “!” + 物品数组[b].名称 + “&” + 到文本 (物品数组[b].数量)
        .如果结束
        
    .计次循环尾 ()
    写配置项3 (p, 地图列表[a].名称, “资源2”, wb)
.计次循环尾 ()
保存配置项 (目录, p)
