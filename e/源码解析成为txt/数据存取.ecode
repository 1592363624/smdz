置随机数种子 ()
m = 取运行目录 () + “\插件数据\使魔大战\使魔大战.txt”
解析配置项 (m, p)
重定义数组 (部件限制, 假, 0)
重定义数组 (精英前缀替换, 假, 0)
w1 = 分割文本 (读配置项3 (p, “商店”, “部件限制”, “”), “ ”, )
.计次循环首 (取数组成员数 (w1), a)
    j.名称 = 去数字 (w1[a])
    j.数值 = 到整数 (取数字 (w1[a]))
    加入成员 (部件限制, j)
.计次循环尾 ()
精英前缀替换 = 分割文本 (读配置项3 (p, “商店”, “精英前缀替换”, “”), “ ”, )
取配置节名3 (p, w)
.计次循环首 (取数组成员数 (w), a)
    .如果真 (取文本右边 (w[a], 4) == “模板”)
        到循环尾 ()
    .如果真结束
    类型 = 读配置项3 (p, w[a], “类型”, “”)
    .判断开始 (类型 == “武器”)  ' #武器
        z = za
        z.名称 = w[a]
        w1 = 分割文本 (读配置项3 (p, w[a], “伤害”, “物100”), “ ”, )
        .计次循环首 (取数组成员数 (w1), b)
            a1 = 到数值 (取数字 (w1[b]))
            .判断开始 (去数字 (w1[b]) == “物”)
                z.属性.物 = a1
            .判断 (去数字 (w1[b]) == “电”)
                z.属性.电 = a1
            .判断 (去数字 (w1[b]) == “火”)
                z.属性.火 = a1
            .默认
                z.属性.冰 = a1
            .判断结束
            
        .计次循环尾 ()
        z.类型 = 读配置项3 (p, w[a], “分类”, “射弹武器”)
        z.冷却 = 到数值 (读配置项3 (p, w[a], “冷却”, “10”))
        z.词条 = 分割文本 (读配置项3 (p, w[a], “属性”, “随机”), “ ”, )
        z.说明文本 = 读配置项3 (p, w[a], “说明”, “缺少说明”)
        z.攻击文本.名称 = 读配置项3 (p, w[a], “攻击文本”, “”)
        z.锁定 = 到数值 (读配置项3 (p, w[a], “锁定”, “0”))
        z.增益 = 分割文本 (读配置项3 (p, w[a], “增益”, “”), “ ”, )
        z.必出特效 = 到逻辑 (读配置项3 (p, w[a], “必出特效”, “0”))
        z.特殊序号 = 到短整数 (读配置项3 (p, w[a], “特殊序号”, “0”))
        z.效果 = 读配置项3 (p, w[a], “效果”, “”)
        读取加成 (z.自带, p, w[a])
        加入成员 (装备列表, z)
    .判断 (类型 == “装备”)  ' #装备
        z = za
        z.名称 = w[a]
        z.类型 = 读配置项3 (p, w[a], “位置”, “头部”)
        z.词条 = 分割文本 (读配置项3 (p, w[a], “属性”, “”), “ ”, )
        z.说明文本 = 读配置项3 (p, w[a], “说明”, “缺少说明”)
        读取加成 (z.自带, p, w[a])
        z.攻击文本.名称 = 读配置项3 (p, w[a], “召唤”, “”)
        z.特殊序号 = 到短整数 (读配置项3 (p, w[a], “特殊序号”, “0”))
        z.效果 = 读配置项3 (p, w[a], “效果”, “”)
        加入成员 (装备列表, z)
    .判断 (类型 == “使魔”)  ' #使魔
        s = s2
        s.名称 = w[a]
        s.特有技能 = 读配置项3 (p, w[a], “技能”, “缺少技能”)
        s.技能说明 = 读配置项3 (p, w[a], “技能说明”, “缺少说明”)
        s.说明 = 读配置项3 (p, w[a], “说明”, “缺少说明”)
        s.说明2 = 读配置项3 (p, w[a], “简略说明”, “缺少说明2”)
        s.不可召唤 = 到逻辑 (读配置项3 (p, w[a], “不可召唤”, “0”))
        s.特殊序号 = 到短整数 (读配置项3 (p, w[a], “特殊序号”, “0”))
        文本 = 读配置项3 (p, w[a], “剪毛”, “毛发1”)
        物品.名称 = 去数字 (文本)
        物品.数量 = 到数值 (取数字 (文本))
        s.毛发 = 物品
        .计次循环首 (5, b)
            s.好感[b] = 读配置项3 (p, w[a], “好感” + 到文本 (b), “缺少文本：好感” + 到文本 (b))
        .计次循环尾 ()
        加入成员 (使魔列表, s)
    .判断 (类型 == “怪物”)  ' #怪物
        n = n1
        n.名称 = w[a]
        w1 = 分割文本 (读配置项3 (p, w[a], “武器”, “触手”), “ ”, )
        .计次循环首 (取数组成员数 (w1), b)
            z = za
            z.名称 = w1[b]
            加入成员 (n.武器, z)
        .计次循环尾 ()
        w1 = 分割文本 (读配置项3 (p, w[a], “装备”, “”), “ ”, )
        .计次循环首 (取数组成员数 (w1), b)
            z = za
            z.名称 = w1[b]
            加入成员 (n.装备, z)
        .计次循环尾 ()
        w1 = 分割文本 (读配置项3 (p, w[a], “掉落”, “”), “ ”, )
        .计次循环首 (取数组成员数 (w1), b)
            w2 = 分割文本 (w1[b], “，”, )
            .如果真 (取数组成员数 (w2) == 3)
                物品 = 物品2
                物品.名称 = w2[1]
                物品.数量 = 到数值 (w2[2])
                物品.几率 = 到数值 (w2[3])
                加入成员 (n.背包, 物品)
            .如果真结束
            
        .计次循环尾 ()
        w1 = 分割文本 (读配置项3 (p, w[a], “载具”, “”), “ ”, )
        物品.类型 = “资源”
        重定义数组 (n.装备预设, 假, 2)
        重定义数组 (n.装备预设[1].装备, 假, 0)  ' 1是载具
        重定义数组 (n.装备预设[2].装备, 假, 0)  ' 第二个成员是觉醒的装备,读取时加入
        .计次循环首 (取数组成员数 (w1), b)
            .如果 (b == 1)
                n.装备预设[1].名称 = w1[1]
            .否则
                物品.名称 = 去数字 (w1[b])
                物品.数量 = 到整数 (取数字 (w1[b]))
                加入成员 (n.装备预设[1].装备, 物品)
            .如果结束
            
        .计次循环尾 ()
        读取加成 (n.基础, p, w[a])
        n.好感 = 到数值 (读配置项3 (p, w[a], “产奶量”, “0”))
        n.活力 = 到整数 (读配置项3 (p, w[a], “特殊序号”, “0”))
        n.闪避冷却 = 到数值 (读配置项3 (p, w[a], “闪避2”, “0”))
        n.说明 = 读配置项3 (p, w[a], “说明”, “”)
        文本 = 读配置项3 (p, w[a], “剪毛”, “毛发1”)
        物品.名称 = 去数字 (文本)
        物品.数量 = 到数值 (取数字 (文本))
        n.毛发 = 物品
        加入成员 (怪物列表, n)
    .判断 (类型 == “载具”)  ' #载具#部件
        bj = bj2
        bj.名称 = w[a]
        bj.说明 = 读配置项3 (p, w[a], “说明”, “缺少说明”)
        bj.上限 = 到短整数 (读配置项3 (p, w[a], “上限”, “0”))
        类型 = 读配置项3 (p, w[a], “限制”, “核心”)
        .判断开始 (类型 == “核心”)
            bj.类型 = 0
        .判断 (类型 == “防御”)
            bj.类型 = 1
        .判断 (类型 == “行走”)
            bj.类型 = 2
        .判断 (类型 == “武器”)
            bj.类型 = 3
        .判断 (类型 == “功能”)
            bj.类型 = 4
        .默认
            bj.类型 = 1
        .判断结束
        类型 = 读配置项3 (p, w[a], “行走方式”, “”)
        .判断开始 (类型 == “陆地”)
            bj.行走方式 = 1
        .判断 (类型 == “飞行”)
            bj.行走方式 = 2
        .判断 (类型 == “跃迁”)
            bj.行走方式 = 3
        .判断 (类型 == “坐地”)
            bj.行走方式 = 4
        .默认
            bj.行走方式 = 0
        .判断结束
        bj.行走 = 到短整数 (读配置项3 (p, w[a], “行走”, “0”))
        bj.防御 = 到短整数 (读配置项3 (p, w[a], “防御”, “0”))
        bj.武器 = 到短整数 (读配置项3 (p, w[a], “武器”, “0”))
        bj.功能 = 到短整数 (读配置项3 (p, w[a], “功能”, “0”))
        bj.限制2 = 读配置项3 (p, w[a], “限制2”, “”)
        w1 = 分割文本 (读配置项3 (p, w[a], “内置零件”, “”), “ ”, )
        物品.类型 = “资源”
        .计次循环首 (取数组成员数 (w1), b)
            物品.名称 = 去数字 (w1[b])
            物品.数量 = 到数值 (取数字 (w1[b]))
            加入成员 (bj.内置零件, 物品)
        .计次循环尾 ()
        读取加成 (bj.加成, p, w[a])
        加入成员 (部件列表, bj)
    .判断 (类型 == “任务”)  ' #任务
        r = r2
        r.名称 = w[a]
        r.说明 = 读配置项3 (p, w[a], “说明”, “缺少说明”)
        w1 = 分割文本 (读配置项3 (p, w[a], “要求”, “”), “ ”, )
        .计次循环首 (取数组成员数 (w1), b)
            j.名称 = 去数字 (w1[b])
            j.数值 = 到数值 (取数字 (w1[b]))
            加入成员 (r.要求, j)
        .计次循环尾 ()
        w1 = 分割文本 (读配置项3 (p, w[a], “奖励”, “”), “ ”, )
        .计次循环首 (取数组成员数 (w1), b)
            物品.名称 = 去数字 (w1[b])
            物品.数量 = 到数值 (取数字 (w1[b]))
            加入成员 (r.奖励1, 物品)
        .计次循环尾 ()
        r.任务 = 分割文本 (读配置项3 (p, w[a], “任务”, “”), “ ”, )
        加入成员 (任务列表, r)
    .判断 (类型 == “地图” && 不加载地图 == 0)  ' #地图
        d = d2
        d.名称 = w[a]
        d.说明 = 读配置项3 (p, w[a], “说明”, “缺少说明”)
        d.复活点 = 读配置项3 (p, w[a], “复活点”, “”)
        d.代发言 = 读配置项3 (p, w[a], “代发言”, “”)
        d.标记提示 = 读配置项3 (p, w[a], “标记提示”, “”)
        d.清空标记 = 读配置项3 (p, w[a], “删除标记”, “”)
        d.不可搬迁 = 到逻辑 (读配置项3 (p, w[a], “不可搬迁”, “0”))
        d.不刷特殊 = 到逻辑 (读配置项3 (p, w[a], “不刷特殊”, “0”))
        f = 读配置项3 (p, w[a], “前往需求”, “0”)
        .判断开始 (f == “跃迁”)
            d.前往需求 = #跃迁
        .判断 (f == “飞行”)
            d.前往需求 = #飞行
        .判断 (f == “传送”)
            d.前往需求 = #传送
        .默认
            d.前往需求 = 0
        .判断结束
        d.音乐 = 读配置项3 (p, w[a], “ 音乐”, “”)
        d.不可传送 = 到逻辑 (读配置项3 (p, w[a], “不可传送”, “0”))
        d.关卡 = 到逻辑 (读配置项3 (p, w[a], “关卡”, “0”))
        d.人物数量 = 到整数 (读配置项3 (p, w[a], “NPC”, “0”))
        .如果真 (d.复活点 == “”)
            d.复活点 = d.名称
        .如果真结束
        文本 = 读配置项3 (p, w[a], “怪物”, “”)
        .如果真 (文本 != “”)
            d.怪物 = 分割文本 (读配置项3 (p, w[a], “怪物”, “”), “ ”, )
        .如果真结束
        文本 = 读配置项3 (p, w[a], “标记要求”, “”)
        .如果真 (文本 != “”)
            d.标记要求 = 分割文本 (读配置项3 (p, w[a], “标记要求”, “”), “ ”, )
        .如果真结束
        w1 = 分割文本 (读配置项3 (p, w[a], “资源”, “”), “ ”, )
        .计次循环首 (取数组成员数 (w1), b)
            z1.名称 = w1[b]
            加入成员 (d.资源, z1)
        .计次循环尾 ()
        w1 = 分割文本 (读配置项3 (p, w[a], “可前往”, “”), “ ”, )
        .计次循环首 (取数组成员数 (w1), b)
            w2 = 分割文本 (w1[b], “，”, )
            .如果真 (取数组成员数 (w2) == 2)
                k.名称 = w2[1]
                k.距离 = 到数值 (w2[2])
                加入成员 (d.可前往, k)
            .如果真结束
            
        .计次循环尾 ()
        d.怪物数量 = 到整数 (读配置项3 (p, w[a], “怪物数量”, “0”))
        加入成员 (地图列表, d)
    .判断 (类型 == “资源”)  ' #资源
        z1 = z2
        z1.名称 = w[a]
        z1.采集指令 = 读配置项3 (p, w[a], “采集指令”, “”)
        z1.采集文本 = 读配置项3 (p, w[a], “采集文本”, “”)
        z1.标记 = 读配置项3 (p, w[a], “标记”, “”)
        z1.说明文本 = 读配置项3 (p, w[a], “说明”, “”)
        z1.次数 = 到整数 (读配置项3 (p, w[a], “次数”, “”))
        z1.不可再生 = 到逻辑 (读配置项3 (p, w[a], “不可再生”, “0”))
        z1.代发言 = 读配置项3 (p, w[a], “代发言”, “”)
        z1.时间倍率 = 到小数 (读配置项3 (p, w[a], “时间倍率”, “1”))
        z1.优先级 = 到整数 (读配置项3 (p, w[a], “优先级”, “1”))
        w1 = 分割文本 (读配置项3 (p, w[a], “产出”, “”), “ ”, )
        .计次循环首 (取数组成员数 (w1), b)
            w2 = 分割文本 (w1[b], “，”, )
            .如果真 (取数组成员数 (w2) == 2)
                c.名称 = 去数字 (w2[1])
                c.数量 = 到数值 (取数字 (w2[1]))
                c.几率 = 到数值 (w2[2])
                加入成员 (z1.产出, c)
            .如果真结束
            
        .计次循环尾 ()
        w1 = 分割文本 (读配置项3 (p, w[a], “产出2”, “”), “ ”, )
        .计次循环首 (取数组成员数 (w1), b)
            w2 = 分割文本 (w1[b], “，”, )
            .如果真 (取数组成员数 (w2) == 2)
                c.名称 = 去数字 (w2[1])
