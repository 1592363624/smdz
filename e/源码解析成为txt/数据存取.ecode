.子程序 读取物品
.参数 文本, 文本型
.参数 物品数组, 物品3, 参考 数组
.参数 qq, 文本型, 可空, 测试用
.局部变量 w2, 文本型, , "0"
.局部变量 w3, 文本型, , "0"
.局部变量 物品, 物品3
.局部变量 a, 整数型

重定义数组 (物品数组, 假, 0)
w2 = 分割文本 (子文本替换 (文本, “'”, “@”, , , 真), “;”, )
.计次循环首 (取数组成员数 (w2), a)
    w3 = 分割文本 (w2[a], “&”, )
    .判断开始 (取数组成员数 (w3) >= 5)
        .如果真 (w3[1] == “” || w3[2] == “”)
            到循环尾 ()
        .如果真结束
        物品.数量 = 到数值 (w3[3])
        物品.类型 = w3[2]
        .如果 (物品.类型 == “装备”)
            物品.名称 = w3[1]
            物品.耐久 = 到数值 (w3[4])
            物品.数据 = w3[5]
            加入成员 (物品数组, 物品)
        .否则
            .如果真 (物品.数量 != 0)
                物品.名称 = w3[1]
                物品.耐久 = 到数值 (w3[4])
                物品.数据 = w3[5]
                加入成员 (物品数组, 物品)
            .如果真结束
            
        .如果结束
        
    .默认
        .如果真 (取数组成员数 (w3) > 0)
            物品.名称 = w3[1]
            判断物品2 (物品)
            物品.名称 = w3[1] + 加括号 (“读取出错”)
            加入成员 (物品数组, 物品)
        .如果真结束
        
    .判断结束
    
.计次循环尾 ()
