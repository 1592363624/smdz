w1 = 分割文本 (读配置项3 (p, 玩家.QQ, “任务”, ), “`”, )  ' 取任务
.计次循环首 (取数组成员数 (w1), a)
    w2 = 分割文本 (w1[a], “!”, )
    .如果 (取数组成员数 (w2) >= 2)
        任务.名称 = w2[1]
        .如果真 (任务.名称 == “”)
            到循环尾 ()
        .如果真结束
        读取成就 (w2[2], 任务.要求)
        .判断开始 (取数组成员数 (w2) >= 3)
            任务.发布人 = w2[3]
        .默认
            任务.发布人 = “”
        .判断结束
        .判断开始 (取文本左边 (任务.名称, 8) == “解锁配方”)
            任务.说明 = “完成这个任务即可” + 任务.名称
            重定义数组 (任务.奖励1, 假, 0)
        .默认
            取任务奖励 (任务, )
        .判断结束
        加入成员 (玩家.任务, 任务)
    .否则
        记录错误 (“玩家取任务的【” + w1[a] + “】成员不为2”)
    .如果结束
    
.计次循环尾 ()
