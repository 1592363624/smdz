.如果 (攻击方.特殊序号 > 0)
    文本 = 子文本替换 (文本, “【名称】”, 攻击方.名称, , , 真)
.否则
    .如果 (攻击方.特殊序号 == -1)
        文本 = 子文本替换 (文本, “【名称】”, 攻击方.名称, , , 真)
    .否则
        文本 = 子文本替换 (文本, “【名称】”, 攻击方.名称 + 加括号 (取玩家名称 (攻击方.归属, 真)), , , 真)
    .如果结束
    
