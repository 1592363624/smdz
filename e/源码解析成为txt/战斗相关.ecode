                                .判断开始 (c == 0)
                                    .如果真 (寻找文本 (文本, 增益列表[b].触发文本, , 假) == -1)
                                        文本 = 文本 + #换行符 + 增益列表[b].触发文本 + 加括号 (文本四舍 ((1 - 防御方.属性.韧性 / 100) * 增益列表[b].持续时间) + “秒”)
                                    .如果真结束
                                    获得增益2 (增益列表[b], 防御方, 原始时间戳)
                                .默认
                                    文本 = 文本 + #换行符 + “(排斥)抵挡了一个效果:” + 增益列表[b].名称
                                .判断结束
                                
                                跳出循环 ()
                            .如果真结束
                            
