.局部变量 b, 整数型
.局部变量 w1, 文本型
.局部变量 文本, 文本型
.局部变量 w2, 文本型
.局部变量 c, 整数型
.局部变量 玩家2, 玩家
.局部变量 武器判断, 整数型, , "0"
.局部变量 a1, 双精度小数型

d = 地图列表[编号]
移动临时怪物 (d)
.判断开始 (攻击方.特殊序号 > 0)  ' 只有玩家的会大于0
    .如果真 (取数组成员数 (d.怪物2) == 0)
        文本 = 攻击方.名称 + “附近没有目标了”
        返回 (文本)
    .如果真结束
    b = 取数组成员数 (d.怪物2)
    .计次循环首 (b, a)
        .如果 (d.怪物2[b + 1 - a].特殊序号 > 0)  ' 混入了玩家，可能是内存错误导致的
            删除成员 (d.怪物2, b + 1 - a, )
        .否则
            .如果真 (d.怪物2[b + 1 - a].名称 == 攻击方.目标)
                目标 = a
            .如果真结束
            添加成就 (“攻击者” + 攻击方.QQ, 0.001, d.怪物2[a].标记, )
            置掉落 (攻击方, d.怪物2[a])
        .如果结束
        
    .计次循环尾 ()
    .如果真 (目标 == 0)
        目标 = 取随机数 (1, 取数组成员数 (d.怪物2))
    .如果真结束
    b = 0
    .如果真 (攻击方.特殊序号 == #普拉娜)
        .如果真 (取成就熟练度 (攻击方.标记, “火力全开”, , ) > 0)
            置成就熟练度 (“火力全开”, 攻击方.标记, 0)
            b = 1 + 攻击方.技能等级 * 0.025
        .如果真结束
        
    .如果真结束
    .如果真 (装备要求 (攻击方, #战术目镜, , ))
        .如果真 (时间间隔要求 (“zsmj”, 120, 攻击方.标记2, s, , 原始时间戳) == 假)
            b = b + 2
        .如果真结束
        
    .如果真结束
    .判断开始 (b > 0)  ' 普拉娜使用了技能,或者有装备战术目镜
        .计次循环首 (取数组成员数 (攻击方.武器), a)
            .如果真 (标记要求 (攻击方.武器[a].名称 + “冷却”, 攻击方.标记2, , s) == 假)
                加入成员 (武器判断, a)  ' 记录未冷却的武器的数组序号
            .如果真结束
            
        .计次循环尾 ()
        .计次循环首 (b, )
            c = 取数组成员数 (武器判断)
            .如果 (c > 0)
                a = 取随机数 (1, c)  ' 从未冷却的武器中随机取一个
                b = 武器判断[a]  ' 取随机到的武器 在玩家装备的武器中的编号
                删除成员 (武器判断, a, )  ' 不会再次用这个武器，抛弃
                武器攻击 (攻击方, b, d.怪物2, 文本, 群号, , s, , , , , d, 原始时间戳)
            .否则
                跳出循环 ()
            .如果结束
            
        .计次循环尾 ()
    .默认
        .判断开始 (攻击方.当前武器 != 0)
            .判断开始 (攻击方.武器[攻击方.当前武器].特殊序号 == #管风琴)
                .判断开始 (取成就熟练度 (攻击方.标记, “管风琴”, , ) <= 0)
                    文本 = 文本 + 攻击方.名称 + “,管风琴没有弹药了,需要” + 加引号 (“装填”)
                    返回 (文本)
                .默认
                    无延时 = 真
                    添加成就 (“管风琴”, -1, 攻击方.标记, )
                    攻击方.特效 = 攻击方.特效 + 加括号 (“管风琴弹药剩余” + 到文本 (取成就熟练度 (攻击方.标记, “管风琴”, , )))
                .判断结束
                
            .默认
                .如果真 (无延时 == 假)
                    .如果真 (去数字 (攻击方.QQ) == “”)
                        .如果真 (标记要求 (“攻击冷却”, 攻击方.标记2, w1, s))
                            文本 = 文本 + 攻击方.名称 + “,攻击冷却还需要” + w1
                            返回 (文本)
                        .如果真结束
                        
                    .如果真结束
                    
                .如果真结束
                
            .判断结束
            .判断开始 (标记要求 (攻击方.武器[攻击方.当前武器].名称 + “冷却”, 攻击方.标记2, w1, s))
                文本 = 攻击方.名称 + 攻击方.武器[攻击方.当前武器].名称 + “攻击冷却中，还需要” + w1
                返回 (文本)
            .默认
                武器攻击 (攻击方, 攻击方.当前武器, d.怪物2, 文本, 群号, 无延时, s, , , , , d, 原始时间戳)
            .判断结束
            
        .默认
            .判断开始 (标记要求 (“拳头冷却”, 攻击方.标记2, w1, s))
                文本 = “拳头攻击冷却中，还需要” + w1
                返回 (文本)
            .默认
                武器攻击 (攻击方, 攻击方.当前武器, d.怪物2, 文本, 群号, 无延时, s, , , , , d, 原始时间戳)
            .判断结束
            
        .判断结束
        
    .判断结束
    
.默认
    .判断开始 (攻击方.特殊序号 < -1)  ' 宠物攻击判断
        .计次循环首 (取数组成员数 (攻击方.武器), a)
            武器攻击 (攻击方, a, d.怪物2, 文本, 群号, 无延时, s, , , , , d, 原始时间戳)
        .计次循环尾 ()
        .计次循环首 (取数组成员数 (d.召唤物), a)  ' 保存冷却
            .如果真 (d.召唤物[a].QQ == 攻击方.QQ)
                .如果真 (d.召唤物[a].类型 == 攻击方.类型)  ' 再多加一层判断，防止内存出错的时候，两个不同的宠物会变成同样的
                    d.召唤物[a] = 攻击方
                    跳出循环 ()
                .如果真结束
                
            .如果真结束
            
        .计次循环尾 ()
    .默认
        c = 0  ' 怪物攻击判断
        .如果真 (标记要求 (“启示录”, d.标记2, , s))
            .如果真 (几率判断 (25))
                c = -1
            .如果真结束
            
        .如果真结束
        .判断开始 (c == -1)
            加入成员 (防御方, 攻击方)
            攻击方.特效 = 攻击方.特效 + 加括号 (“启示录混乱”)
            .计次循环首 (取数组成员数 (攻击方.武器), a)
                武器攻击 (攻击方, a, 防御方, 文本, 群号, 无延时, s, , , , , d, 原始时间戳)
            .计次循环尾 ()
            攻击方 = 防御方[1]
        .默认
            .计次循环首 (取数组成员数 (d.玩家), a)
                玩家2 = 取玩家 (d.玩家[a])
                .判断开始 (增益要求 (“活跃”, 玩家2.标记2, , s, ) == 假)  ' 不攻击离线 有这个buff说明在线
                    
                .判断 (玩家2.当前生命 <= 0)
                    
                .判断 (标记要求 (“隐匿模式”, 玩家2.增益, , s))
                    
                .判断 (标记要求 (“炮冠”, 玩家2.增益, , s))
                    
                .默认
                    加入成员 (防御方, 玩家2)
                .判断结束
                
            .计次循环尾 ()
            .计次循环首 (取数组成员数 (d.召唤物), a)
                .判断开始 (d.召唤物[a].当前生命 <= 0)
                    
                .默认
                    加入成员 (防御方, d.召唤物[a])
                .判断结束
                
            .计次循环尾 ()
            .计次循环首 (取数组成员数 (攻击方.武器), a)
                武器攻击 (攻击方, a, 防御方, 文本, 群号, 无延时, s, , , , , d, 原始时间戳)
                .如果真 (寻找文本 (文本, “被幻时凝固”, , 假) != -1)
                    跳出循环 ()
                .如果真结束
                .如果真 (攻击方.套装.当前麻醉 >= 攻击方.属性.麻醉)
                    跳出循环 ()
                .如果真结束
                
            .计次循环尾 ()
            .计次循环首 (取数组成员数 (防御方), a)
                .判断开始 (防御方[a].特殊序号 > 0)  ' 玩家
                    玩家列表[防御方[a].编号] = 防御方[a]
                .默认
                    .计次循环首 (取数组成员数 (d.召唤物), b)  ' 其他
                        .如果真 (d.召唤物[b].QQ == 防御方[a].QQ)
                            .如果真 (d.召唤物[b].类型 == 防御方[a].类型)
                                d.召唤物[b] = 防御方[a]
                                跳出循环 ()
                            .如果真结束
                            
                        .如果真结束
                        
                    .计次循环尾 ()
                .判断结束
                
            .计次循环尾 ()
        .判断结束
        .计次循环首 (取数组成员数 (d.怪物2), a)
            .如果真 (d.怪物2[a].QQ == 攻击方.QQ)
                d.怪物2[a] = 攻击方
                跳出循环 ()
            .如果真结束
            
        .计次循环尾 ()
    .判断结束
    
.判断结束
地图列表[编号] = d
返回 (文本)
.子程序 挑战怪物, 文本型
.参数 a, 整数型
.局部变量 名称, 文本型
.局部变量 b, 整数型

b = a % 10
.判断开始 (a < 100)
    .判断开始 (b == 1 || b == 6)
        名称 = “绿毛龟”
    .判断 (b == 2 || b == 7)
        名称 = “水元素”
    .判断 (b == 3 || b == 8)
        名称 = “巨齿鲨”
    .判断 (b == 4 || b == 9)
        名称 = “螳螂”
    .默认
        名称 = 随机文本 (“钢铁之翼，苏醒守卫者，Doge，腐化剑龙”)
    .判断结束
    
.判断 (a < 200)
    .判断开始 (b == 1 || b == 6)
        名称 = “第四帝国火力手”
    .判断 (b == 2 || b == 7)
        名称 = “纳米战士”
    .判断 (b == 3 || b == 8)
        名称 = “钢铁之翼”
    .判断 (b == 4 || b == 9)
        名称 = “Doge”
    .默认
        名称 = 随机文本 (“闪电飞龙，火焰飞龙，冰霜飞龙，剧毒飞龙”)
    .判断结束
    
.判断 (a < 300)
    .判断开始 (b == 1 || b == 6)
        名称 = “CELL直升机”
    .判断 (b == 2 || b == 7)
        名称 = “岩石巨人”
    .判断 (b == 3 || b == 8)
        名称 = 随机文本 (“Doge，闪电飞龙，火焰飞龙，冰霜飞龙，剧毒飞龙”)
    .判断 (b == 4 || b == 9)
        名称 = 随机文本 (“精英哥布林，无畏战士”)
    .默认
        名称 = 随机文本 (“熔岩巨人,精英钢铁之翼,防御节点,执行者,洛”)
    .判断结束
    
.默认
    .判断开始 (b == 1 || b == 6)
        .判断开始 (a >= 900)
            名称 = 随机文本 (“精英兔子，露娜”)
        .默认
            名称 = “精英兔子”
        .判断结束
        
    .判断 (b == 2 || b == 7)
        名称 = 随机文本 (“要塞，绫波”)
    .判断 (b == 3 || b == 8)
        名称 = 随机文本 (“精英钢铁之翼，彼岸花，曼陀罗”)
    .判断 (b == 4 || b == 9)
        名称 = 随机文本 (“精英闪电飞龙，精英火焰飞龙，精英冰霜飞龙，精英剧毒飞龙，无畏战士，稻草人，拉菲”)
    .默认
        名称 = 随机文本 (“熔岩巨人,防御节点,执行者,洛,海神龙，鹭，洛，可畏，柴郡，机械降神”)
    .判断结束
    
.判断结束
返回 (名称)
.子程序 计算反伤, 小数型, , %
.参数 防御方, 玩家
.参数 攻击方, 玩家
.参数 z1, 装备, , 攻击方武器
.参数 z2, 装备, 参考
.参数 伤害倍率, 小数型, , %
.参数 s, 长整数型
.参数 原始时间戳, 长整数型
.局部变量 a1, 小数型
.局部变量 a2, 小数型
.局部变量 a3, 小数型
.局部变量 最终, 小数型
.局部变量 倍率, 小数型, , , 0.1
.局部变量 军姬倍率限制, 逻辑型

.如果真 (防御方.好感 >= 100)
    .如果真 (防御方.特殊序号 == #恶毒)
        .如果真 (时间间隔要求 (“色欲”, 30, 防御方.标记2, s, , 原始时间戳) == 假)
            返回 (100)
        .如果真结束
        
    .如果真结束
    
.如果真结束
.如果真 (防御方.好感 >= 40)
    .如果真 (防御方.特殊序号 == #军姬)
        .如果真 (增益要求 (“剑阵”, 防御方.增益, a2, s, ))
            返回 (100)
        .如果真结束
        
    .如果真结束
    
.如果真结束
.如果真 (装备要求 (防御方, #荆棘之翼, , ))
    倍率 = 倍率 + 0.15
.如果真结束
.如果真 (装备要求 (防御方, #小鱼发饰, , ))
    .如果真 (时间间隔要求 (“小鱼冷却”, 60, 防御方.标记2, s, , 原始时间戳) == 假)
        倍率 = 倍率 + 2
    .如果真结束
    
.如果真结束
.如果真 (防御方.特殊序号 == #军姬2)
    .如果真 (防御方.当前生命 > 0)
        .如果真 (防御方.好感 >= 40)
            倍率 = 倍率 + 1
            倍率 = 倍率 + 2 + 防御方.技能等级 * 0.05
            军姬倍率限制 = 真
        .如果真结束
        
    .如果真结束
    
.如果真结束
.如果真 (倍率 != 0)
    .判断开始 (防御方.当前武器 == 0)
        z2.名称 = “拳头”
        z2.属性.物 = 100
    .默认
        z2 = 防御方.武器[防御方.当前武器]
    .判断结束
    a2 = (攻击方.属性.物伤 * z1.属性.物 / 100 + 攻击方.属性.火伤 * z1.属性.火 / 100 + 攻击方.属性.冰伤 * z1.属性.冰 / 100 + 攻击方.属性.电伤 * z1.属性.电 / 100) * 攻击方.属性.暴击伤害 / 100 * 攻击方.属性.暴击 / 100
    a2 = a2 * 伤害倍率 / 100
    a1 = (防御方.属性.物伤 * z2.属性.物 / 100 + 防御方.属性.火伤 * z2.属性.火 / 100 + 防御方.属性.冰伤 * z2.属性.冰 / 100 + 防御方.属性.电伤 * z2.属性.电 / 100) * 防御方.属性.暴击伤害 / 100 * 防御方.属性.暴击 / 100
    ' a2受到伤害 如果a2x0.15大于当前状态a3，a2=a3
    a3 = 防御方.当前生命 + 防御方.当前装甲 + 防御方.当前护盾
    .判断开始 (a2 * 倍率 > a3)
        a2 = a3
    .默认
        a2 = a2 * 倍率
    .判断结束
    ' 计算a2与防御方伤害a1的百分比得到伤害倍率
    a1 = a2 / a1 * 100
    最终 = 最终 + a1
    .如果真 (军姬倍率限制)
        a1 = 防御方.属性.生命 + 防御方.属性.装甲 + 防御方.属性.护盾
        .如果真 (最终 > (2 + 防御方.技能等级 * 0.05) * a1)
            最终 = (2 + 防御方.技能等级 * 0.05) * a1
        .如果真结束
        
    .如果真结束
    
.如果真结束
返回 (最终)
.子程序 战利品, 文本型
.参数 玩家, 玩家, 参考
.参数 物品, 物品3, 可空
.参数 物品数组, 物品3, 可空 数组
.参数 判断几率, 逻辑型, 可空
.局部变量 a, 整数型
.局部变量 继续, 逻辑型
.局部变量 d, 整数型
.局部变量 w, 文本型
.局部变量 b, 整数型
.局部变量 成就, 技能, , "0"
.局部变量 物品数组2, 物品3, , "0"

加入成员 (物品数组, 物品)
.计次循环首 (取数组成员数 (物品数组), a)
    .如果真 (物品数组[a].名称 == “”)
        到循环尾 ()
    .如果真结束
    .如果真 (物品数组[a].名称 == “电力”)
        到循环尾 ()
    .如果真结束
    .如果 (判断几率)
        继续 = 假
        .如果真 (几率判断 (物品数组[a].几率))
            继续 = 真
        .如果真结束
        
    .否则
        继续 = 真
    .如果结束
    .如果真 (继续)
        判断物品2 (物品数组[a])
        .判断开始 (物品数组[a].类型 == “装备”)
            .如果真 (物品数组[a].数量 < 1)
                物品数组[a].数量 = 1
            .如果真结束
            .计次循环首 (物品数组[a].数量, b)
                d = d + 1
                调试输出 (物品数组[a].数据)
                .如果真 (物品数组[a].数据 == “”)
                    物品数组[a] = 生成装备 (物品数组[a].名称, , 玩家.套装.传说率, , , , )
                .如果真结束
                添加成就 (“获得装备”, 1, 玩家.成就, 玩家.任务)
                添加成就 (“获得” + 物品数组[a].名称, 物品数组[a].数量, 成就, 玩家.任务)
                加入成员 (玩家.背包, 物品数组[a])
                获得物品 (物品数组2, 物品数组[a], , )
                物品数组[a].数据 = “”  ' 重置
            .计次循环尾 ()
        .判断 (物品数组[a].类型 == “资源”)
            d = d + 1
            .判断开始 (物品数组[a].名称 == “好感”)
                添加成就 (玩家.类型 + “好感”, 物品数组[a].数量, 玩家.标记, 玩家.任务)
                添加成就 (“好感”, 物品数组[a].数量, 成就, 玩家.任务)
            .判断 (物品数组[a].名称 == “经验”)
                物品数组[a].数量 = 物品数组[a].数量 * (1 + 玩家.属性.经验 / 100)
                .如果真 (物品数组[a].数量 > 0)
                    玩家.经验 = 玩家.经验 + 物品数组[a].数量
                .如果真结束
                
            .默认
                添加成就 (“采集资源”, 物品数组[a].数量, 玩家.成就, 玩家.任务)
                获得物品 (玩家.背包, 物品数组[a], )
