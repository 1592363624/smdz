        返回 ()
    .如果真结束
    文本 = 文本 + #换行符 + 显示攻击文本 (z1, 5, 攻击文本)
    文本 = 子文本替换 (文本, “【载具】”, , , , 真)
    文本 = 子文本替换 (文本, “【名称】”, 攻击方.名称, , , 真)
    文本 = 子文本替换 (文本, “【武器】”, z1.名称, , , 真)
    .如果 (去数字 (攻击方.QQ) == “”)
        新建延时 (“覅公jj” + 攻击方.QQ + “$” + z1.名称, 攻击方.QQ, 群号, z1.锁定, 原始时间戳)
    .否则
        新建延时 (“覅公jj” + 攻击方.QQ + “$” + z1.名称, “0”, 群号, z1.锁定, 原始时间戳)
    .如果结束
    
.否则
    .如果真 (无延迟 == 假)  ' 没有锁定时间的武器
        .如果真 (伤害倍率 == -1)
            z1.冷却 = z1.冷却 * 1.5
        .如果真结束
        .判断开始 (时间间隔要求 (z1.名称 + “冷却”, z1.冷却, 攻击方.标记2, s, , 原始时间戳))
            返回 ()
        .默认
            
        .判断结束
        .判断开始 (攻击方.特殊序号 == #普拉娜)
            时间间隔要求 (“攻击冷却”, 2, 攻击方.标记2, s, , 原始时间戳)
            文本 = #换行符 + 加中括号 (“武器:” + z1.名称) + 文本
        .判断 (z1.特殊序号 == #雷火剑)
            时间间隔要求 (“攻击冷却”, z1.冷却 * 0.333, 攻击方.标记2, s, , 原始时间戳)
        .默认
            .如果 (装备要求 (攻击方, #机械触手, , ))
                文本 = #换行符 + 加中括号 (“武器:” + z1.名称) + 文本
