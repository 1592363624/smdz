    .如果真结束
    .判断开始 (攻击方.特殊序号 == #战斗女仆)  ' 使魔：战斗女仆的技能
        b = 1
        a = 0
        .如果真 (攻击方.好感 >= 80)  ' 使魔：战斗女仆的技能
            .判断开始 (增益要求 (“守护1”, 攻击方.增益, , s, ))
                b = b + 1
            .默认
                .如果真 (时间间隔要求 (“超算”, 20, 攻击方.标记2, s, , 原始时间戳) == 假)
                    b = b + 1
                .如果真结束
                
            .判断结束
            .如果真 (取成就熟练度 (攻击方.标记, “守护4”, , ) == 1)
                b = b + 1
                置成就熟练度 (“守护4”, 攻击方.标记, 0)
            .如果真结束
            
        .如果真结束
        c = 0
        .计次循环首 (b, )  ' 使魔：战斗女仆的技能
            a1 = 取随机数 (1, 4)
            .判断开始 (a1 == 1)
                c = 1
                特效 = 特效 + 加括号 (“RPG!”)
                额外加成.溅射 = 额外加成.溅射 + 25 + 攻击方.技能等级
                额外加成.溅射2 = 额外加成.溅射2 + 1
                a = a + 1
                溅射必中 = 真
            .判断 (a1 == 2)
                c = 1
                特效 = 特效 + 加括号 (“机枪”)
                额外加成.命中 = 额外加成.命中 * (1.15 + 攻击方.技能等级 / 100)
                额外攻击次数 = 额外攻击次数 + 1
                a = a + 1
            .判断 (a1 == 3)
                特效 = 特效 + 加括号 (“震撼弹”)
                增加穿透 (额外加成, 5)
            .判断 (a1 == 4)
                特效 = 特效 + 加括号 (“云爆弹”)
                全体攻击 = 真
                a2 = 伤害倍率 / 取数组成员数 (防御方)
                额外加成.攻击 = 额外加成.攻击 * (1.33 + 攻击方.技能等级 / 100)
            .默认
                
            .判断结束
            
        .计次循环尾 ()
        .判断开始 (c == 1)
            全体攻击 = 假
        .默认
            .如果真 (a2 != 0)
                伤害倍率 = a2
            .如果真结束
            
        .判断结束
        
    .判断 (攻击方.特殊序号 == #恶毒)
        .如果真 (全体攻击)
            .如果真 (攻击方.好感 >= 60)
                全体攻击 = 假
                额外加成.溅射2 = 额外加成.溅射2 + 1
                额外加成.攻击 = 额外加成.攻击 * (1.15 + 攻击方.技能等级 / 200)
