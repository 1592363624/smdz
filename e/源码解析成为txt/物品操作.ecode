b = 到整数 (取数字 (对象))
循环次数 = b
对象 = 去数字 (对象)
等级 = 取成就熟练度 (玩家.标记, “增幅器等级”, , )
.判断开始 (装备要求 (玩家, #增幅器, , ) == 假)
    w = 玩家.名称 + “你身上未装备增幅器”
.判断 (b == 0)
    w = 玩家.名称 + 加引号 (“强化增幅器3”) + “来随机强化3次，” + 加引号 (“强化增幅器攻击3”) + “来消耗传说强化券来强化3次攻击”
.默认
    .判断开始 (对象 == “生命”)
        a3 = 1
    .判断 (对象 == “装甲”)
        a3 = 1
    .判断 (对象 == “护盾”)
        a3 = 1
    .判断 (对象 == “攻击”)
        a3 = 1
    .判断 (对象 == “速度”)
        a3 = 1
    .判断 (对象 == “闪避”)
        a3 = 1
    .判断 (对象 == “命中”)
        a3 = 1
    .判断 (对象 == “生命恢复”)
        a3 = 1
    .判断 (对象 == “装甲修复”)
        a3 = 1
    .判断 (对象 == “护盾回复”)
        a3 = 1
    .判断 (对象 == “电攻”)
        a3 = 1
    .判断 (对象 == “火攻”)
        a3 = 1
    .判断 (对象 == “物攻”)
        a3 = 1
    .判断 (对象 == “冰攻”)
        a3 = 1
    .判断 (对象 == “”)
        a3 = 1
    .默认
        
    .判断结束
    .判断开始 (a3 != 1)
        w = 玩家.名称 + “,” + 对象 + “不是可以强化的增幅器属性”
    .默认
        强化材料 = 取物品数量 (“能量块”, 玩家.背包, )
        强化券 = 取物品数量 (“传说强化券”, 玩家.背包, )
        物品.类型 = “资源”
        物品.数量 = 1
        .计次循环首 (循环次数, )
            .判断开始 (强化材料 > 等级)
                已用材料 = 已用材料 + 等级
                强化材料 = 强化材料 - 等级
                已强化 = 已强化 + 1  ' 强化次数
                等级 = 等级 + 1
                .判断开始 (对象 == “”)  ' 随机强化
                    物品.名称 = 随机文本 (“生命,装甲,护盾,攻击,速度,闪避,命中,生命恢复,装甲修复,护盾回复,电攻,冰攻,火攻,攻击,物攻”)
                    获得物品 (物品数组, 物品, , )
                .默认
                    .判断开始 (强化券 >= 1)
                        强化券 = 强化券 - 1  ' 已用强化券
                        物品.名称 = 对象
                        获得物品 (物品数组, 物品, , )
                    .默认
                        w4 = “传说强化券不足”
                        跳出循环 ()
                    .判断结束
                    
                .判断结束
                
            .默认
                w4 = “能量块不足”
                跳出循环 ()
            .判断结束
            
        .计次循环尾 ()
        寻找装备 (玩家.装备, “增幅器”, 下标)
        z1 = 玩家.装备[下标]
        物品.名称 = “能量块”
        物品.数量 = -已用材料
        获得物品 (玩家.背包, 物品, , )
        .判断开始 (对象 == “”)
            w = 玩家.名称 + “使用” + 到文本 (已用材料) + “块能量块强化了” + 到文本 (已强化) + “次增幅器：#换行” + 显示物品 (物品数组, , , , , , , )
        .默认
            w = 玩家.名称 + “使用” + 到文本 (已用材料) + “块能量块和” + 到文本 (已强化) + “张传说强化券强化了” + 到文本 (已强化) + “次增幅器：#换行” + 显示物品 (物品数组, , , , , , , )
            物品.名称 = “传说强化券”
            物品.数量 = -已强化
            获得物品 (玩家.背包, 物品, , )
        .判断结束
        .计次循环首 (取数组成员数 (物品数组), a)
            对象 = 物品数组[a].名称
            .判断开始 (对象 == “生命”)
                z1.加成.生命2 = z1.加成.生命2 + 物品数组[a].数量
            .判断 (对象 == “装甲”)
                z1.加成.装甲2 = z1.加成.装甲2 + 物品数组[a].数量
            .判断 (对象 == “护盾”)
                z1.加成.护盾2 = z1.加成.护盾2 + 物品数组[a].数量
            .判断 (对象 == “攻击”)
                z1.加成.攻击2 = z1.加成.攻击2 + 物品数组[a].数量
            .判断 (对象 == “速度”)
                z1.加成.速度2 = z1.加成.速度2 + 物品数组[a].数量
            .判断 (对象 == “闪避”)
                z1.加成.闪避2 = z1.加成.闪避2 + 物品数组[a].数量
            .判断 (对象 == “命中”)
                z1.加成.命中2 = z1.加成.命中2 + 物品数组[a].数量
            .判断 (对象 == “生命恢复”)
                z1.加成.生命回复2 = z1.加成.生命回复2 + 物品数组[a].数量
            .判断 (对象 == “装甲修复”)
                z1.加成.装甲回复2 = z1.加成.装甲回复2 + 物品数组[a].数量
            .判断 (对象 == “护盾回复”)
                z1.加成.护盾回复2 = z1.加成.护盾回复2 + 物品数组[a].数量
            .判断 (对象 == “电攻”)
                z1.加成.电伤2 = z1.加成.电伤2 + 物品数组[a].数量
            .判断 (对象 == “火攻”)
                z1.加成.火伤2 = z1.加成.火伤2 + 物品数组[a].数量
            .判断 (对象 == “物攻”)
                z1.加成.物伤2 = z1.加成.物伤2 + 物品数组[a].数量
            .判断 (对象 == “冰攻”)
                z1.加成.冰伤2 = z1.加成.冰伤2 + 物品数组[a].数量
            .默认
                
            .判断结束
            
        .计次循环尾 ()
        w = 子文本替换 (w, “x”, “+”, , , 真) + #换行符 + w4
        玩家.装备[下标] = z1
        玩家.装备[下标].数据 = “s!” + z1.制造者 + 加成转数据 (玩家.装备[下标].加成) + “!bx” + 到文本 (玩家.装备[下标].特效)
        添加成就 (“增幅器等级”, 已强化, 玩家.标记, 玩家.任务)
        添加成就 (“强化增幅器”, 已强化, 玩家.成就, 玩家.任务)
    .判断结束
    
.判断结束
返回 (w)
.子程序 制造, 逻辑型, , 制造失败返回假
.参数 玩家, 玩家, 参考
.参数 名称, 文本型, , 需要制造的物品名称
.参数 数量, 整数型, 可空, 需要制造的数量，输入小于1则显示制造需求
.参数 返回文本, 文本型, 参考 可空, 返回显示的文本
.局部变量 b, 整数型
.局部变量 c, 整数型
.局部变量 返回, 文本型
.局部变量 返回逻辑, 逻辑型
.局部变量 d, 整数型
.局部变量 物品, 物品3
.局部变量 物品数组, 物品3, , "0"
.局部变量 是否装备, 逻辑型
.局部变量 e, 整数型
.局部变量 f, 整数型
.局部变量 g1, 整数型
.局部变量 g2, 整数型
.局部变量 g3, 整数型
.局部变量 文本1, 文本型
.局部变量 文本2, 文本型

.计次循环首 (取数组成员数 (制造列表), b)
    .如果真 (制造列表[b].名称 == 名称)
        c = b
        跳出循环 ()
    .如果真结束
    
.计次循环尾 ()
.判断开始 (c == 0)
    返回 = 玩家.名称 + “,【” + 名称 + “】在制造列表不存在。”
.判断 (制造列表[c].不可制造)
    返回 = “你输入了正确的名称，但是【” + 名称 + “】不是可以制造的项目(它只是用来分解用的)，你也许想：” + 临时输入替换 (玩家.QQ, “1@制造” + 名称 + “a”, )
.判断 (取数组成员数 (制造列表[c].产出) < 1)
    返回 = “！！警告：制造项目” + 制造列表[c].名称 + “的制造产出为空，请检查文件”
.判断 (数量 < 1)  ' 没输入要制造的数量，显示制造公式
    返回 = 玩家.名称 + “,” + 名称 + 加括号 (“等级需求” + 到文本 (制造列表[c].等级)) + #换行符 + 制造列表[c].说明
    返回 = 返回 + “#换行制造需求:” + 显示物品 (制造列表[c].需求, , , , , 真, , )
    返回 = 返回 + “#换行产出:” + 显示物品 (制造列表[c].产出, , , , , , , ) + “#换行1、制造1个#z9#z92、查看产物详情”
