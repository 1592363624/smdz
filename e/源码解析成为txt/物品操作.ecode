                        背包[a].数量 = 背包[a].数量 + 物品.数量
                        .如果真 (允许负数 == 假)
                            .如果真 (背包[a].数量 <= 0)
                                删除成员 (背包, a, )
                            .如果真结束
                            
                        .如果真结束
                        返回 ()
                    .如果真结束
                    
                .否则
                    背包[a].数量 = 背包[a].数量 + 物品.数量
                    .如果真 (允许负数 == 假)
                        .如果真 (背包[a].数量 <= 0)
                            删除成员 (背包, a, )
                        .如果真结束
                        
                    .如果真结束
                    返回 ()
                .如果结束
                
            .如果真结束
            
        .计次循环尾 ()
        .判断开始 (允许负数 == 假)
            .如果真 (物品.数量 > 0)
                加入成员 (背包, 物品)
            .如果真结束
            
        .默认
            加入成员 (背包, 物品)
        .判断结束
        
