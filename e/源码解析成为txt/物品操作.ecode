        .计次循环尾 ()
    .如果真结束
    产出 = 物品数组
    消耗 = 物品数组2
.如果真结束
.计次循环首 (取数组成员数 (载具.配方), a)
    a1 = 0  ' 每个配方都要重置
    .判断开始 (a == 1)  ' 载具的第一个配方用来保存读取时间了
        
    .默认
        配方 = 取配方 (载具.配方[a].名称)
        .如果真 (取数组成员数 (配方.产出) > 0)
            .计次循环首 (取数组成员数 (配方.消耗), b)
                a2 = 取物品数量 (配方.消耗[b].名称, 载具.零件, ) / (a3[2] * 配方.消耗[b].数量 * 载具.配方[a].数值 * a3[4] * a3[5])  ' 根据生产力(zj.pf[a].sz)计算最多可以支持多长时间的生产
                .判断开始 (a1 != 0)
                    .如果真 (a1 > a2)  ' 这个被消耗的物品所可以提供的生产时间更短(这个东西不足)，单位分钟
                        a1 = a2
                    .如果真结束
                    
                .默认
                    a1 = a2
                .判断结束
                
            .计次循环尾 ()
            .计次循环首 (取数组成员数 (配方.产出), b)
                a2 = 取物品数量 (“生产限制” + 配方.产出[b].名称, 载具.零件, )
                .如果真 (a2 > 0)  ' 如果存在产出限制
                    .如果 (配方.产出[b].耐久 < 100)  ' 耐久小于100的是副产物，受a3[1]的加成  a3: 1副产物加成 2配方消耗减少 3可生产时间 4生产速率 5生产效率
                        产出数量 = 配方.产出[b].数量 * 配方.产出[b].耐久 / 100 * a3[1] * 载具.配方[a].数值 * a3[4] * a3[5]
                    .否则
                        产出数量 = 配方.产出[b].数量 * 载具.配方[a].数值 * a3[4] * a3[5]
                    .如果结束
                    a2 = (a2 - 取物品数量 (配方.产出[b].名称, 载具.零件, )) / 产出数量  ' 计算减去载具内已经有的数量，还可以生产多少时间达到限制数量
                    .如果真 (a1 > a2)
                        a1 = a2
                    .如果真结束
                    
                .如果真结束
                
            .计次循环尾 ()
            ' 根据计算所得最低生产时间，进行生产
            a2 = a1 * 60 * #转秒
            .如果真 (a3[3] < a1 * 60 * #转秒)  ' 距离上一次读取的时间比可以生产的时间短
                a1 = a3[3] / #转秒 / 60  ' 经过了多少分钟
            .如果真结束
            .如果真 (a1 > 0)
                重定义数组 (物品数组, 假, 0)
                .计次循环首 (取数组成员数 (配方.产出), b)  ' 计算产出
                    物品.名称 = 配方.产出[b].名称
                    .如果 (配方.产出[b].耐久 < 100)  ' 耐久小于100的是副产物，受a3[1]的加成
                        物品.数量 = a1 * 配方.产出[b].数量 * 配方.产出[b].耐久 / 100 * a3[1] * 载具.配方[a].数值 * a3[4] * a3[5]
                    .否则
                        物品.数量 = a1 * 配方.产出[b].数量 * 载具.配方[a].数值 * a3[4] * a3[5]
                    .如果结束
                    获得物品 (物品数组, 物品, )
                .计次循环尾 ()
                .计次循环首 (取数组成员数 (物品数组), b)
                    获得物品 (载具.零件, 物品数组[b], )
                    添加成就 (“生产” + 物品数组[b].名称, 物品数组[b].数量, , 玩家任务)
                    添加成就 (“生产”, 物品数组[b].数量, 玩家成就, 玩家任务)
                .计次循环尾 ()
                重定义数组 (物品数组, 假, 0)
                .计次循环首 (取数组成员数 (配方.消耗), b)  ' 计算消耗
                    物品.名称 = 配方.消耗[b].名称
                    物品.数量 = -a1 * 配方.消耗[b].数量 * a3[2] * 配方.消耗[b].耐久 / 100 * 载具.配方[a].数值 * a3[4] * a3[5]
                    获得物品 (物品数组, 物品, 真)
                .计次循环尾 ()
                .计次循环首 (取数组成员数 (物品数组), b)
                    获得物品 (载具.零件, 物品数组[b], )
                .计次循环尾 ()
            .如果真结束
            
        .如果真结束
        
    .判断结束
    
.计次循环尾 ()
a2 = 0
.计次循环首 (取数组成员数 (综合产出), a)
    .判断开始 (综合产出[a].数量 < 0)
        a1 = 取物品数量 (综合产出[a].名称, 载具.零件, ) / -综合产出[a].数量 * 60  ' 最短生产多少秒
        
        
    .判断 (综合产出[a].数量 >= 0)
        a1 = 86400.12345678
    .默认
        
    .判断结束
    .如果 (a2 == 0)
        a2 = a1
    .否则
        .如果真 (a2 > a1)
            a2 = a1
        .如果真结束
        
    .如果结束
    
.计次循环尾 ()
可生产时间 = a2
