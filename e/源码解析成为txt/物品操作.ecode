.计次循环首 (取数组成员数 (载具.配方), a)
    .判断开始 (a == 1)  ' 载具的第一个配方用来保存读取时间了
        
    .默认
        配方 = 取配方 (载具.配方[a].名称)
        a1 = a1 + 载具.配方[a].数值
        .如果真 (取每分钟产出)  ' 返回给显示用
            .计次循环首 (取数组成员数 (配方.产出), b)  ' 计算产出
                物品.名称 = 配方.产出[b].名称
                .如果 (配方.产出[b].耐久 < 100)  ' 耐久小于100的是副产物，受a3[1]的加成
                    物品.数量 = 配方.产出[b].数量 * 配方.产出[b].耐久 / 100 * a3[1] * 载具.配方[a].数值 * a3[4]
                .否则
                    物品.数量 = 配方.产出[b].数量 * 载具.配方[a].数值 * a3[4]
                .如果结束
                获得物品 (物品数组, 物品, )
                获得物品 (综合产出, 物品, 真, )
            .计次循环尾 ()
            .计次循环首 (取数组成员数 (配方.消耗), b)  ' 计算消耗
                物品.名称 = 配方.消耗[b].名称
                物品.数量 = 配方.消耗[b].数量 * a3[2] * 配方.消耗[b].耐久 / 100 * 载具.配方[a].数值 * a3[4]
                获得物品 (物品数组2, 物品, )
                物品.数量 = -物品.数量
                获得物品 (综合产出, 物品, 真, )
            .计次循环尾 ()
        .如果真结束
        
    .判断结束
    
.计次循环尾 ()
消耗的生产力 = a1
