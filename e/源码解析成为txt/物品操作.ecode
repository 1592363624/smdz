.程序集 物品操作, , , 装备、物品和载具

.子程序 计算价值, 双精度小数型
.参数 物品数组, 物品3, 参考 数组
.局部变量 b, 整数型
.局部变量 d, 整数型
.局部变量 c, 整数型
.局部变量 z1, 装备
.局部变量 价值, 双精度小数型
.局部变量 w, 文本型

.计次循环首 (取数组成员数 (物品数组), b)
    d = 0
    .计次循环首 (取数组成员数 (物品列表), c)
        .如果真 (物品列表[c].名称 == 物品数组[b].名称)
            d = c
            跳出循环 ()
        .如果真结束
        
    .计次循环尾 ()
    .判断开始 (d == 0)
        .如果 (物品数组[b].类型 == “装备”)
            z1 = 解析装备 (物品数组[b])
            .如果真 (z1.特效 != 0)
                价值 = 价值 + 100
            .如果真结束
            w = 显示品质 (z1, 真, )
            .判断开始 (w == “普通”)
                价值 = 价值 + 15
            .判断 (w == “良好”)
                价值 = 价值 + 25
            .判断 (w == “优秀”)
                价值 = 价值 + 40
            .判断 (w == “精良”)
                价值 = 价值 + 70
            .判断 (w == “史诗”)
                价值 = 价值 + 120
            .判断 (w == “传说”)
                价值 = 价值 + 200
            .默认
                价值 = 价值 + 10000
            .判断结束
            .如果真 (z1.特殊序号 != 0)
                价值 = 价值 + 1000
            .如果真结束
            
        .否则
            价值 = 价值 + 5 * 物品数组[b].数量
        .如果结束
        
    .默认
        价值 = 价值 + 物品列表[c].价值 * 物品数组[b].数量
    .判断结束
    
.计次循环尾 ()
返回 (价值)
.子程序 强化植入体, 文本型
.参数 玩家, 玩家, 参考
.参数 对象, 文本型
.局部变量 b, 长整数型
.局部变量 等级, 长整数型
.局部变量 w, 文本型
.局部变量 a1, 双精度小数型
.局部变量 a2, 双精度小数型
.局部变量 a3, 双精度小数型
.局部变量 强化材料, 双精度小数型
.局部变量 强化券, 双精度小数型
.局部变量 物品, 物品3
.局部变量 循环次数, 整数型
.局部变量 已用材料, 长整数型
.局部变量 已强化
.局部变量 w4, 文本型
.局部变量 a
.局部变量 z1, 装备
.局部变量 物品数组, 物品3, , "0"
.局部变量 下标

b = 到整数 (取数字 (对象))
循环次数 = b
对象 = 去数字 (对象)
等级 = 取成就熟练度 (玩家.标记, “植入体等级”, , )
.判断开始 (装备要求 (玩家, #植入体, , ) == 假)
    w = 玩家.名称 + “你身上未装备植入体”
.判断 (b == 0)
    w = 玩家.名称 + 加引号 (“强化植入体3”) + “来随机强化3次，” + 加引号 (“强化植入体攻击3”) + “来消耗史诗强化券来强化3次攻击”
.默认
    .判断开始 (对象 == “生命”)
        a3 = 1
    .判断 (对象 == “装甲”)
        a3 = 1
    .判断 (对象 == “护盾”)
        a3 = 1
    .判断 (对象 == “攻击”)
        a3 = 1
    .判断 (对象 == “速度”)
        a3 = 1
    .判断 (对象 == “闪避”)
        a3 = 1
    .判断 (对象 == “命中”)
        a3 = 1
    .判断 (对象 == “生命恢复”)
        a3 = 1
    .判断 (对象 == “装甲修复”)
        a3 = 1
    .判断 (对象 == “护盾回复”)
        a3 = 1
    .判断 (对象 == “电攻”)
        a3 = 1
    .判断 (对象 == “火攻”)
        a3 = 1
    .判断 (对象 == “物攻”)
        a3 = 1
    .判断 (对象 == “冰攻”)
        a3 = 1
    .判断 (对象 == “”)
        a3 = 1
    .默认
        
    .判断结束
    .判断开始 (a3 != 1)
        w = 玩家.名称 + “,” + 对象 + “不是可以强化的植入体属性”
    .默认
        强化材料 = 取物品数量 (“水晶”, 玩家.背包, )
        强化券 = 取物品数量 (“史诗强化券”, 玩家.背包, )
        物品.类型 = “资源”
        物品.数量 = 1
        .计次循环首 (循环次数, )
            .判断开始 (强化材料 > 等级)
                已用材料 = 已用材料 + 等级
                强化材料 = 强化材料 - 等级
                已强化 = 已强化 + 1  ' 强化次数
                等级 = 等级 + 1
                .判断开始 (对象 == “”)  ' 随机强化
                    物品.名称 = 随机文本 (“生命,装甲,护盾,攻击,速度,闪避,命中,生命恢复,装甲修复,护盾回复,电攻,物攻,冰攻,火攻,攻击”)
                    获得物品 (物品数组, 物品, , )
                .默认
                    .判断开始 (强化券 >= 1)
                        强化券 = 强化券 - 1  ' 已用强化券
                        物品.名称 = 对象
                        获得物品 (物品数组, 物品, , )
                    .默认
                        w4 = “史诗强化券不足”
                        跳出循环 ()
                    .判断结束
                    
                .判断结束
                
            .默认
                w4 = “水晶不足”
                跳出循环 ()
            .判断结束
            
        .计次循环尾 ()
        寻找装备 (玩家.装备, “植入体”, 下标)
        z1 = 玩家.装备[下标]
        物品.名称 = “水晶”
        物品.数量 = -已用材料
        获得物品 (玩家.背包, 物品, , )
        .判断开始 (对象 == “”)
            w = 玩家.名称 + “使用” + 到文本 (已用材料) + “块水晶强化了” + 到文本 (已强化) + “次植入体：#换行” + 显示物品 (物品数组, , , , , , , )
        .默认
            w = 玩家.名称 + “使用” + 到文本 (已用材料) + “块水晶和” + 到文本 (已强化) + “张史诗强化券强化了” + 到文本 (已强化) + “次植入体：#换行” + 显示物品 (物品数组, , , , , , , )
            物品.名称 = “史诗强化券”
            物品.数量 = -已强化
            获得物品 (玩家.背包, 物品, , )
        .判断结束
        .计次循环首 (取数组成员数 (物品数组), a)
            对象 = 物品数组[a].名称
            .判断开始 (对象 == “生命”)
                z1.加成.生命 = z1.加成.生命 + 物品数组[a].数量
            .判断 (对象 == “装甲”)
                z1.加成.装甲 = z1.加成.装甲 + 物品数组[a].数量
            .判断 (对象 == “护盾”)
                z1.加成.护盾 = z1.加成.护盾 + 物品数组[a].数量
            .判断 (对象 == “攻击”)
                z1.加成.攻击 = z1.加成.攻击 + 物品数组[a].数量
            .判断 (对象 == “速度”)
                z1.加成.速度 = z1.加成.速度 + 物品数组[a].数量
            .判断 (对象 == “闪避”)
                z1.加成.闪避 = z1.加成.闪避 + 物品数组[a].数量
            .判断 (对象 == “命中”)
                z1.加成.命中 = z1.加成.命中 + 物品数组[a].数量
            .判断 (对象 == “生命恢复”)
                z1.加成.生命回复 = z1.加成.生命回复 + 物品数组[a].数量
            .判断 (对象 == “装甲修复”)
                z1.加成.装甲回复 = z1.加成.装甲回复 + 物品数组[a].数量
            .判断 (对象 == “护盾回复”)
                z1.加成.护盾回复 = z1.加成.护盾回复 + 物品数组[a].数量
            .判断 (对象 == “电攻”)
                z1.加成.电伤 = z1.加成.电伤 + 物品数组[a].数量
            .判断 (对象 == “火攻”)
                z1.加成.火伤 = z1.加成.火伤 + 物品数组[a].数量
            .判断 (对象 == “物攻”)
                z1.加成.物伤 = z1.加成.物伤 + 物品数组[a].数量
            .判断 (对象 == “冰攻”)
                z1.加成.冰伤 = z1.加成.冰伤 + 物品数组[a].数量
            .默认
                
            .判断结束
            
        .计次循环尾 ()
        w = 子文本替换 (w, “x”, “+”, , , 真) + #换行符 + w4
        玩家.装备[下标] = z1
        玩家.装备[下标].数据 = “s!” + z1.制造者 + 加成转数据 (玩家.装备[下标].加成) + “!bx” + 到文本 (玩家.装备[下标].特效)
        添加成就 (“植入体等级”, 已强化, 玩家.标记, 玩家.任务)
        添加成就 (“强化植入体”, 已强化, 玩家.成就, 玩家.任务)
    .判断结束
    
.判断结束
返回 (w)
.子程序 强化增幅器, 文本型
.参数 玩家, 玩家, 参考
