.局部变量 物品数组, 物品3, , "0"

取生产产出 (载具, s, , , 真, , , 玩家.成就, 玩家.任务, 文本, 取咏星加成 (载具, 玩家.地图))
文本数组 = 分割文本 (文本, “!”, )
.判断开始 (取数组成员数 (文本数组) == 4)
    生产速率 = 到数值 (文本数组[1]) / 100 + 1
    副产物 = 到数值 (文本数组[2]) / 100 + 1
    消耗降低 = 到数值 (文本数组[3]) / 100
    产出效率 = 到数值 (文本数组[4]) / 100
    配方 = 取配方 (载具.配方[配方数组下标].名称)
    分配的生产力 = 载具.配方[配方数组下标].数值
    返回文本 = 载具.名称 + “#换行配方” + 配方.名称 + “x” + 文本四舍 (分配的生产力)
    返回文本 = 返回文本 + “#换行生产速率” + 文本四舍 (生产速率 * 100) + “%#z9副产物” + 到文本 (副产物 * 100) + “%”
    返回文本 = 返回文本 + “#换行消耗降低” + 到文本 (消耗降低 * 100) + “%#z9效率” + 到文本 (产出效率 * 100) + “%”
    .如果真 (取数组成员数 (配方.消耗) == 0)
        返回文本 = 返回文本 + “#换行这个配方没有消耗”
    .如果真结束
    .计次循环首 (取数组成员数 (配方.消耗), a)
        消耗数量 = 配方.消耗[a].数量 * (1 - 消耗降低) * 配方.消耗[a].耐久 / 100 * 分配的生产力 * 产出效率 * 生产速率
        返回文本 = 返回文本 + “#换行消耗:” + 配方.消耗[a].名称 + “x” + 文本四舍 (消耗数量)
        文本 = “”
        .计次循环首 (取数组成员数 (载具.配方), b)
            .如果真 (b == 1)  ' 配方1存时间了
                到循环尾 ()
            .如果真结束
            .如果真 (b == 配方数组下标)  ' 忽略自己
                到循环尾 ()
            .如果真结束
            配方2 = 取配方 (载具.配方[b].名称)
            重定义数组 (物品数组, 假, 0)
            .计次循环首 (取数组成员数 (配方2.产出), c)
                .如果真 (配方2.产出[c].名称 == 配方.消耗[a].名称)
                    物品.名称 = 配方2.产出[c].名称
                    .如果 (配方2.产出[c].耐久 < 100)  ' 小于100是副产物
                        物品.数量 = 配方2.产出[c].数量 * 配方2.产出[c].耐久 / 100 * 副产物 * 产出效率 * 生产速率
                    .否则
                        物品.数量 = 配方2.产出[c].数量 * 产出效率 * 生产速率
                    .如果结束
                    获得物品 (物品数组, 物品, , )
                .如果真结束
                
            .计次循环尾 ()
            .如果真 (取数组成员数 (物品数组) > 0)
                文本 = 文本 + “#换行  配方:” + 配方2.名称 + “,产出” + 文本四舍 (物品数组[1].数量)
                载具.配方[b].数值 = 消耗数量 / 物品数组[1].数量
                文本 = 文本 + “#换行  生产力调整为” + 文本四舍 (载具.配方[b].数值)
            .如果真结束
            
        .计次循环尾 ()
        .如果 (文本 == “”)
            返回文本 = 返回文本 + “#换行  没有其他产出” + 配方.消耗[a].名称 + “的配方”
        .否则
            返回文本 = 返回文本 + 文本
        .如果结束
        
    .计次循环尾 ()
.默认
    返回文本 = “##错误：取生产产出函数返回的 生产显示项目 数组成员数量不为4”
.判断结束

