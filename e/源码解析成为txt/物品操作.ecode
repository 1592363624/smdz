.判断开始 (玩家.背包[a].类型 != “装备”)
    资源 = 取建筑 (玩家.背包[a].名称)
    .判断开始 (资源.名称 == “”)
        是否部件 (玩家.背包[a].名称, d)
    .默认
        d = -1
    .判断结束
    .判断开始 (d == 0)
        w = 玩家.背包[a].名称 + “不是装备,也不是建筑或载具部件”
    .默认
        .计次循环首 (取数组成员数 (制造列表), b)
            .如果真 (制造列表[b].名称 == 玩家.背包[a].名称)
                .如果真 (制造列表[b].不可制造 == 假)
                    a3 = 1  ' 不给刷材料
                .如果真结束
                c = b
                跳出循环 ()
            .如果真结束
            
        .计次循环尾 ()
        .判断开始 (c == 0)
            w = 玩家.背包[a].名称 + “还无法分解”
        .默认
            物品.类型 = “资源”
            .计次循环首 (取数组成员数 (制造列表[c].需求), b)
                .如果真 (a3 >= 1.12)
                    a3 = 取随机数 (1120, 1150) / 1000
                .如果真结束
                物品.名称 = 制造列表[c].需求[b].名称
                物品.数量 = 制造列表[c].需求[b].数量 * 玩家.背包[a].数量 * a3
                获得物品 (玩家.背包, 物品)
                获得物品 (物品数组, 物品)
            .计次循环尾 ()
            文本 = 文本 + “#换行分解了” + 到文本 (玩家.背包[a].数量) + “的” + 玩家.背包[a].名称
            删除成员 (玩家.背包, a, )
            .如果真 (a3 != 1)
                文本 = 文本 + 加括号 (“+” + 文本四舍 ((a3 - 1) * 100) + “%”)
            .如果真结束
            
        .判断结束
        
    .判断结束
    
.默认
    .判断开始 (取文本左边 (玩家.背包[a].名称, 6) == “植入体” || 取文本左边 (玩家.背包[a].名称, 6) == “增幅器”)
        w = “这个不是可以被分解的装备”
    .判断 (玩家.背包[a].耐久 != 0)
        w = “不能分解被锁定的装备#换行1、解锁”
        临时输入替换 (玩家.QQ, “1@解锁” + 到文本 (a))
    .默认
        取分解价值 (玩家.背包[a], a1, a2)
        w = 玩家.名称 + “分解了” + 玩家.背包[a].名称 + 加中括号 (显示品质 (解析装备 (玩家.背包[a]))) + “#换行得到了” + 文本四舍 (a1 * a3) + “水晶和” + 文本四舍 (a2 * a3) + “能量块”
        物品.类型 = “资源”
        物品.名称 = “水晶”
        物品.数量 = a1 * a3
        获得物品 (玩家.背包, 物品)
        物品.数量 = a2 * a3
        物品.名称 = “能量块”
        获得物品 (玩家.背包, 物品)
        添加成就 (“分解”, 1, 玩家.成就, 玩家.任务)
        活跃度 (玩家, 1)
        删除成员 (玩家.背包, a, )
    .判断结束
    
.判断结束
返回 (w + 文本)
