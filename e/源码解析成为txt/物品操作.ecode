.局部变量 w4, 文本型
.局部变量 w3, 文本型
.局部变量 a
.局部变量 b
.局部变量 c
.局部变量 d
.局部变量 e
.局部变量 物品数组, 物品3, , "0"
.局部变量 z1, 装备
.局部变量 物品, 物品3
.局部变量 地图, 地图
.局部变量 s, 长整数型
.局部变量 整数数组, 整数型, , "0"
.局部变量 文本数组, 文本型, , "0"

s = 时间_取现行时间 ()
.判断开始 (操作类型 == 1)  ' #背包搜索#保险柜搜索
    .如果 (背包名称 == “背包”)
        w2 = 取关键词 (消息数据, “文本长度”, )
    .否则
        w2 = 取关键词 (消息数据, “文本长度啊”, )
    .如果结束
    wa = 分割文本 (w2, “ ”, )
    .判断开始 (w2 == “”)
        w = 玩家.名称 + 加引号 (背包名称 + “搜索武器”) + “来包含词键词的物品，关键词从物品的名称、描述、品质、类型(武器/装备/资源)、装备位置(头部/饰品…)、已锁定/未锁定、特效、属性加成(攻击/生命/命中…)中检索#换行可以输入多个关键词进行更精确的搜索，每个关键词之间用空格隔开”
    .默认
        .计次循环首 (取数组成员数 (背包), a)
            w3 = “”
            .判断开始 (背包[a].类型 == “装备”)
                z1 = 解析装备 (背包[a])
                .判断开始 (是否武器 (z1.特殊序号, z1.类型))
                    w3 = “武器” + z1.类型 + 显示品质 (z1) + z1.名称
                .默认
                    w3 = “装备” + z1.类型 + 显示品质 (z1) + z1.名称
                .判断结束
                .如果真 (z1.特效 != 0)
                    w3 = w3 + “特效”
                .如果真结束
                .如果 (z1.耐久 == 1)
                    w3 = w3 + “已锁定”
                .否则
                    w3 = w3 + “未锁定”
                .如果结束
                w3 = w3 + 显示加成 (z1.自带, , ) + z1.说明文本
            .默认
                w3 = “资源” + 背包[a].名称
            .判断结束
            c = 取数组成员数 (wa)
            d = 0
            .计次循环首 (c, b)
                .如果真 (寻找文本 (w3, wa[b], , 假) != -1)
                    d = d + 1
                    .如果真 (d >= c)
                        物品 = 背包[a]
                        物品.耐久 = a
                        加入成员 (物品数组, 物品)
                        e = e + 1
                        w3 = “”
                        .如果真 (e > 50)
                            w = “#换行结果过多，只显示前50个结果。你可以使用空格分割多个关键词来进行更为精准的搜索”
                            跳出循环 ()
                        .如果真结束
                        
                    .如果真结束
                    
                .如果真结束
                
            .计次循环尾 ()
            .如果真 (e > 50)
                跳出循环 ()
            .如果真结束
            
        .计次循环尾 ()
        w3 = “”
        .计次循环首 (取数组成员数 (物品数组), a)
            .判断开始 (物品数组[a].类型 == “装备”)
                w3 = w3 + #换行符 + 到文本 (物品数组[a].耐久) + “、” + 物品数组[a].名称 + 加括号 (显示品质 (解析装备 (物品数组[a]), , ))
            .默认
                w3 = w3 + #换行符 + 到文本 (物品数组[a].耐久) + “、” + 物品数组[a].名称 + “x” + 文本四舍 (物品数组[a].数量)
            .判断结束
            w4 = w4 + “#” + 到文本 (物品数组[a].耐久) + “@查看” + 背包名称 + 到文本 (物品数组[a].耐久)
        .计次循环尾 ()
        .判断开始 (w4 == “”)
            w = 玩家.名称 + “你的” + 背包名称 + “没有关键词包含” + 加引号 (w2) + “的物品”
        .默认
            w = 玩家.名称 + “结果:” + w3 + w
            临时输入替换 (玩家.QQ, w4)
        .判断结束
        
    .判断结束
    
.判断 (操作类型 == 2)  ' #查看背包#查看保险柜
    .如果 (背包名称 == “背包”)
        w2 = 取关键词 (消息数据, “文本长度”, )
    .否则
        w2 = 取关键词 (消息数据, “文本长度啊”, )
    .如果结束
    a = 到整数 (w2)
    .判断开始 (去数字 (w2) == “”)  ' 只输入了数字
        .判断开始 (a < 1 || a > 取数组成员数 (背包))
            .如果 (背包名称 == “保险柜”)
                w = 玩家.名称 + “你的” + 背包名称 + “有:#换行” + 显示物品 (背包, 真, , , , 真, , )
            .否则
                w = 玩家.名称 + “你的” + 背包名称 + “有:#换行” + 显示物品 (背包, , 真, 真, , , , )
            .如果结束
            .如果真 (背包名称 == “背包”)
                w = w + 新手指引 (“查看背包”, 玩家.标记) + “#换行1、资源背包#z9#z92、背包操作”
                临时输入替换 (玩家.QQ, “1@资源背包#2@背包操作”)
