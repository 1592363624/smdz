                    跳出循环 ()
                .如果结束
                
            .计次循环尾 ()
            已有词条 = 已有词条 + “1” + z.词条[a] + “1”
        .否则
            已有词条 = 已有词条 + “1” + z.词条[a] + “1”
        .如果结束
        词条转换 (z, z.词条[a], 词条倍率, 品质下限 * 100, 品质上限 * 100)
    .计次循环尾 ()
    物品.名称 = z.名称
    物品.类型 = “装备”
    .如果真 (不生成特效 == 假)
        .判断开始 (是否武器 (z.特殊序号, z.类型))
            .判断开始 (z.必出特效)
                z.特效 = 取随机数 (1, 取数组成员数 (武器特效))
            .默认
                .如果真 (几率判断 (15))
                    z.特效 = 取随机数 (1, 取数组成员数 (武器特效))
                .如果真结束
                
            .判断结束
            
        .默认
            .判断开始 (z.必出特效)
                z.特效 = 取随机数 (1, 取数组成员数 (装备特效))
            .默认
                .如果真 (几率判断 (15))
                    z.特效 = 取随机数 (1, 取数组成员数 (装备特效))
                .如果真结束
                
            .判断结束
            
        .判断结束
        
    .如果真结束
    .如果 (取文本左边 (加成文本, 2) == “@@”)
        物品.数据 = 品质 + “!” + 加成文本 + 加成转数据 (z.加成) + “!bx” + 到文本 (z.特效)
    .否则
        物品.数据 = 品质 + 加成转数据 (z.加成) + “!bx” + 到文本 (z.特效)
    .如果结束
    物品.数据 = 子文本替换 (物品.数据, “!!”, “!”, , , 真)
.判断结束
返回 (物品)
.子程序 解析装备, 装备
.参数 物品, 物品3
.局部变量 z, 装备
.局部变量 a, 整数型
.局部变量 b, 整数型
.局部变量 w, 文本型, , "0"
.局部变量 w1, 文本型
.局部变量 武器, 逻辑型

.如果真 (物品.名称 == “”)
    z.名称 = “(#尝试解析的装备名称为空)”
    返回 (z)
.如果真结束
.计次循环首 (取数组成员数 (装备列表), a)
    .如果真 (装备列表[a].名称 == 物品.名称)
        b = a
        z = 装备列表[b]
        跳出循环 ()
    .如果真结束
    
.计次循环尾 ()
.判断开始 (b == 0)
    .如果 (z.名称 == “([解析错误])”)
        
    .否则
        .如果真 (物品.名称 != “([解析错误])”)
            记录错误 (“装备解析错误” + 物品.名称 + 加括号 (物品.数据))
            添加额外 (z.名称, “[解析错误]”)
        .如果真结束
        
    .如果结束
    z.数据 = 物品.数据
.默认
    .如果真 (是否武器 (z.特殊序号, z.类型))
        武器 = 真
        .判断开始 (z.属性.物 > z.属性.火)
            .判断开始 (z.属性.物 > z.属性.冰)
                .判断开始 (z.属性.物 > z.属性.电)
                    z.负面类型 = 1
                .默认
                    z.负面类型 = 4
                .判断结束
                
            .默认
                .判断开始 (z.属性.冰 > z.属性.电)
                    z.负面类型 = 3
                .默认
                    z.负面类型 = 4
                .判断结束
                
            .判断结束
            
        .默认
            .判断开始 (z.属性.火 > z.属性.冰)
                .判断开始 (z.属性.火 > z.属性.电)
                    z.负面类型 = 2
                .默认
                    z.负面类型 = 4
                .判断结束
                
            .默认
                .判断开始 (z.属性.冰 > z.属性.电)
                    z.负面类型 = 3
                .默认
                    z.负面类型 = 4
                .判断结束
                
            .判断结束
            
        .判断结束
        
    .如果真结束
    w = 分割文本 (子文本替换 (子文本替换 (物品.数据, “#换行”, , , , 真), “!!”, “!”, , , 真), “!”, )
    .计次循环首 (取数组成员数 (w), a)
        .如果真 (a > 1)
            w1 = 取文本左边 (w[a], 2)
            .判断开始 (w1 == “aa”)
                z.加成.护盾 = 到小数 (取文本中间 (w[a], 3, 10))
            .判断 (w1 == “ab”)
                z.加成.装甲 = 到小数 (取文本中间 (w[a], 3, 10))
            .判断 (w1 == “ac”)
                z.加成.生命 = 到小数 (取文本中间 (w[a], 3, 10))
            .判断 (w1 == “ad”)
                z.加成.生命全抗 = 到小数 (取文本中间 (w[a], 3, 10))
            .判断 (w1 == “ae”)
                z.加成.物伤 = 到小数 (取文本中间 (w[a], 3, 10))
            .判断 (w1 == “af”)
                z.加成.电伤 = 到小数 (取文本中间 (w[a], 3, 10))
            .判断 (w1 == “ag”)
                z.加成.火伤 = 到小数 (取文本中间 (w[a], 3, 10))
            .判断 (w1 == “ah”)
                z.加成.冰伤 = 到小数 (取文本中间 (w[a], 3, 10))
            .判断 (w1 == “ai”)
                z.加成.攻击 = 到小数 (取文本中间 (w[a], 3, 10))
            .判断 (w1 == “aj”)
                z.加成.暴击 = 到小数 (取文本中间 (w[a], 3, 10))
            .判断 (w1 == “ak”)
                z.加成.生命物抗 = 到小数 (取文本中间 (w[a], 3, 10))
            .判断 (w1 == “al”)
                z.加成.生命火抗 = 到小数 (取文本中间 (w[a], 3, 10))
            .判断 (w1 == “am”)
                z.加成.生命冰抗 = 到小数 (取文本中间 (w[a], 3, 10))
            .判断 (w1 == “an”)
                z.加成.生命电抗 = 到小数 (取文本中间 (w[a], 3, 10))
            .判断 (w1 == “ao”)
                z.加成.装甲物抗 = 到小数 (取文本中间 (w[a], 3, 10))
            .判断 (w1 == “ap”)
                z.加成.装甲火抗 = 到小数 (取文本中间 (w[a], 3, 10))
            .判断 (w1 == “aq”)
                z.加成.装甲冰抗 = 到小数 (取文本中间 (w[a], 3, 10))
            .判断 (w1 == “ar”)
                z.加成.装甲电抗 = 到小数 (取文本中间 (w[a], 3, 10))
            .判断 (w1 == “as”)
                z.加成.护盾物抗 = 到小数 (取文本中间 (w[a], 3, 10))
            .判断 (w1 == “at”)
                z.加成.护盾火抗 = 到小数 (取文本中间 (w[a], 3, 10))
            .判断 (w1 == “au”)
                z.加成.护盾冰抗 = 到小数 (取文本中间 (w[a], 3, 10))
            .判断 (w1 == “av”)
                z.加成.护盾电抗 = 到小数 (取文本中间 (w[a], 3, 10))
            .判断 (w1 == “aw”)
                z.加成.速度 = 到小数 (取文本中间 (w[a], 3, 10))
            .判断 (w1 == “ax”)
                z.加成.命中 = 到小数 (取文本中间 (w[a], 3, 10))
            .判断 (w1 == “ay”)
                z.加成.闪避 = 到小数 (取文本中间 (w[a], 3, 10))
            .判断 (w1 == “az”)
                z.加成.掉落率 = 到小数 (取文本中间 (w[a], 3, 10))
            .判断 (w1 == “ba”)
                z.加成.掉落品质 = 到小数 (取文本中间 (w[a], 3, 10))
            .判断 (w1 == “bb”)
                z.加成.护盾回复 = 到小数 (取文本中间 (w[a], 3, 10))
            .判断 (w1 == “bc”)
                z.加成.装甲回复 = 到小数 (取文本中间 (w[a], 3, 10))
            .判断 (w1 == “bd”)
                z.加成.生命回复 = 到小数 (取文本中间 (w[a], 3, 10))
            .判断 (w1 == “be”)
                z.加成.护盾全抗 = 到小数 (取文本中间 (w[a], 3, 10))
            .判断 (w1 == “bf”)
                z.加成.装甲全抗 = 到小数 (取文本中间 (w[a], 3, 10))
            .判断 (w1 == “bg”)
                z.加成.护盾2 = 到小数 (取文本中间 (w[a], 3, 10))
            .判断 (w1 == “bh”)
                z.加成.装甲2 = 到小数 (取文本中间 (w[a], 3, 10))
            .判断 (w1 == “bi”)
                z.加成.生命2 = 到小数 (取文本中间 (w[a], 3, 10))
            .判断 (w1 == “bj”)
                z.加成.物伤2 = 到小数 (取文本中间 (w[a], 3, 10))
            .判断 (w1 == “bk”)
                z.加成.电伤2 = 到小数 (取文本中间 (w[a], 3, 10))
            .判断 (w1 == “bl”)
                z.加成.火伤2 = 到小数 (取文本中间 (w[a], 3, 10))
            .判断 (w1 == “bm”)
                z.加成.冰伤2 = 到小数 (取文本中间 (w[a], 3, 10))
            .判断 (w1 == “bn”)
                z.加成.攻击2 = 到小数 (取文本中间 (w[a], 3, 10))
            .判断 (w1 == “bo”)
                z.加成.护盾回复2 = 到小数 (取文本中间 (w[a], 3, 10))
            .判断 (w1 == “bp”)
                z.加成.装甲回复2 = 到小数 (取文本中间 (w[a], 3, 10))
            .判断 (w1 == “bq”)
                z.加成.生命回复2 = 到小数 (取文本中间 (w[a], 3, 10))
            .判断 (w1 == “br”)
                z.加成.速度2 = 到小数 (取文本中间 (w[a], 3, 10))
            .判断 (w1 == “bs”)
                z.加成.命中2 = 到小数 (取文本中间 (w[a], 3, 10))
            .判断 (w1 == “bt”)
                z.加成.闪避2 = 到小数 (取文本中间 (w[a], 3, 10))
            .判断 (w1 == “bu”)
                z.加成.韧性 = 到小数 (取文本中间 (w[a], 3, 10))
            .判断 (w1 == “bv”)
                z.加成.采集 = 到小数 (取文本中间 (w[a], 3, 10))
            .判断 (w1 == “by”)
                z.加成.魅力 = 到小数 (取文本中间 (w[a], 3, 10))
            .判断 (w1 == “bw”)
                z.加成.暴击伤害 = 到小数 (取文本中间 (w[a], 3, 10))
            .判断 (w1 == “bx”)
                b = 到短整数 (取文本中间 (w[a], 3, 10))
                .如果真 (b != 0)
                    .判断开始 (武器)
                        .判断开始 (b == 37)  ' 天行者
                            z.属性.物 = z.属性.物 * 1.15
                            z.属性.火 = z.属性.火 * 1.15
                            z.属性.冰 = z.属性.冰 * 1.15
                            z.属性.电 = z.属性.电 * 1.15
                        .判断 (b == 38)  ' 引力弹头
                            z.属性.物 = z.属性.物 * 1.25
                        .判断 (b == 39)  ' 龙之吐息
                            z.属性.物 = z.属性.火 * 1.25
                        .判断 (b == 40)  ' 灵魂之息
                            z.属性.物 = z.属性.冰 * 1.25
                        .判断 (b == 41)  ' 球状闪电
                            z.属性.物 = z.属性.电 * 1.25
                        .默认
                            
                        .判断结束
                        .如果真 (取数组成员数 (武器特效) >= b)
                            z.特效 = b
                            叠加加成 (z.自带, 武器特效[b].加成)
                            z.冷却 = z.冷却 + 武器特效[b].加成.冷却
                            .如果真 (武器特效[b].加成.攻击次数 >= 2)
                                z.加成.攻击次数 = z.加成.攻击次数 + 武器特效[b].加成.攻击次数 - 1
                            .如果真结束
                            .如果真 (武器特效[b].加成.攻击文本 != “”)
                                z.攻击文本 = 取攻击文本 (武器特效[b].加成.攻击文本)
                            .如果真结束
                            
                        .如果真结束
                        
                    .默认
                        .如果真 (取数组成员数 (装备特效) >= b)
                            z.特效 = b
                            叠加加成 (z.自带, 装备特效[b].加成)
                        .如果真结束
                        
                    .判断结束
                    
                .如果真结束
                
            .判断 (w1 == “@@”)
                z.制造者 = 子文本替换 (w[a], “@@”, , , , 真)
            .默认
                ' 记录错误 (“无法解析的装备词条【” ＋ w1 ＋ “】”)
            .判断结束
            
        .如果真结束
        
    .计次循环尾 ()
    .如果真 (武器)  ' 是武器才为其取攻击文本
        .如果真 (z.攻击文本.名称 != “”)
            .计次循环首 (取数组成员数 (文本列表), a)
                .如果真 (文本列表[a].名称 == z.攻击文本.名称)
                    z.攻击文本 = 文本列表[a]
                    跳出循环 ()
                .如果真结束
                
            .计次循环尾 ()
        .如果真结束
        
    .如果真结束
    z.数据 = 取文本左边 (物品.数据, 1) + 加成转数据 (z.加成)
    .如果真 (z.特效 != 0)
        z.数据 = z.数据 + “!bx” + 到文本 (z.特效)
    .如果真结束
    .如果真 (z.制造者 != “”)
        z.数据 = z.数据 + “!@@” + z.制造者
    .如果真结束
    z.耐久 = 物品.耐久
.判断结束
返回 (z)
.子程序 装备要求, 逻辑型, , 玩家身上是否装备有这件装备，或者手中拿着的是否是对应武器，有则返回真  如果寻找的是武器，则[是否武器]必须为真
.参数 玩家, 玩家
.参数 特殊序号, 短整数型, 可空
.参数 名称, 文本型, 可空
.参数 是否武器, 逻辑型, 可空
.局部变量 a, 整数型

.判断开始 (是否武器)
    .判断开始 (玩家.当前武器 == 0)
        返回 (假)
    .默认
        .判断开始 (特殊序号 != 0)  ' 由特殊序号进行判断
            .如果真 (玩家.武器[玩家.当前武器].特殊序号 == 特殊序号)
                返回 (真)
            .如果真结束
            
        .默认
            .如果真 (玩家.武器[玩家.当前武器].名称 == 名称)  ' 由名称进行判断
                返回 (真)
            .如果真结束
            
        .判断结束
        
    .判断结束
    返回 (假)
.默认
    .判断开始 (特殊序号 != 0)  ' 由特殊序号进行判断
        .计次循环首 (取数组成员数 (玩家.装备), a)
            .判断开始 (特殊序号 == 玩家.装备[a].特殊序号)
                返回 (真)
            .判断 (特殊序号 == #增幅器)
                .如果真 (玩家.装备[a].特殊序号 > 70 && 玩家.装备[a].特殊序号 < 76)  ' 71-75为5种特殊增幅器
                    返回 (真)
                .如果真结束
                
            .判断 (特殊序号 == #植入体)
                .如果真 (玩家.装备[a].特殊序号 > 75 && 玩家.装备[a].特殊序号 < 80)  ' 76-79为4种特殊植入体
                    返回 (真)
                .如果真结束
                
            .默认
                
            .判断结束
            
        .计次循环尾 ()
    .默认
        .计次循环首 (取数组成员数 (玩家.装备), a)  ' 由名称进行判断
            .判断开始 (名称 == “增幅器”)
                .如果真 (取文本左边 (玩家.装备[a].名称, 6) == “增幅器”)
                    返回 (真)
                .如果真结束
                
            .判断 (名称 == “植入体”)
                .如果真 (取文本左边 (玩家.装备[a].名称, 6) == “植入体”)
                    返回 (真)
                .如果真结束
                
            .默认
                .如果真 (玩家.装备[a].名称 == 名称)
                    返回 (真)
                .如果真结束
                
            .判断结束
            
        .计次循环尾 ()
    .判断结束
    
.判断结束
返回 (假)
.子程序 套装判断
.参数 套装, 套装, 参考
.参数 名称, 文本型
.参数 特殊序号, 短整数型
.局部变量 w1, 文本型
.局部变量 w2, 文本型

.判断开始 (特殊序号 != 0)
    .判断开始 (特殊序号 == #植入体强攻)
        套装.植入体 = 1
    .判断 (特殊序号 == #植入体烈火)
        套装.植入体 = 2
    .判断 (特殊序号 == #植入体冰结)
        套装.植入体 = 3
    .判断 (特殊序号 == #植入体雷霆)
        套装.植入体 = 4
    .判断 (特殊序号 == #增幅器侵彻)
        套装.增幅器 = 5
    .判断 (特殊序号 == #增幅器速射)
        套装.增幅器 = 1
    .判断 (特殊序号 == #增幅器敏锐)
        套装.增幅器 = 2
    .判断 (特殊序号 == #增幅器神枪)
        套装.增幅器 = 3
    .判断 (特殊序号 == #增幅器坚毅)
        套装.增幅器 = 4
    .判断 (特殊序号 == #纳米套装)
        套装.纳米生化装 = 套装.纳米生化装 + 1
    .判断 (特殊序号 == #科学家套装)
        套装.科学家 = 套装.科学家 + 1
    .判断 (特殊序号 == #纯白婚纱套装)
        套装.白花嫁 = 套装.白花嫁 + 1
    .判断 (特殊序号 == #白色丝袜)
        套装.科学家 = 套装.科学家 + 1
    .判断 (特殊序号 == #黑婚纱套装)
        套装.黑花嫁 = 套装.黑花嫁 + 1
    .判断 (特殊序号 == #一拳套装)
        套装.一拳 = 套装.一拳 + 1
    .判断 (特殊序号 == #女仆套装)
        套装.女仆 = 套装.女仆 + 1
    .判断 (特殊序号 == #生命套装)
        套装.生命祝福 = 套装.生命祝福 + 1
    .判断 (特殊序号 == #皇冠套装)
        套装.皇冠 = 套装.皇冠 + 1
    .判断 (特殊序号 == #动力套装)
        套装.动力 = 套装.动力 + 1
        .如果真 (套装.动力 > 5)
            套装.动力 = 5
        .如果真结束
        
    .判断 (特殊序号 == #游侠套装)
        套装.游侠 = 套装.游侠 + 1
    .判断 (特殊序号 == #游骑兵套装)
        套装.游骑兵 = 套装.游骑兵 + 1
    .判断 (特殊序号 == #防爆套装)
        套装.防爆 = 套装.防爆 + 1
    .判断 (特殊序号 == #无畏套装)
        套装.无畏 = 套装.无畏 + 1
    .判断 (特殊序号 == #强袭套装)
        套装.强袭 = 套装.强袭 + 1
    .判断 (特殊序号 == #圣诞套装)
        套装.圣诞 = 套装.圣诞 + 1
    .判断 (特殊序号 == #动能线圈)
        套装.线圈 = 1
    .判断 (特殊序号 == #热能线圈)
        套装.线圈 = 2
    .判断 (特殊序号 == #极寒线圈)
        套装.线圈 = 3
