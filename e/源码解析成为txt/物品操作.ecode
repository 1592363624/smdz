原始时间戳 = s
可生产时间 = 0
消耗的生产力 = 0
物品.类型 = “资源”
重定义数组 (a3, 假, 5)
a3[1] = 1  ' 副产物加成
a3[2] = 1  ' 配方消耗减少
a3[5] = 1  ' 生产效率  分配的生产力超过上限则降低，未达到上限则不变
b = 取物品数量 (“生产调度系统II”, 载具.零件, )
.如果真 (b > 5)  ' 最多生效5个
    b = 5
.如果真结束
a3[4] = 1 + b * 0.09  ' 生产速率
.如果真 (咏星 > 0)
    a3[4] = a3[4] + 0.25
.如果真结束
.如果真 (载具.上限 > 1)  ' 载具部件超过上限
    返回 ()
.如果真结束
