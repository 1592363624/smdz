物品.类型 = “资源”
.计次循环首 (取数组成员数 (文本型零件), a)
    物品.名称 = 去数字 (文本型零件[a])
    .如果 (a == 1)
        物品.数量 = 1
    .否则
        物品.数量 = 到整数 (取数字 (文本型零件[a]))
    .如果结束
    获得物品 (载具零件, 物品, , )
.计次循环尾 ()
临时玩家 = 玩家
.计次循环首 (取数组成员数 (载具零件), a)  ' 先剔除玩家已经有的零件，取出玩家没有的零件
    b = 取物品数量 (载具零件[a].名称, 临时玩家.背包, )
    .如果 (b >= 载具零件[a].数量)
        物品.数量 = -载具零件[a].数量
        物品.名称 = 载具零件[a].名称
        获得物品 (临时玩家.背包, 物品, 真, )  ' 允许负数需要为真，否则有可能数组越界
    .否则
        物品.数量 = -b
        物品.名称 = 载具零件[a].名称
        获得物品 (临时玩家.背包, 物品, 真, )
        物品.数量 = 载具零件[a].数量 - b
        获得物品 (缺少零件, 物品, , )
    .如果结束
    
.计次循环尾 ()
.计次循环首 (取数组成员数 (缺少零件), a)  ' 计算玩家背包的资源是否足够制造缺少的零件
    .如果真 (制造 (临时玩家, 缺少零件[a].名称, 缺少零件[a].数量, 文本) == 假)
        .如果 (返回 == “”)
            返回 = “#换行缺少这些物品，并且背包里面的数量不够/背包里面的资源不足以制造缺少的数量：” + 缺少零件[a].名称 + “x” + 到文本 (缺少零件[a].数量)
        .否则
            返回 = 返回 + “、” + 缺少零件[a].名称 + “x” + 到文本 (缺少零件[a].数量)
        .如果结束
        中止 = 真
    .如果真结束
    
.计次循环尾 ()
.如果真 (中止)
    返回文本 = 返回
    返回 (假)
.如果真结束
.计次循环首 (取数组成员数 (缺少零件), a)  ' 真正开始
    制造 (玩家, 缺少零件[a].名称, 缺少零件[a].数量, 文本)
    返回 = 返回 + #换行符 + 文本
.计次循环尾 ()
